<%= form_for ad_cost, as: :ad_cost, url: local_assigns[:form_url] || ad_cost, html: { autocomplete: 'off' } do |form| %>

  <div class="users-form-page">
    <div class="crm-card users-form-page__card">

      <div class="users-form-page__header">
        <div class="users-form-page__header-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM4.5 12h.008v.008H4.5V12zm15 0h.008v.008h-.008V12z" />
          </svg>
        </div>
        <div>
          <h2 class="users-form-page__title"><%= ad_cost.new_record? ? 'Cadastrar Custo de Anúncio' : 'Editar Custo de Anúncio' %></h2>
          <p class="users-form-page__subtitle"><%= @client.name %></p>
        </div>
      </div>

      <% if ad_cost.errors.any? %>
        <div class="users-form-page__errors">
          <div class="users-form-page__errors-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          </div>
          <div>
            <strong>Corrija os erros abaixo:</strong>
            <ul>
              <% ad_cost.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div class="users-form-page__body">

        <div class="users-form-page__field">
          <%= form.label :platform, 'Plataforma', class: 'crm-label' %>
          <%= form.select :platform,
              AdCost::PLATFORMS.map { |p| [AdCost::PLATFORM_LABELS[p], p] },
              { include_blank: 'Selecione a plataforma' },
              { class: 'crm-input', required: true } %>
        </div>

        <div class="users-form-page__field">
          <%= form.label :name, 'Nome do custo', class: 'crm-label' %>
          <%= form.text_field :name, class: 'crm-input', required: true, placeholder: 'Ex.: Campanha Black Friday' %>
        </div>

        <div class="users-form-page__row">
          <div class="users-form-page__field">
            <%= form.label :start_date, 'Data início', class: 'crm-label' %>
            <%= form.date_field :start_date, class: 'crm-input', required: true %>
          </div>
          <div class="users-form-page__field">
            <%= form.label :end_date, 'Data fim', class: 'crm-label' %>
            <%= form.date_field :end_date, class: 'crm-input', required: true %>
          </div>
        </div>

        <div class="users-form-page__field">
          <%= form.label :amount, 'Valor (R$)', class: 'crm-label' %>
          <%= form.number_field :amount, class: 'crm-input', step: '0.01', min: 0, required: true, placeholder: '0,00' %>
        </div>

      </div>

      <div class="users-form-page__footer">
        <%= link_to ad_costs_path, class: 'crm-btn crm-btn--secondary' do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
          </svg>
          Voltar
        <% end %>
        <%= form.button class: 'crm-btn crm-btn--primary',
            data: { disable_with: ad_cost.new_record? ? 'Cadastrando...' : 'Salvando...' } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <%= ad_cost.new_record? ? 'Cadastrar' : 'Salvar Alterações' %>
        <% end %>
      </div>

    </div>
  </div>

<% end %>
