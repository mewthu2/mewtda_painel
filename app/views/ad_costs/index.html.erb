<% title 'Custos de Anúncio' %>

<div class="clients-wrapper">

  <div class="clients-table-wrap">
    <div class="clients-table-header">
      <span class="clients-table-header__title">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zM4.5 12h.008v.008H4.5V12zm15 0h.008v.008h-.008V12z" />
        </svg>
        Custos de Anúncio<%= " — #{@client.name}" if @client %>
      </span>
      <%= link_to new_ad_cost_path, class: 'crm-btn clients-btn--success' do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Novo Custo
      <% end %>
    </div>

    <table class="crm-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Plataforma</th>
          <th>Data início</th>
          <th>Data fim</th>
          <th>Valor</th>
          <th class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @ad_costs.each do |ad_cost| %>
          <tr>
            <td><%= ad_cost.name %></td>
            <td><%= ad_cost.platform_label %></td>
            <td><%= ad_cost.start_date.strftime('%d/%m/%Y') %></td>
            <td><%= ad_cost.end_date.strftime('%d/%m/%Y') %></td>
            <td><%= currency(ad_cost.amount) %></td>
            <td class="text-center">
              <div class="clients-table__actions">
                <%= link_to edit_ad_cost_path(ad_cost), class: 'crm-btn clients-btn--icon' do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" />
                  </svg>
                <% end %>
                <%= button_to ad_cost_path(ad_cost), method: :delete,
                    class: 'crm-btn clients-btn--icon clients-btn--danger',
                    form: { onsubmit: "return confirm('Excluir o custo #{j ad_cost.name}?');" } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                  </svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @ad_costs.empty? %>
          <tr>
            <td colspan="6" class="clients-table__empty">Nenhum custo cadastrado.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

</div>
