<header class="crm-header">

  <button class="crm-header__hamburger" id="crm-hamburger" type="button" aria-label="Abrir menu" aria-expanded="false">
    <i class="fa-solid fa-bars"></i>
  </button>

  <!-- BREADCRUMB: cliente / título da página -->
  <div class="crm-header__crumbs">
    <% crumb_client = crm_current_client %>
    <% if crumb_client %>
      <%= ws_badge(crumb_client.name) %>
      <span class="crm-header__crumb-client"><%= crumb_client.name %></span>
    <% end %>
    <% if content_for?(:title) %>
      <% if crumb_client %><span class="crm-header__crumb-sep">/</span><% end %>
      <strong><%= yield(:title) %></strong>
    <% end %>
  </div>

  <!-- SEARCH -->
  <div class="crm-header__search" id="crm-nav-search">
    <button type="button" class="crm-header__search-icon-btn" id="crm-nav-search-toggle" aria-label="Buscar telas">
      <i class="fa-solid fa-magnifying-glass"></i>
    </button>

    <div class="crm-header__search-input-wrap" id="crm-nav-search-wrap">
      <i class="fa-solid fa-magnifying-glass crm-header__search-icon"></i>
      <input
        type="text"
        id="crm-nav-search-input"
        class="crm-header__search-input"
        placeholder="Buscar telas..."
        autocomplete="off"
        data-items="<%= searchable_nav_items(current_user).to_json %>"
      >
      <div class="crm-header__search-results" id="crm-nav-search-results"></div>
    </div>
  </div>

  <button type="button" class="crm-theme-toggle" onclick="toggleTheme()" aria-label="Alternar tema">
    <i class="fa-solid fa-sun"></i>
    <i class="fa-solid fa-moon"></i>
  </button>

</header>

<script>

/* CLIENT */
function updateSelectedClient(clientId) {
  if (!clientId) return;

  fetch('/crm/update_selected_client', {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
    },
    body: JSON.stringify({ client_id: clientId })
  })
  .then(() => location.reload());
}

function toggleTheme() {
  var isDark = document.documentElement.classList.toggle('theme-dark');
  localStorage.setItem('crm-theme', isDark ? 'dark' : 'light');
}

(function () {

  /* DROPDOWNS DA SIDEBAR — menu do usuário e seletor de cliente (ver _sidebar) */
  function dropdown(wrapId, toggleId, menuId) {
    const wrap   = document.getElementById(wrapId);
    const toggle = document.getElementById(toggleId);
    const menu   = document.getElementById(menuId);
    if (!wrap || !toggle || !menu) return;

    function setOpen(open) {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', open);
      wrap.classList.toggle('open', open);
    }

    toggle.addEventListener('click', function (e) {
      e.stopPropagation();
      setOpen(menu.hidden);
    });
    menu.addEventListener('click', function (e) { e.stopPropagation(); });
    document.addEventListener('click', function () { setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
  }

  dropdown('crm-user-menu', 'crm-user-toggle', 'crm-dropdown');
  dropdown('crm-ws', 'crm-ws-toggle', 'crm-ws-menu');

  /* NAV SEARCH — filtra telas/menus (ver HeaderHelper#searchable_nav_items) */
  const searchBox    = document.getElementById('crm-nav-search');
  const searchToggle = document.getElementById('crm-nav-search-toggle');
  const searchWrap   = document.getElementById('crm-nav-search-wrap');
  const searchInput  = document.getElementById('crm-nav-search-input');
  const searchResults = document.getElementById('crm-nav-search-results');
  const navItems = searchInput ? JSON.parse(searchInput.dataset.items || '[]') : [];
  let activeIndex = -1;

  function closeSearchResults() {
    if (!searchResults) return;
    searchResults.classList.remove('open');
    activeIndex = -1;
  }

  function closeSearchInput() {
    if (!searchWrap) return;
    searchWrap.classList.remove('open');
    closeSearchResults();
  }

  function renderResults(items) {
    if (!items.length) {
      searchResults.innerHTML = '<div class="crm-header__search-empty">Nenhuma tela encontrada</div>';
      searchResults.classList.add('open');
      return;
    }

    searchResults.innerHTML = items.map(function (item, i) {
      return '<a href="' + item.url + '" class="crm-header__search-result' + (i === activeIndex ? ' active' : '') + '">' +
        '<i class="' + item.icon + ' crm-fa"></i>' + item.label +
        '</a>';
    }).join('');
    searchResults.classList.add('open');
  }

  function filterAndRender() {
    const query = searchInput.value.trim().toLowerCase();
    activeIndex = -1;

    if (!query) {
      closeSearchResults();
      return;
    }

    const matches = navItems.filter(function (item) {
      return item.label.toLowerCase().includes(query);
    });

    renderResults(matches);
  }

  if (searchInput) {
    searchInput.addEventListener('input', filterAndRender);

    searchInput.addEventListener('keydown', function (e) {
      const links = searchResults.querySelectorAll('.crm-header__search-result');

      if (e.key === 'ArrowDown' && links.length) {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % links.length;
        links.forEach(function (el, i) { el.classList.toggle('active', i === activeIndex); });
      } else if (e.key === 'ArrowUp' && links.length) {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + links.length) % links.length;
        links.forEach(function (el, i) { el.classList.toggle('active', i === activeIndex); });
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const target = links[activeIndex] || links[0];
        if (target) window.location = target.getAttribute('href');
      } else if (e.key === 'Escape') {
        closeSearchInput();
        searchInput.blur();
      }
    });
  }

  if (searchToggle) {
    searchToggle.addEventListener('click', function (e) {
      e.stopPropagation();
      const isOpen = searchWrap.classList.contains('open');
      if (isOpen) {
        closeSearchInput();
      } else {
        searchWrap.classList.add('open');
        searchInput.focus();
      }
    });
  }

  if (searchBox) {
    searchBox.addEventListener('click', function (e) { e.stopPropagation(); });

    document.addEventListener('click', function () {
      closeSearchResults();
      if (window.innerWidth <= 900) closeSearchInput();
    });
  }

  /* HAMBURGER — abre a sidebar (drawer mobile), ver layouts/partials/_sidebar */
  const hamburger = document.getElementById('crm-hamburger');
  const sidebar   = document.getElementById('crm-sidebar');
  const overlay   = document.getElementById('crm-nav-overlay');

  function openSidebar() {
    sidebar.classList.add('open');
    overlay.classList.add('open');
    hamburger.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeSidebar() {
    sidebar.classList.remove('open');
    overlay.classList.remove('open');
    hamburger.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  if (hamburger && sidebar) {
    hamburger.addEventListener('click', function () {
      sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
    });
  }

  if (overlay) {
    overlay.addEventListener('click', closeSidebar);
  }

})();

</script>
