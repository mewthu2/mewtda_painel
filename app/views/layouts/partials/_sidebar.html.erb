<aside class="crm-sidebar" id="crm-sidebar">
  <%= link_to crm_path, class: 'crm-sidebar__brand' do %>
    <%= image_tag 'admin/meu-crm-logo-roxo.png', alt: 'MeuCRM', class: 'crm-sidebar__logo' %>
  <% end %>

  <%# Cliente atual, como o workspace do ClickUp. Admin troca por aqui. %>
  <% ws_client = crm_current_client %>
  <% if current_user.admin? %>
    <div class="crm-ws" id="crm-ws">
      <button type="button" class="crm-ws__btn" id="crm-ws-toggle" aria-haspopup="true" aria-expanded="false">
        <%= ws_badge(ws_client&.name) %>
        <span class="crm-ws__name"><%= ws_client&.name || 'Selecionar cliente' %></span>
        <i class="fa-solid fa-chevron-down crm-ws__chevron"></i>
      </button>
      <div class="crm-ws__menu" id="crm-ws-menu" hidden>
        <div class="crm-ws__label">Clientes</div>
        <% Client.where(active: true).order(:name).each do |client| %>
          <button type="button" class="crm-ws__item" onclick="updateSelectedClient(<%= client.id %>)">
            <%= ws_badge(client.name) %>
            <span><%= client.name %></span>
            <% if ws_client&.id == client.id %><i class="fa-solid fa-check"></i><% end %>
          </button>
        <% end %>
        <%= link_to clients_path, class: 'crm-ws__item crm-ws__manage' do %>
          <i class="fa-solid fa-building crm-fa"></i><span>Gerenciar clientes</span>
        <% end %>
      </div>
    </div>
  <% elsif ws_client %>
    <div class="crm-ws">
      <div class="crm-ws__btn crm-ws__btn--static">
        <%= ws_badge(ws_client.name) %>
        <span class="crm-ws__name"><%= ws_client.name %></span>
      </div>
    </div>
  <% end %>

  <nav class="crm-sidebar__nav">

    <% if current_user.profile_id == Profile::AFFILIATE %>
      <!-- AFILIADO: apenas seus eventos -->
      <%= link_to events_path(utm_code: current_user.utm_code), class: "crm-sidebar__link #{'active' if request.path.start_with?(events_path)}" do %>
        <i class="fa-solid fa-chart-line crm-fa"></i>
        Meus Eventos
      <% end %>
    <% else %>
      <%= link_to crm_path, class: "crm-sidebar__link #{'active' if current_page?(crm_path)}" do %>
        <i class="fa-solid fa-chart-line crm-fa"></i>
        Trackeamento site
      <% end %>

      <% if current_user.admin? || current_user.client.present? %>
        <% vendas_active = current_page?(sales_dashboard_path) || request.path.start_with?(ad_costs_path) || current_page?(edit_goal_path) %>
        <details class="crm-sidebar__submenu" <%= 'open' if vendas_active %>>
          <summary class="crm-sidebar__link crm-sidebar__link--parent">
            <i class="fa-solid fa-sack-dollar crm-fa"></i>
            Vendas
            <i class="fa-solid fa-chevron-down crm-sidebar__submenu-chevron"></i>
          </summary>
          <div class="crm-sidebar__submenu-body">
            <%= link_to sales_dashboard_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if current_page?(sales_dashboard_path)}" do %>
              <i class="fa-solid fa-chart-pie crm-fa"></i>
              Dashboard Principal
            <% end %>

            <%= link_to ad_costs_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if current_page?(ad_costs_path)}" do %>
              <i class="fa-solid fa-list crm-fa"></i>
              Custos
            <% end %>

            <%= link_to new_ad_cost_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if current_page?(new_ad_cost_path)}" do %>
              <i class="fa-solid fa-plus crm-fa"></i>
              Cadastrar Custo
            <% end %>

            <%= link_to edit_goal_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if current_page?(edit_goal_path)}" do %>
              <i class="fa-solid fa-bullseye crm-fa"></i>
              Metas
            <% end %>
          </div>
        </details>
      <% end %>

      <% operacoes_active = request.path.start_with?(orders_path) || request.path.start_with?(customers_path) ||
                             request.path.start_with?(products_path) %>
      <details class="crm-sidebar__submenu" <%= 'open' if operacoes_active %>>
        <summary class="crm-sidebar__link crm-sidebar__link--parent">
          <i class="fa-solid fa-boxes-stacked crm-fa"></i>
          Operações
          <i class="fa-solid fa-chevron-down crm-sidebar__submenu-chevron"></i>
        </summary>
        <div class="crm-sidebar__submenu-body">
          <% loja_active = request.path.start_with?(orders_path) || request.path.start_with?(customers_path) ||
                            request.path.start_with?(products_path) %>
          <%= link_to orders_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if loja_active}" do %>
            <i class="fa-solid fa-store crm-fa"></i>
            Loja
          <% end %>
        </div>
      </details>
    <% end %>

    <% unless current_user.profile_id == Profile::AFFILIATE %>
      <% whatsapp_active = request.path.start_with?(automations_path) %>
      <details class="crm-sidebar__submenu" <%= 'open' if whatsapp_active %>>
        <summary class="crm-sidebar__link crm-sidebar__link--parent">
          <i class="fa-brands fa-whatsapp crm-fa"></i>
          WhatsApp
          <i class="fa-solid fa-chevron-down crm-sidebar__submenu-chevron"></i>
        </summary>
        <div class="crm-sidebar__submenu-body">
          <%= link_to automations_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if current_page?(automations_path)}" do %>
            <i class="fa-solid fa-robot crm-fa"></i>
            Automações
          <% end %>
        </div>
      </details>

      <%= link_to custom_automations_path, class: "crm-sidebar__link #{'active' if request.path.start_with?(custom_automations_path)}" do %>
        <i class="fa-solid fa-wand-magic-sparkles crm-fa"></i>
        Automações personalizadas
      <% end %>

      <% marketing_active = request.path.start_with?(affiliates_path) || request.path.start_with?('/crm/popup') ||
                             request.path.start_with?(landing_pages_path) ||
                             request.path.start_with?(email_templates_path) || request.path.start_with?('/crm/email_configuration') %>
      <details class="crm-sidebar__submenu" <%= 'open' if marketing_active %>>
        <summary class="crm-sidebar__link crm-sidebar__link--parent">
          <i class="fa-solid fa-bullseye crm-fa"></i>
          Marketing
          <i class="fa-solid fa-chevron-down crm-sidebar__submenu-chevron"></i>
        </summary>
        <div class="crm-sidebar__submenu-body">
          <%= link_to edit_popup_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if request.path.start_with?('/crm/popup')}" do %>
            <i class="fa-solid fa-window-restore crm-fa"></i>
            Pop Up
          <% end %>

          <%= link_to landing_pages_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if request.path.start_with?(landing_pages_path)}" do %>
            <i class="fa-solid fa-rocket crm-fa"></i>
            Landing Pages
          <% end %>

          <%= link_to email_templates_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if request.path.start_with?(email_templates_path)}" do %>
            <i class="fa-solid fa-envelope-open-text crm-fa"></i>
            E-mail
          <% end %>

          <%= link_to affiliates_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if request.path.start_with?(affiliates_path)}" do %>
            <i class="fa-solid fa-user-group crm-fa"></i>
            Afiliados
          <% end %>
        </div>
      </details>
    <% end %>

    <% if current_user.profile_id != Profile::AFFILIATE %>
      <% settings_href = current_user.admin? ? (session[:selected_client_id].presence && edit_client_path(session[:selected_client_id])) : edit_settings_path %>
      <% if settings_href %>
        <% conta_active = current_user.admin? ? request.path.start_with?('/crm/clients/') : current_page?(edit_settings_path) %>
        <details class="crm-sidebar__submenu" <%= 'open' if conta_active %>>
          <summary class="crm-sidebar__link crm-sidebar__link--parent">
            <i class="fa-solid fa-gear crm-fa"></i>
            Conta
            <i class="fa-solid fa-chevron-down crm-sidebar__submenu-chevron"></i>
          </summary>
          <div class="crm-sidebar__submenu-body">
            <%= link_to settings_href, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if conta_active}" do %>
              <i class="fa-solid fa-sliders crm-fa"></i>
              Configurações
            <% end %>
          </div>
        </details>
      <% end %>
    <% end %>

    <% if current_user.admin? %>
      <% admin_active = request.path.start_with?(users_path) || request.path.start_with?(clients_path) ||
                         request.path.start_with?(profiles_path) || request.path.start_with?(try_on_index_path) %>
      <details class="crm-sidebar__submenu" <%= 'open' if admin_active %>>
        <summary class="crm-sidebar__link crm-sidebar__link--parent">
          <i class="fa-solid fa-user-shield crm-fa"></i>
          Admin
          <i class="fa-solid fa-chevron-down crm-sidebar__submenu-chevron"></i>
        </summary>
        <div class="crm-sidebar__submenu-body">
          <%= link_to users_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if request.path.start_with?(users_path)}" do %>
            <i class="fa-solid fa-user crm-fa"></i>
            Usuários
          <% end %>

          <%= link_to clients_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if request.path.start_with?(clients_path)}" do %>
            <i class="fa-solid fa-building crm-fa"></i>
            Clientes
          <% end %>

          <%= link_to profiles_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if request.path.start_with?(profiles_path)}" do %>
            <i class="fa-solid fa-id-badge crm-fa"></i>
            Perfis
          <% end %>

          <%= link_to '/crm/sidekiq', class: "crm-sidebar__link crm-sidebar__link--sub", target: '_blank' do %>
            <i class="fa-solid fa-bolt crm-fa"></i>
            Sidekiq
          <% end %>

          <%= link_to try_on_index_path, class: "crm-sidebar__link crm-sidebar__link--sub #{'active' if request.path.start_with?(try_on_index_path)}" do %>
            <i class="fa-solid fa-wand-magic-sparkles crm-fa"></i>
            Try-On Virtual
          <% end %>
        </div>
      </details>
    <% end %>

  </nav>

  <div class="crm-sidebar__bottom">
    <a class="crm-sidebar__link" href="https://wa.me/5516991997608?text=Olá,%20preciso%20de%20suporte%20no%20CRM." target="_blank" rel="noopener">
      <i class="fa-brands fa-whatsapp crm-fa"></i>
      Falar no suporte
    </a>

    <%# Menu do usuário: abre pra cima, a partir do rodapé da sidebar %>
    <div class="crm-user" id="crm-user-menu">
      <button type="button" class="crm-user__btn" id="crm-user-toggle" aria-haspopup="true" aria-expanded="false">
        <span class="crm-user__avatar"><%= current_user.name.first.upcase %></span>
        <span class="crm-user__text">
          <span class="crm-user__name"><%= current_user.name %></span>
          <span class="crm-user__role"><%= current_user.admin? ? 'Administrador' : 'Usuário' %></span>
        </span>
        <i class="fa-solid fa-chevron-up crm-user__chevron"></i>
      </button>

      <div class="crm-user__dropdown" id="crm-dropdown" hidden>
        <div class="crm-user__dropdown-head">
          <strong><%= current_user.name %></strong>
          <span><%= current_user.email %></span>
        </div>

        <%= link_to edit_account_path, class: 'crm-user__item' do %>
          <i class="fa-solid fa-key crm-fa"></i>
          Minha Conta
        <% end %>

        <% if current_user.admin? %>
          <%= link_to ad_costs_path, class: 'crm-user__item' do %>
            <i class="fa-solid fa-money-bill-wave crm-fa"></i>
            Custos de Anúncio
          <% end %>
        <% elsif current_user.profile_id != Profile::AFFILIATE %>
          <%= link_to edit_settings_path, class: 'crm-user__item' do %>
            <i class="fa-solid fa-gear crm-fa"></i>
            Configurações
          <% end %>

          <%= link_to ad_costs_path, class: 'crm-user__item' do %>
            <i class="fa-solid fa-money-bill-wave crm-fa"></i>
            Custos de Anúncio
          <% end %>
        <% end %>

        <div class="crm-user__sep"></div>

        <%= link_to destroy_user_session_path, data: { turbo: false }, class: 'crm-user__item crm-user__item--danger' do %>
          <i class="fa-solid fa-right-from-bracket crm-fa"></i>
          Sair
        <% end %>
      </div>
    </div>
  </div>
</aside>
