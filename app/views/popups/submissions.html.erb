<% title 'Cadastros do Pop-up' %>

<div class="clients-wrapper">

  <div class="users-form-page__header" style="margin-bottom: 1rem;">
    <div class="users-form-page__header-icon">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
      </svg>
    </div>
    <div>
      <h2 class="users-form-page__title">Cadastros do Pop-up</h2>
      <p class="users-form-page__subtitle"><%= @client.name %></p>
    </div>
  </div>

  <%= render 'tabs' %>

  <%= form_tag(submissions_popup_path, method: 'get') do %>
    <div class="clients-filters">
      <div class="clients-filters__row">
        <div class="clients-filters__field clients-filters__field--small">
          <label class="crm-label">Status</label>
          <%= select_tag :status,
              options_for_select([['Todos', ''], ['Sucesso', 'success'], ['Erro Shopify', 'shopify_error']], @status_filter),
              class: 'crm-input clients-filters__input--select' %>
        </div>
        <div class="clients-filters__actions">
          <%= button_tag class: 'crm-btn crm-btn--primary', name: '' do %>
            Filtrar
          <% end %>
          <%= link_to submissions_popup_path, class: 'crm-btn crm-btn--secondary' do %>
            Limpar
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <div class="clients-table-wrap">
    <table class="crm-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>E-mail</th>
          <th>Telefone</th>
          <th>Status</th>
          <th>Shopify</th>
          <th>Data</th>
        </tr>
      </thead>
      <tbody>
        <% @popup_submissions.each do |submission| %>
          <tr>
            <td><%= submission.name %></td>
            <td><%= submission.email %></td>
            <td><%= submission.phone.presence || '—' %></td>
            <td>
              <% if submission.status == 'success' %>
                <span class="crm-tag crm-tag--success">Sucesso</span>
              <% else %>
                <span class="crm-tag crm-tag--warning">Erro Shopify</span>
              <% end %>
            </td>
            <td>
              <% if submission.integrated? %>
                <%= link_to submission.shopify_admin_customer_url, target: '_blank', rel: 'noopener', class: 'crm-tag crm-tag--success' do %>
                  Ver cliente ↗
                <% end %>
              <% else %>
                <span class="crm-tag crm-tag--neutral">Não integrado</span>
              <% end %>
            </td>
            <td><%= submission.created_at.strftime('%d/%m/%Y %H:%M') %></td>
          </tr>
        <% end %>
        <% if @popup_submissions.empty? %>
          <tr>
            <td colspan="6" class="clients-table__empty">Nenhum cadastro encontrado.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

</div>
