<% title 'Pop-up de Cadastro' %>

<div class="users-form-page popups-layout">
  <div class="crm-card users-form-page__card popups-layout__form">

    <div class="users-form-page__header">
      <div class="users-form-page__header-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <h2 class="users-form-page__title">Pop-up de Cadastro</h2>
        <p class="users-form-page__subtitle"><%= @client.name %></p>
      </div>
    </div>

    <%= render 'tabs' %>

    <% if @popup.errors.any? %>
      <div class="users-form-page__errors">
        <div class="users-form-page__errors-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </div>
        <div>
          <strong>Corrija os erros abaixo:</strong>
          <ul>
            <% @popup.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%= form_for @popup, as: :popup, url: popup_path, method: :patch,
                 html: { autocomplete: 'off', multipart: true } do |form| %>
      <div class="users-form-page__body">

        <div class="users-form-page__field">
          <label class="crm-label">Ativo</label>
          <div class="cform-toggle">
            <%= form.check_box :active, class: 'cform-toggle__input' %>
            <span class="cform-toggle__label">Pop-up ativo no site do cliente</span>
          </div>
        </div>

        <div class="users-form-page__field">
          <%= form.label :title, 'Título', class: 'crm-label' %>
          <%= form.text_field :title, class: 'crm-input', placeholder: 'Ex.: Ganhe 10% de desconto!' %>
        </div>

        <div class="users-form-page__field">
          <%= form.label :description, 'Descrição', class: 'crm-label' %>
          <%= form.text_area :description, class: 'crm-input', rows: 3, placeholder: 'Texto de apoio abaixo do título' %>
        </div>

        <div class="users-form-page__row">
          <div class="users-form-page__field">
            <%= form.label :coupon_code, 'Código do cupom', class: 'crm-label' %>
            <%= form.text_field :coupon_code, class: 'crm-input', placeholder: 'Ex.: BEMVINDO10' %>
            <span class="cpform-field__hint">Código já criado na Shopify — só é exibido após o envio.</span>
          </div>
          <div class="users-form-page__field">
            <%= form.label :button_text, 'Texto do botão', class: 'crm-label' %>
            <%= form.text_field :button_text, class: 'crm-input' %>
          </div>
        </div>

        <div class="users-form-page__row">
          <div class="users-form-page__field">
            <%= form.label :template, 'Template', class: 'crm-label' %>
            <%= form.select :template,
                options_for_select([
                  ['Centralizado', 'template_1'],
                  ['Imagem à esquerda', 'template_2'],
                  ['Imagem à direita', 'template_3'],
                  ['Banner sem imagem', 'template_4']
                ], form.object.template),
                {}, class: 'crm-input' %>
          </div>
          <div class="users-form-page__field">
            <%= form.label :size, 'Tamanho', class: 'crm-label' %>
            <%= form.select :size,
                options_for_select([['Pequeno', 'small'], ['Médio', 'medium'], ['Grande', 'large']], form.object.size),
                {}, class: 'crm-input' %>
          </div>
        </div>

        <div class="users-form-page__row">
          <div class="users-form-page__field">
            <%= form.label :accent_color, 'Cor de destaque', class: 'crm-label' %>
            <%= form.color_field :accent_color, class: 'crm-input popups-color-input' %>
          </div>
          <div class="users-form-page__field">
            <%= form.label :reappear_after_hours, 'Reexibir após (horas)', class: 'crm-label' %>
            <%= form.number_field :reappear_after_hours, class: 'crm-input', min: 1 %>
          </div>
        </div>

        <div class="users-form-page__field">
          <%= form.label :image, 'Imagem (opcional, ignorada no template Banner)', class: 'crm-label' %>
          <% if @popup.image.attached? %>
            <div class="popups-image-preview">
              <%= image_tag url_for(@popup.image), class: 'popups-image-preview__img' %>
              <label class="cform-toggle">
                <%= check_box_tag 'popup[remove_image]', '1', false, class: 'cform-toggle__input' %>
                <span class="cform-toggle__label">Remover imagem atual</span>
              </label>
            </div>
          <% end %>
          <%= form.file_field :image, class: 'crm-input' %>
        </div>

        <% if @popup.persisted? %>
          <div class="users-form-page__section">
            <div class="users-form-page__section-header">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
              </svg>
              Snippet para o site do cliente
            </div>
            <pre class="popups-script-box"><code>&lt;script src=&quot;<%= Popup::WIDGET_HOST %>/widget/popup.js&quot; data-token=&quot;<%= @popup.public_token %>&quot; async&gt;&lt;/script&gt;</code></pre>
          </div>
        <% else %>
          <span class="cpform-field__hint">Salve o pop-up pra gerar o snippet de instalação.</span>
        <% end %>
      </div>

      <div class="users-form-page__footer">
        <%= form.button class: 'crm-btn crm-btn--primary', data: { disable_with: 'Salvando...' } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Salvar Pop-up
        <% end %>
      </div>
    <% end %>

  </div>

  <div class="crm-card popups-preview">
    <div class="popups-preview__header">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.964-7.178z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      Preview
    </div>
    <div class="popups-preview__stage">
      <div class="mewtda-popup-preview" id="popup-preview">
        <button type="button" class="mewtda-popup-preview__close" aria-label="Fechar">&times;</button>
        <div class="mewtda-popup-preview__image" id="popup-preview-image-wrap" <%= 'hidden' unless @popup.image.attached? %>>
          <img id="popup-preview-image" alt="" <% if @popup.image.attached? %>src="<%= url_for(@popup.image) %>"<% end %>>
        </div>
        <div class="mewtda-popup-preview__content">
          <h2 class="mewtda-popup-preview__title" id="popup-preview-title"><%= @popup.title.presence || 'Título do pop-up' %></h2>
          <p class="mewtda-popup-preview__description" id="popup-preview-description" <%= 'hidden' if @popup.description.blank? %>><%= @popup.description %></p>
          <div class="mewtda-popup-preview__form">
            <div class="mewtda-popup-preview__input">Seu nome</div>
            <div class="mewtda-popup-preview__input">Seu e-mail</div>
            <div class="mewtda-popup-preview__input">Seu telefone</div>
            <button type="button" class="mewtda-popup-preview__submit" id="popup-preview-button" disabled><%= @popup.button_text.presence || 'Cadastrar' %></button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var stage = document.getElementById('popup-preview');
    if (!stage) return;

    var hasImage = <%= @popup.image.attached? ? 'true' : 'false' %>;

    function byId(id) { return document.getElementById(id); }

    function updateText() {
      var titleEl = byId('popup_title');
      var descEl = byId('popup_description');
      var buttonEl = byId('popup_button_text');

      byId('popup-preview-title').textContent = (titleEl.value || 'Título do pop-up');
      byId('popup-preview-description').textContent = descEl.value;
      byId('popup-preview-description').hidden = !descEl.value;
      byId('popup-preview-button').textContent = (buttonEl.value || 'Cadastrar');
    }

    function updateColor() {
      var colorEl = byId('popup_accent_color');
      stage.style.setProperty('--mewtda-preview-accent', colorEl.value || '#7c3aed');
    }

    function refreshImageVisibility() {
      var template = byId('popup_template').value;
      byId('popup-preview-image-wrap').hidden = !hasImage || template === 'template_4';
    }

    function updateTemplateAndSize() {
      var template = byId('popup_template').value;
      var size = byId('popup_size').value;
      stage.className = 'mewtda-popup-preview mewtda-popup-preview--' + template + ' mewtda-popup-preview--' + size;
      refreshImageVisibility();
    }

    function updateImage() {
      var fileInput = byId('popup_image');
      var file = fileInput.files && fileInput.files[0];
      if (!file) return;

      var reader = new FileReader();
      reader.onload = function (e) {
        byId('popup-preview-image').src = e.target.result;
        hasImage = true;
        refreshImageVisibility();
      };
      reader.readAsDataURL(file);
    }

    ['popup_title', 'popup_description', 'popup_button_text'].forEach(function (id) {
      byId(id).addEventListener('input', updateText);
    });
    byId('popup_accent_color').addEventListener('input', updateColor);
    byId('popup_template').addEventListener('change', updateTemplateAndSize);
    byId('popup_size').addEventListener('change', updateTemplateAndSize);
    byId('popup_image').addEventListener('change', updateImage);

    updateColor();
    updateTemplateAndSize();
  })();
</script>
