<% title "Mewtda — #{t('home.city.title')}" %>

<%#
  Home pública "Cidade noturna": hero sobre um vídeo aéreo noturno de
  Manhattan com balões dos produtos pipocando pela cidade; abaixo, letreiro
  corrido, os cinco canais (acordeão com as telas reais no navegador +
  celular) e o neon de contato. Layout próprio (layouts/home_city), CSS em
  stylesheets/home_city.scss.
%>

<%
  whatsapp = "https://wa.me/5516991997608?text=#{CGI.escape(t('home.city.whatsapp_message'))}"
  sua_html = safe_join(['Sua ', content_tag(:span, safe_join(%w[Loja Operação Marca].map { |word| content_tag(:span, word) }), class: 'rot')])
  channels = [
    { key: 'crm',    name: 'MeuCRM',      host: 'APP.MEWTDA.COM.BR', desk: 'landing/showcase-crm.jpg',    mob: 'landing/showcase-crm-mobile.jpg',
      login: 'https://www.mewtda.com.br/crm' },
    { key: 'trocas', name: 'Pode Trocar', host: 'PODETROCAR.COM.BR', desk: 'landing/showcase-trocas.jpg', mob: 'landing/showcase-trocas-mobile.jpg',
      login: HomeHelper::PODE_TROCAR_URL },
    { key: 'new',    name: 'Sua Loja',    host: 'LOJA DO CLIENTE',   desk: 'landing/site-desktop.jpg',    mob: 'landing/showcase-new-mobile.jpg', html: sua_html },
    { key: 'app',    name: 'App',         host: 'APP DA LOJA',       desk: 'landing/showcase-app.jpg',    mob: 'landing/showcase-app-mobile.jpg' },
    { key: 'ia',     name: t('home.city.ia_name'), host: 'MEWTDA IA', desk: 'landing/showcase-ia.jpg', mob: 'landing/showcase-ia-mobile.jpg' }
  ]
  open_index = 1
  pins = [
    ['landing/meu-crm-logo.png',     64, 34],
    ['landing/pode-trocar-logo.png', 84, 52],
    ['landing/sua-loja-logo.png',    72, 70],
    ['landing/app-logo.png',         90, 28],
    [nil,                            58, 58]
  ]
%>

<section class="hero" id="topo">
  <video class="hero-video" autoplay muted loop playsinline preload="auto" poster="<%= image_path('landing/city-poster.jpg') %>" aria-hidden="true">
    <source src="<%= asset_path('city-night-1080.webm') %>" type="video/webm">
    <source src="<%= asset_path('city-night-1080.mp4') %>" type="video/mp4">
  </video>

  <div class="pins" aria-hidden="true">
    <% pins.each_with_index do |(logo, x, y), i| %>
      <span class="pin" style="--x: <%= x %>%; --y: <%= y %>%; --dl: <%= i * 3 %>s">
        <span class="bubble">
          <% if logo %>
            <%= image_tag logo, alt: '' %>
          <% else %>
            <span class="ia">mewtda <b>IA</b></span>
          <% end %>
        </span>
      </span>
    <% end %>
  </div>

  <span class="credit"><%= t('home.city.video_credit') %>: <a href="https://commons.wikimedia.org/wiki/File:Aerial_views_of_Downtown_Manhattan,_New_York_City,_USA_at_night_including_Battery_Park,_Freedom_Tower,_Wall_Street,_The_Oculus,_West_Side_Highway_and_Hudson_River.webm" target="_blank" rel="noopener">the Dronalist</a>, CC BY 3.0</span>

  <div class="wrap nav">
    <a class="logo" href="#topo">mewtda</a>
    <nav aria-label="<%= t('home.city.nav_label') %>">
      <a href="#canais"><%= t('home.city.nav_channels') %></a>
      <a href="#clientes"><%= t('home.city.nav_clients') %></a>
      <a href="#contato"><%= t('home.city.nav_contact') %></a>
      <span class="lang">
        <% { 'pt-BR' => 'PT', 'en' => 'EN', 'es' => 'ES' }.each do |code, label| %>
          <%= link_to label, url_for(locale: code), class: ('is-active' if I18n.locale.to_s == code), data: { turbo: false } %>
        <% end %>
      </span>
    </nav>
  </div>

  <div class="wrap">
    <div class="hero-body">
      <span class="kicker"><%= t('home.city.kicker') %></span>
      <h1>
        <span class="glitch" data-text="<%= t('home.city.headline_prefix') %>"><%= t('home.city.headline_prefix') %></span>
        <span class="rot"><% t('home.city.hero_words').each do |word| %><span><%= word %></span><% end %></span><br>
        <span class="stroke"><%= t('home.city.headline_2') %></span> <span class="hot"><%= t('home.city.headline_3') %></span>
      </h1>
      <p class="lead"><%= t('home.city.lead') %></p>
      <div class="actions">
        <a class="btn btn--solid" href="<%= whatsapp %>" target="_blank" rel="noopener"><%= t('home.city.cta') %></a>
        <button type="button" class="sound" data-sound-toggle aria-pressed="false"
                aria-label="<%= t('home.sound.remote_tip') %>" title="<%= t('home.sound.remote_tip') %>">
          <svg class="off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="m16 9 5 6M21 9l-5 6"/></svg>
          <svg class="on" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    <% 2.times do %>
      <% t('home.city.ticker').each do |item| %><span><%= item %></span><b>◆</b><% end %>
    <% end %>
  </div>
</div>

<section class="channels" id="canais">
  <div class="wrap">
    <div class="ch-head">
      <h2><%= t('home.city.channels_title_1') %><br><%= t('home.city.channels_title_2') %></h2>
      <p><%= t('home.city.channels_text') %></p>
    </div>

    <div class="ch-list" data-channels>
      <% channels.each_with_index do |c, i| %>
        <% open = i == open_index %>
        <% page = product_page_path(c[:key]) %>
        <div class="ch" data-open="<%= open %>">
          <button type="button" class="ch-btn" aria-expanded="<%= open %>" aria-controls="ch-stage-<%= i %>">
            <span class="ch-code">CH.0<%= i + 1 %></span>
            <span class="ch-name"><%= c[:html] || c[:name] %></span>
            <span class="ch-tag"><%= t("home.city.channels.#{c[:key]}") %></span>
            <span class="ch-sign" aria-hidden="true"><%= open ? '−' : '+' %></span>
          </button>
          <div class="ch-stage" id="ch-stage-<%= i %>" <%= 'hidden' unless open %>>
            <span class="ch-live" aria-hidden="true"><%= t('home.city.live') %> · <%= c[:host] %></span>
            <div class="screen">
              <div class="screen-desk">
                <% if c[:desk] %>
                  <%= image_tag c[:desk], alt: c[:name], loading: 'lazy' %>
                <% else %>
                  <div class="placeholder"><%= c[:name].upcase %> · <%= t('home.city.soon') %></div>
                <% end %>
              </div>
              <div class="phone" aria-hidden="true">
                <div>
                  <% if c[:mob] %>
                    <%= image_tag c[:mob], alt: '', loading: 'lazy' %>
                  <% else %>
                    <div class="placeholder"><%= t('home.city.soon') %></div>
                  <% end %>
                </div>
              </div>
            </div>
            <% if c[:login] || page %>
              <div class="ch-actions">
                <% if c[:login] %>
                  <a class="btn btn--solid btn--sm" href="<%= c[:login] %>" target="_blank" rel="noopener"><%= t('home.city.login', product: c[:name]) %></a>
                <% end %>
                <% if page && page != c[:login] %>
                  <a class="ch-link" href="<%= page %>"<%= ' target="_blank" rel="noopener"'.html_safe if page.start_with?('http') %>><%= t('home.city.open_page') %> →</a>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<% client_logos = client_logo_assets %>
<% if client_logos.any? %>
  <%# Clientes: fachada de prédio à noite, cada logo é um letreiro de neon que
      acende piscando (fora de ordem) quando a seção entra na tela; ao passar
      o mouse aparece a plaquinha com o endereço da loja. %>
  <section class="clients" id="clientes">
    <div class="wrap">
      <div class="ch-head">
        <div>
          <span class="kicker"><span class="rec" aria-hidden="true"></span><%= t('home.city.clients_kicker', count: client_logos.size) %></span>
          <h2><%= t('home.city.clients_title_1') %><br><span class="hot"><%= t('home.city.clients_title_2') %></span></h2>
        </div>
        <p><%= t('home.city.clients_text') %></p>
      </div>

      <div class="facade" data-facade>
        <% neons = %w[#ff7a1a #00e5ff #ff2bd6 #a78bfa #22c55e #f5b301] %>
        <% client_logos.each_with_index do |logo, i| %>
          <% site = client_site(logo) %>
          <% host = site && URI(site).host.delete_prefix('www.') %>
          <% style = "--neon: #{neons[i % neons.size]}; --on: #{((i * 7) % client_logos.size) * 0.14}s" %>
          <% sign = capture do %>
            <%= image_tag logo, alt: host || t('home.clients.logo_alt'), loading: 'lazy' %>
            <% if host %><span class="plate"><%= host %></span><% end %>
          <% end %>
          <% if site %>
            <a class="sign" href="<%= site %>" target="_blank" rel="noopener" style="<%= style %>"><%= sign %></a>
          <% else %>
            <div class="sign" style="<%= style %>"><%= sign %></div>
          <% end %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<section class="contact" id="contato">
  <div class="wrap">
    <span class="kicker"><%= t('home.city.contact_kicker') %></span>
    <h2><%= t('home.city.contact_title_1') %><br><%= t('home.city.contact_title_2') %></h2>
    <a class="btn btn--line" href="<%= whatsapp %>" target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 1-13.2 7.9L3 21l1.1-4.6A9 9 0 1 1 21 12z"/></svg>
      <%= t('home.city.contact_button') %>
    </a>
  </div>
</section>

<footer class="foot">
  <div class="wrap">
    <span>© <%= Date.current.year %> MEWTDA</span>
    <span>CH.01 MEUCRM · CH.02 PODE TROCAR · CH.03 SUA LOJA · CH.04 APP · CH.05 IA</span>
  </div>
</footer>

<script>
  // canais: acordeão, um aberto por vez
  (function () {
    var list = document.querySelector('[data-channels]')
    if (!list) return
    list.addEventListener('click', function (e) {
      var btn = e.target.closest('.ch-btn')
      if (!btn) return
      var item = btn.parentElement
      var open = item.getAttribute('data-open') !== 'true'
      list.querySelectorAll('.ch').forEach(function (ch) {
        var me = ch === item && open
        ch.setAttribute('data-open', me)
        ch.querySelector('.ch-btn').setAttribute('aria-expanded', me)
        ch.querySelector('.ch-sign').textContent = me ? '−' : '+'
        ch.querySelector('.ch-stage').hidden = !me
      })
    })
  })()

  // clientes: os letreiros acendem quando a fachada aparece na tela
  // (o ; inicial evita que o IIFE acima seja chamado com este como argumento)
  ;(function () {
    var facade = document.querySelector('[data-facade]')
    if (!facade) return
    if (!('IntersectionObserver' in window)) return facade.classList.add('is-lit')
    var io = new IntersectionObserver(function (entries) {
      if (!entries[0].isIntersecting) return
      facade.classList.add('is-lit')
      io.disconnect()
    }, { threshold: 0.25 })
    io.observe(facade)
  })()
</script>

<%= render 'home/sound_script' %>
