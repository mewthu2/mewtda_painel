<% title "Mewtda — #{t('home.hero.badge')}" %>

<%#
  =====================================================================
  MEWTDA — Landing Page
  ---------------------------------------------------------------------
  1) CSS     → app/assets/stylesheets/pages/landing.scss (required por
     admin.scss, entra no precompile normal do Sprockets).
  2) markup  → classes mwtda-lp-*, com atributos data-reveal /
     data-reveal-self nos pontos onde entra efeito de rolagem.
  3) <script> → JS puro (sem dependência nenhuma) com os efeitos de
     scroll: controle remoto (menu fixo), parallax sutil no hero, reveal
     em cascata nos cards (fade + slide + blur) via IntersectionObserver,
     e uma barra de progresso que "acende" os 3 passos de "Como
     funciona" conforme você rola. Pode virar
     app/javascript/landing/scroll_effects.js e ser importado no seu
     application.js / importmap.
  =====================================================================
%>

<% content_for :head do %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap">
<% end %>

<div class="mwtda-lp">

  <%= render 'home/remote' %>

  <section class="mwtda-lp-hero" id="inicio">
    <div class="mwtda-lp-hero__inner">
      <div class="mwtda-lp-hero__logo3d" data-mwtda-wave-logo aria-hidden="true">
        <canvas class="mwtda-lp-hero__logo3d-canvas"></canvas>
      </div>
      <h1 class="mwtda-lp-hero__headline"><%= t('home.hero.headline') %></h1>
      <p class="mwtda-lp-hero__subheadline">
        <%= t('home.hero.subheadline') %>
      </p>
      <div class="mwtda-lp-hero__ctas">
        <a
          href="https://wa.me/5516991997608?text=<%= CGI.escape(t('home.hero.whatsapp_message')) %>"
          target="_blank"
          class="mwtda-lp-btn mwtda-lp-btn--primary mwtda-lp-btn--lg"
        >
          <i class="fa-brands fa-whatsapp"></i> <%= t('home.hero.cta_contato') %>
        </a>
        <a href="#produtos" class="mwtda-lp-btn mwtda-lp-btn--outline mwtda-lp-btn--lg"><%= t('home.hero.cta_ver_solucoes') %></a>
      </div>
    </div>
  </section>

  <%# Visão geral: os 4 produtos, cada um com o seu logo %>
  <section class="mwtda-lp-products" id="produtos">
    <div class="mwtda-lp-products__inner">
      <span class="mwtda-lp-eyebrow" data-reveal-self><%= t('home.products.eyebrow') %></span>
      <h2 class="mwtda-lp-section__title" data-reveal-self><%= t('home.products.title') %></h2>
      <p class="mwtda-lp-section__lead" data-reveal-self><%= t('home.products.lead') %></p>

      <div class="mwtda-lp-products__grid" data-reveal>
        <% landing_products.each do |product| %>
          <a href="#<%= product[:anchor] %>" class="mwtda-lp-products__card" style="--plogo: <%= product[:color] %>">
            <span class="mwtda-lp-products__icon"><i class="<%= product[:icon] %>"></i></span>
            <%= render 'home/product_logo', product: product %>
            <p><%= t("home.products.#{product[:key]}.tagline") %></p>
            <em><%= t('home.products.more') %> <i class="fa-solid fa-arrow-right"></i></em>
          </a>
        <% end %>
      </div>
    </div>
  </section>

  <% client_logos = client_logo_assets %>
  <% if client_logos.any? %>
    <%# Clientes: duas faixas de logos correndo em sentidos opostos, dentro de
        um cartão — logos viram silhueta escura uniforme (vêm em variantes
        claras/escuras diferentes) e ganham cor ao passar o mouse. %>
    <section class="mwtda-lp-clients" id="clientes">
      <div class="mwtda-lp-clients__inner">
        <span class="mwtda-lp-eyebrow" data-reveal-self><%= t('home.clients.title') %></span>
        <h2 class="mwtda-lp-section__title mwtda-lp-clients__headline" data-reveal-self><%= t('home.clients.headline') %></h2>
        <p class="mwtda-lp-section__lead mwtda-lp-clients__lead" data-reveal-self><%= t('home.clients.lead') %></p>

        <div class="mwtda-lp-clients__board" data-reveal-self>
          <% [client_logos, client_logos.reverse].each_with_index do |row, r| %>
            <div class="mwtda-lp-clients__strip">
              <div class="mwtda-lp-clients__track<%= ' mwtda-lp-clients__track--reverse' if r.odd? %>">
                <%# duplicado pra loop do marquee ficar contínuo (o CSS anima -50%) %>
                <% (row + row).each_with_index do |logo, i| %>
                  <div class="mwtda-lp-clients__tile">
                    <%= image_tag logo, class: 'mwtda-lp-clients__logo', alt: (i < row.size && r.zero? ? t('home.clients.logo_alt') : ''), 'aria-hidden': (i >= row.size || r.odd?) ? 'true' : nil, loading: 'lazy' %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </section>
  <% end %>

  <%# ============================ 01 — CRM ============================ %>
  <section class="mwtda-lp-part" id="crm">
    <div class="mwtda-lp-part__inner">
      <div class="mwtda-lp-part__copy">
        <div class="mwtda-lp-part__label" data-reveal-self>
          <span class="mwtda-lp-part__number"><%= t('home.crm_part.number') %></span>
          <%= render 'home/product_logo', product: landing_product('crm') %>
        </div>
        <h2 class="mwtda-lp-part__title" data-reveal-self><%= t('home.crm_part.title') %></h2>
        <p class="mwtda-lp-part__lead" data-reveal-self><%= t('home.crm_part.lead') %></p>

        <ul class="mwtda-lp-part__features" data-reveal>
          <% { analytics: 'fa-solid fa-filter', clientes: 'fa-solid fa-users', trocas: 'fa-solid fa-arrow-right-arrow-left', whatsapp: 'fa-brands fa-whatsapp' }.each do |key, icon| %>
            <li>
              <span class="mwtda-lp-part__feature-icon"><i class="<%= icon %>"></i></span>
              <strong><%= t("home.crm_part.features.#{key}.title") %></strong>
              <p><%= t("home.crm_part.features.#{key}.text") %></p>
            </li>
          <% end %>
        </ul>

        <div class="mwtda-lp-part__actions" data-reveal-self>
          <a href="https://wa.me/5516991997608?text=<%= CGI.escape(t('home.crm_part.whatsapp_message')) %>" target="_blank" class="mwtda-lp-btn mwtda-lp-btn--dark mwtda-lp-btn--lg">
            <i class="fa-brands fa-whatsapp"></i> <%= t('home.crm_part.cta_button') %>
          </a>
        </div>
      </div>

      <div class="mwtda-lp-part__visual mwtda-lp-part__visual--wide" data-reveal-self>
        <div class="mwtda-lp-part__glow"></div>
        <%# Notebook em CSS com o print do painel. Pra trocar o print, é só
            substituir app/assets/images/landing/crm-analytics.png — se o
            arquivo não existir, cai numa versão em HTML do mesmo painel. %>
        <div class="mwtda-lp-laptop">
          <div class="mwtda-lp-laptop__screen">
            <span class="mwtda-lp-laptop__camera"></span>
            <div class="mwtda-lp-laptop__display">
              <% if landing_image?('landing/crm-analytics.png') %>
                <%= image_tag 'landing/crm-analytics.png', alt: t('home.crm_part.screen_alt'), loading: 'lazy' %>
              <% else %>
                <%= render 'home/crm_screen' %>
              <% end %>
            </div>
          </div>
          <div class="mwtda-lp-laptop__base"><span></span></div>
        </div>
      </div>
    </div>
  </section>

  <%# ======================== 02 — TROCA FÁCIL ======================== %>
  <section class="mwtda-lp-part mwtda-lp-part--tint mwtda-lp-part--flip" id="trocas">
    <div class="mwtda-lp-part__inner">
      <div class="mwtda-lp-part__copy">
        <div class="mwtda-lp-part__label" data-reveal-self>
          <span class="mwtda-lp-part__number"><%= t('home.trocas_part.number') %></span>
          <%= render 'home/product_logo', product: landing_product('trocas') %>
        </div>
        <h2 class="mwtda-lp-part__title" data-reveal-self><%= t('home.trocas_part.title') %></h2>
        <p class="mwtda-lp-part__lead" data-reveal-self><%= t('home.trocas_part.lead') %></p>

        <ul class="mwtda-lp-part__features" data-reveal>
          <% { portal: 'fa-solid fa-magnifying-glass', regras: 'fa-regular fa-calendar-check', foto: 'fa-solid fa-camera', cupom: 'fa-solid fa-ticket' }.each do |key, icon| %>
            <li>
              <span class="mwtda-lp-part__feature-icon"><i class="<%= icon %>"></i></span>
              <strong><%= t("home.trocas_part.features.#{key}.title") %></strong>
              <p><%= t("home.trocas_part.features.#{key}.text") %></p>
            </li>
          <% end %>
        </ul>

        <div class="mwtda-lp-part__actions" data-reveal-self>
          <a href="https://wa.me/5516991997608?text=<%= CGI.escape(t('home.trocas_part.whatsapp_message')) %>" target="_blank" class="mwtda-lp-btn mwtda-lp-btn--dark mwtda-lp-btn--lg">
            <i class="fa-brands fa-whatsapp"></i> <%= t('home.trocas_part.cta_button') %>
          </a>
        </div>
      </div>

      <div class="mwtda-lp-part__visual" data-reveal-self>
        <div class="mwtda-lp-part__glow"></div>
        <%# Celular com o portal de trocas que o cliente final usa
            (widget/exchanges) — só ilustração, dados fixos %>
        <div class="mwtda-lp-shop__phone mwtda-lp-exchange" aria-hidden="true">
          <div class="mwtda-lp-shop__notch"></div>
          <div class="mwtda-lp-shop__screen">
            <div class="mwtda-lp-shop__statusbar"><span>9:41</span><span><i class="fa-solid fa-signal"></i> <i class="fa-solid fa-wifi"></i> <i class="fa-solid fa-battery-full"></i></span></div>
            <div class="mwtda-lp-exchange__body">
              <span class="mwtda-lp-exchange__store">ATELIÊ</span>
              <strong class="mwtda-lp-exchange__title"><%= t('home.trocas_part.portal.title') %></strong>
              <span class="mwtda-lp-exchange__order"><%= t('home.trocas_part.portal.order') %></span>

              <% t('home.trocas_part.portal.items').zip(%w[1591047139829-d91aecb6caea 1503342217505-b0a15ec3261c]).each_with_index do |(item, photo), i| %>
                <div class="mwtda-lp-exchange__item<%= ' is-selected' if i.zero? %>">
                  <img src="https://images.unsplash.com/photo-<%= photo %>?w=160&q=70&auto=format&fit=crop" alt="" loading="lazy">
                  <div>
                    <b><%= item %></b>
                    <span class="mwtda-lp-exchange__check"><i class="fa-solid fa-check"></i> <%= t('home.trocas_part.portal.select_item') %></span>
                    <% if i.zero? %>
                      <span class="mwtda-lp-exchange__select"><%= t('home.trocas_part.portal.kind') %> <i class="fa-solid fa-chevron-down"></i></span>
                      <span class="mwtda-lp-exchange__select"><%= t('home.trocas_part.portal.reason') %> <i class="fa-solid fa-chevron-down"></i></span>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <span class="mwtda-lp-exchange__submit"><%= t('home.trocas_part.portal.submit') %></span>

              <div class="mwtda-lp-exchange__coupon">
                <i class="fa-solid fa-ticket"></i>
                <div>
                  <small><%= t('home.trocas_part.portal.coupon_label') %></small>
                  <b><%= t('home.trocas_part.portal.coupon_value') %></b>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="mwtda-lp-shop__notifications" aria-hidden="true">
          <% [%w[new fa-solid fa-arrow-right-arrow-left], %w[approved fa-solid fa-ticket]].each_with_index do |(key, *icon), i| %>
            <div class="mwtda-lp-shop__notification mwtda-lp-exchange__notification--<%= key %>" style="--i: <%= i %>">
              <span class="mwtda-lp-shop__notification-icon"><i class="<%= icon.join(' ') %>"></i></span>
              <div>
                <strong><%= t("home.trocas_part.notifications.#{key}_title") %></strong>
                <span><%= t("home.trocas_part.notifications.#{key}_text") %></span>
              </div>
              <small><%= t('home.apps.notifications.now') %></small>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <%# ============================ 03 — NEW (SITES) ============================ %>
  <section class="mwtda-lp-part" id="sites">
    <div class="mwtda-lp-part__inner">
      <div class="mwtda-lp-part__copy">
        <div class="mwtda-lp-part__label" data-reveal-self>
          <span class="mwtda-lp-part__number"><%= t('home.sites.number') %></span>
          <%= render 'home/product_logo', product: landing_product('new') %>
        </div>
        <h2 class="mwtda-lp-part__title" data-reveal-self><%= t('home.sites.title') %></h2>
        <p class="mwtda-lp-part__lead" data-reveal-self><%= t('home.sites.lead') %></p>

        <ul class="mwtda-lp-part__list" data-reveal>
          <% { design: 'fa-solid fa-palette', loja: 'fa-brands fa-shopify', crm: 'fa-solid fa-plug' }.each do |key, icon| %>
            <li>
              <span class="mwtda-lp-part__feature-icon"><i class="<%= icon %>"></i></span>
              <div>
                <strong><%= t("home.sites.#{key}.title") %></strong>
                <p><%= t("home.sites.#{key}.text") %></p>
              </div>
            </li>
          <% end %>
        </ul>

        <div class="mwtda-lp-part__actions" data-reveal-self>
          <a href="https://wa.me/5516991997608?text=<%= CGI.escape(t('home.sites.whatsapp_message')) %>" target="_blank" class="mwtda-lp-btn mwtda-lp-btn--dark mwtda-lp-btn--lg">
            <i class="fa-brands fa-whatsapp"></i> <%= t('home.sites.cta_button') %>
          </a>
        </div>
      </div>

      <div class="mwtda-lp-part__visual" data-reveal-self>
        <div class="mwtda-lp-part__glow"></div>
        <div class="mwtda-lp-devices">
          <div class="mwtda-lp-browser">
            <div class="mwtda-lp-browser__bar">
              <span></span><span></span><span></span>
              <em><i class="fa-solid fa-lock"></i> fernandafarah.com.br</em>
            </div>
            <%= image_tag 'landing/site-desktop.jpg', alt: t('home.sites.desktop_alt'), class: 'mwtda-lp-browser__shot', loading: 'lazy' %>
          </div>

          <div class="mwtda-lp-devices__phone">
            <div class="mwtda-lp-shop__phone mwtda-lp-shop__phone--static">
              <div class="mwtda-lp-shop__notch"></div>
              <div class="mwtda-lp-shop__screen">
                <%= image_tag 'landing/site-mobile.jpg', alt: t('home.sites.mobile_alt'), class: 'mwtda-lp-devices__phone-shot', loading: 'lazy' %>
              </div>
            </div>
          </div>

          <a class="mwtda-lp-devices__case" href="https://fernandafarah.com.br" target="_blank" rel="noopener">
            <span><%= t('home.sites.case_label') %></span>
            <strong>Fernanda Farah</strong>
            <em><%= t('home.sites.case_link') %> <i class="fa-solid fa-arrow-up-right-from-square"></i></em>
          </a>
        </div>
      </div>
    </div>
  </section>

  <%
    # ============================ 04 — APPS ============================
    # Fotos da vitrine fake dentro do celular (Unsplash). Pra usar prints
    # reais de lojas de clientes, é só trocar as URLs aqui.
    unsplash = ->(id, w = 360) { "https://images.unsplash.com/photo-#{id}?w=#{w}&q=70&auto=format&fit=crop" }
    app_segments = {
      moda:        { store: 'ATELIÊ',   accent: '#e4572e', banner: '1483985988355-763728e1935b', products: %w[1591047139829-d91aecb6caea 1503342217505-b0a15ec3261c 1542291026-7eec264c27ff 1560343090-f0409e92791a] },
      beleza:      { store: 'glow.co',  accent: '#c2587e', banner: '1596462502278-27bfdc403348', products: %w[1608571423902-eed4a5ad8108 1620916566398-39f1143ab7be 1571781926291-c477ebfd024b 1556228578-8c89e6adf883] },
      eletronicos: { store: 'VOLT',     accent: '#2563eb', banner: '1505740420928-5e560c06d30e', products: %w[1546868871-7041f2a55e12 1583394838336-acd977736f90 1526170375885-4d8ecf77b99f 1523275335684-37898b6baf30] },
      casa:        { store: 'casa.nua', accent: '#0f766e', banner: '1586023492125-27b2c045efd7', products: %w[1555041469-a586c61ea9bc 1567538096630-e0c55bd6374c 1513506003901-1e6a229e2d15 1524758631624-e2822e304c36] }
    }
  %>
  <section class="mwtda-lp-part mwtda-lp-part--tint mwtda-lp-part--flip mwtda-lp-shop" id="apps" data-shop-showcase>
    <div class="mwtda-lp-part__inner">
      <div class="mwtda-lp-part__copy">
        <div class="mwtda-lp-part__label" data-reveal-self>
          <span class="mwtda-lp-part__number"><%= t('home.apps.number') %></span>
          <%= render 'home/product_logo', product: landing_product('app') %>
          <span class="mwtda-lp-badge"><%= t('home.apps.badge') %></span>
        </div>
        <h2 class="mwtda-lp-part__title" data-reveal-self><%= t('home.apps.title') %></h2>
        <p class="mwtda-lp-part__lead" data-reveal-self><%= t('home.apps.lead') %></p>

        <div class="mwtda-lp-shop__segments" data-reveal-self>
          <span class="mwtda-lp-shop__segments-label"><%= t('home.apps.segments_label') %></span>
          <div class="mwtda-lp-shop__tabs" role="tablist">
            <% app_segments.each_key.with_index do |key, i| %>
              <button type="button" class="mwtda-lp-shop__tab" role="tab" aria-selected="<%= i.zero? %>" data-shop-tab="<%= key %>"><%= t("home.apps.segments.#{key}.label") %></button>
            <% end %>
          </div>
          <div class="mwtda-lp-shop__pitches">
            <% app_segments.each_key.with_index do |key, i| %>
              <p class="mwtda-lp-shop__pitch" data-shop-panel="<%= key %>" data-active="<%= i.zero? %>"><%= t("home.apps.segments.#{key}.pitch") %></p>
            <% end %>
          </div>
        </div>

        <div class="mwtda-lp-part__actions" data-reveal-self>
          <a href="https://wa.me/5516991997608?text=<%= CGI.escape(t('home.apps.whatsapp_message')) %>" target="_blank" class="mwtda-lp-btn mwtda-lp-btn--dark mwtda-lp-btn--lg">
            <i class="fa-regular fa-bell"></i> <%= t('home.apps.cta_button') %>
          </a>
          <ul class="mwtda-lp-shop__pills">
            <% t('home.apps.pills').each do |pill| %>
              <li><i class="fa-solid fa-check"></i> <%= pill %></li>
            <% end %>
          </ul>
        </div>
      </div>

      <div class="mwtda-lp-part__visual" data-reveal-self>
        <div class="mwtda-lp-part__glow"></div>

        <div class="mwtda-lp-shop__phone" aria-hidden="true">
          <div class="mwtda-lp-shop__notch"></div>
          <div class="mwtda-lp-shop__screen">
            <div class="mwtda-lp-shop__statusbar"><span>9:41</span><span><i class="fa-solid fa-signal"></i> <i class="fa-solid fa-wifi"></i> <i class="fa-solid fa-battery-full"></i></span></div>

            <% app_segments.each_with_index do |(key, seg), i| %>
              <div class="mwtda-lp-shop__store" data-shop-panel="<%= key %>" data-active="<%= i.zero? %>" style="--shop-accent: <%= seg[:accent] %>">
                <div class="mwtda-lp-shop__store-header">
                  <i class="fa-solid fa-bars"></i>
                  <span class="mwtda-lp-shop__store-name"><%= seg[:store] %></span>
                  <span class="mwtda-lp-shop__bag"><i class="fa-solid fa-bag-shopping"></i><em>2</em></span>
                </div>
                <div class="mwtda-lp-shop__search"><i class="fa-solid fa-magnifying-glass"></i> <%= t('home.apps.phone.search') %></div>

                <div class="mwtda-lp-shop__banner">
                  <img src="<%= unsplash.(seg[:banner], 520) %>" alt="" loading="lazy">
                  <div class="mwtda-lp-shop__banner-copy">
                    <span><%= t("home.apps.segments.#{key}.banner_tag") %></span>
                    <strong><%= t("home.apps.segments.#{key}.banner_title") %></strong>
                    <em><%= t('home.apps.phone.shop_now') %> <i class="fa-solid fa-arrow-right"></i></em>
                  </div>
                </div>

                <div class="mwtda-lp-shop__grid">
                  <% names = t("home.apps.segments.#{key}.products") %>
                  <% prices = t("home.apps.segments.#{key}.prices") %>
                  <% seg[:products].each_with_index do |photo, p| %>
                    <div class="mwtda-lp-shop__product">
                      <div class="mwtda-lp-shop__product-img">
                        <img src="<%= unsplash.(photo, 240) %>" alt="" loading="lazy">
                        <i class="fa-regular fa-heart"></i>
                      </div>
                      <span class="mwtda-lp-shop__product-name"><%= names[p] %></span>
                      <span class="mwtda-lp-shop__product-price"><%= prices[p] %></span>
                      <span class="mwtda-lp-shop__product-add"><i class="fa-solid fa-plus"></i> <%= t('home.apps.phone.add') %></span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="mwtda-lp-shop__checkout"><i class="fa-solid fa-lock"></i> <%= t('home.apps.phone.checkout') %></div>
          </div>
        </div>

        <div class="mwtda-lp-shop__notifications" aria-hidden="true">
          <% [%w[sale fa-solid fa-sack-dollar], %w[pix fa-solid fa-bolt], %w[cart fa-solid fa-cart-shopping]].each_with_index do |(key, *icon), i| %>
            <div class="mwtda-lp-shop__notification mwtda-lp-shop__notification--<%= key %>" style="--i: <%= i %>">
              <span class="mwtda-lp-shop__notification-icon"><i class="<%= icon.join(' ') %>"></i></span>
              <div>
                <strong><%= t("home.apps.notifications.#{key}_title") %></strong>
                <span><%= t("home.apps.notifications.#{key}_text") %></span>
              </div>
              <small><%= t('home.apps.notifications.now') %></small>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <section class="mwtda-lp-section mwtda-lp-cta" id="contato">
    <div class="mwtda-lp-section__inner mwtda-lp-cta__inner" data-reveal-self>
      <h2><%= t('home.cta.title') %></h2>
      <p><%= t('home.cta.text') %></p>
      <div class="mwtda-lp-hero__ctas">
        <a
          href="https://wa.me/5516991997608?text=<%= CGI.escape(t('home.cta.whatsapp_message')) %>"
          target="_blank"
          class="mwtda-lp-btn mwtda-lp-btn--primary mwtda-lp-btn--lg"
        >
          <i class="fa-brands fa-whatsapp"></i> <%= t('home.cta.whatsapp_button') %>
        </a>
        <%= link_to t('home.cta.entrar'), new_user_session_path, class: 'mwtda-lp-btn mwtda-lp-btn--outline mwtda-lp-btn--lg' %>
      </div>
    </div>
  </section>

  <footer class="mwtda-lp-footer">
    <div class="mwtda-lp-footer__inner">
      <div class="mwtda-lp-footer__brand">
        <%= image_tag 'admin/logonovo.png',
              class: 'mwtda-lp-footer__logo',
              alt: 'Mewtda',
              style: 'display:block !important; height:26px !important; width:auto !important; max-width:none !important; min-width:0 !important; max-height:none !important; min-height:0 !important; object-fit:contain !important; flex-shrink:0 !important; margin:0 !important; padding:0 !important;' %>
        <p><%= t('home.footer.description') %></p>
        <%= image_tag 'admin/shopifypartnerbadge_250.png',
              class: 'mwtda-lp-footer__badge',
              alt: t('home.footer.shopify_partner_alt'),
              style: 'display:block !important; height:56px !important; width:auto !important; max-width:none !important; min-width:0 !important; max-height:none !important; min-height:0 !important; object-fit:contain !important; flex-shrink:0 !important; margin:0 !important; padding:0 !important; opacity:0.9;' %>
      </div>

      <div class="mwtda-lp-footer__column">
        <span class="mwtda-lp-footer__title"><%= t('home.footer.solucoes_title') %></span>
        <% landing_products.each do |product| %>
          <a href="#<%= product[:anchor] %>">Mewtda <%= product[:name] %></a>
        <% end %>
      </div>

      <div class="mwtda-lp-footer__column">
        <span class="mwtda-lp-footer__title"><%= t('home.footer.contato_title') %></span>
        <a href="https://wa.me/5516991997608" target="_blank"><%= t('home.footer.whatsapp') %></a>
        <%= link_to t('home.footer.entrar'), new_user_session_path %>
      </div>
    </div>

    <div class="mwtda-lp-footer__bottom">
      &copy; <%= Date.today.year %> Mewtda
    </div>
  </footer>

</div>

<script>
  // ===================================================================
  // MEWTDA — efeitos de rolagem (JS puro, sem dependências)
  // -------------------------------------------------------------------
  // 2) escreve --mw-scroll-y na raiz .mwtda-lp pro parallax sutil do hero;
  // 3) alterna .is-visible em [data-reveal] / [data-reveal-self] via
  //    IntersectionObserver (fade + slide + blur escalonado);
  // 4) calcula o progresso de scroll da seção "Como funciona" e escreve
  //    --mw-progress (0 a 1) pra linha de progresso entre os 3 passos.
  // Pode virar app/javascript/landing/scroll_effects.js sem alterar
  // nada e ser importado no seu application.js / importmap.
  // ===================================================================
  document.addEventListener('DOMContentLoaded', function () {
    var root = document.querySelector('.mwtda-lp')
    var processGrid = document.querySelector('.mwtda-lp-process-grid')
    if (!root) return

    // --- 0: "portal" pra fora do layout do app -------------------------
    // Se essa view for renderizada dentro do layout padrão (com sidebar,
    // header fixo, etc.), qualquer ancestral entre <body> e .mwtda-lp que
    // tenha transform / filter / perspective / will-change / contain cria
    // um novo "containing block" — e nesse caso position:fixed passa a
    // ficar preso dentro daquele ancestral em vez de cobrir a viewport
    // inteira (era isso que deixava a página "de lado", encaixada ao lado
    // da sidebar). Mover o próprio elemento para ser filho direto do
    // <body> resolve isso na raiz, sem precisar tocar no layout do app.
    if (root.parentElement !== document.body) {
      document.body.appendChild(root)
    }

    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // --- quem realmente rola ------------------------------------------
    // `root` é position:fixed + overflow-y:auto (ver bloco acima) — é
    // ELE que dispara o evento `scroll`, a `window` NUNCA rola nesse
    // esquema. Todo o resto do script (parallax, progresso, controle
    // remoto) precisa escutar `root`, não `window`.
    var scroller = root

    // --- 2: var de parallax do hero, com throttle via rAF
    var ticking = false
    function onScroll() {
      if (ticking) return
      ticking = true
      requestAnimationFrame(function () {
        var y = root.scrollTop

        if (!prefersReducedMotion) {
          root.style.setProperty('--mw-scroll-y', (Math.min(y, 800) * -1) + 'px')
        }

        // --- 4: progresso do bloco "Como funciona" --------------------
        if (processGrid) {
          var rect = processGrid.getBoundingClientRect()
          var vh = window.innerHeight
          var start = vh * 0.85
          var end = vh * 0.35
          var total = rect.top - end
          var range = start - end
          var raw = 1 - total / range
          var progress = Math.min(1, Math.max(0, raw))

          processGrid.style.setProperty('--mw-progress', progress.toFixed(3))
          processGrid.toggleAttribute('data-progress-lit-1', progress > 0.05)
          processGrid.toggleAttribute('data-progress-lit-2', progress > 0.55)
          processGrid.toggleAttribute('data-progress-lit-3', progress > 0.95)
        }

        ticking = false
      })
    }

    scroller.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll, { passive: true })
    onScroll()

    // --- 3: reveal-on-scroll ------------------------------------------
    var revealTargets = document.querySelectorAll('[data-reveal], [data-reveal-self]')

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible')
            observer.unobserve(entry.target)
          }
        })
      },
      { threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
    )

    revealTargets.forEach(function (el) {
      observer.observe(el)
    })

    // --- 5: vitrine "Sua loja" — abas de segmento trocam a loja do celular
    // e o texto ao lado. Gira sozinha enquanto ninguém clica; o primeiro
    // clique assume o controle e para a rotação automática.
    var shop = document.querySelector('[data-shop-showcase]')
    if (shop) {
      var tabs = shop.querySelectorAll('[data-shop-tab]')
      var panels = shop.querySelectorAll('[data-shop-panel]')
      var keys = Array.prototype.map.call(tabs, function (tab) { return tab.getAttribute('data-shop-tab') })
      var current = 0
      var rotation = null

      function showSegment(index) {
        current = index
        var key = keys[index]
        tabs.forEach(function (tab) {
          tab.setAttribute('aria-selected', tab.getAttribute('data-shop-tab') === key ? 'true' : 'false')
        })
        panels.forEach(function (panel) {
          panel.setAttribute('data-active', panel.getAttribute('data-shop-panel') === key ? 'true' : 'false')
        })
      }

      tabs.forEach(function (tab, i) {
        tab.addEventListener('click', function () {
          if (rotation) clearInterval(rotation)
          rotation = null
          showSegment(i)
        })
      })

      if (!prefersReducedMotion) {
        rotation = setInterval(function () {
          showSegment((current + 1) % keys.length)
        }, 4500)
      }
    }

    // --- 6: controle remoto (menu fixo no canto) ------------------------
    // Teclas = canais (seções). Clique rola suave até a seção, CH ▲/▼
    // anda pela lista, o visor acompanha a seção que está no meio da tela
    // e o LED de infravermelho "pisca" a cada comando. Em tela estreita o
    // controle fica recolhido e abre/fecha pelo mini controle.
    var remote = document.querySelector('[data-remote]')
    if (remote) {
      var channels = JSON.parse(remote.getAttribute('data-remote-channels'))
      var toggle = remote.querySelector('[data-remote-toggle]')
      var chEl = remote.querySelector('[data-remote-ch]')
      var labelEl = remote.querySelector('[data-remote-label]')
      var screenEl = remote.querySelector('.mwtda-lp-remote__screen')
      var ir = remote.querySelector('[data-remote-ir]')
      var channelLinks = remote.querySelectorAll('[data-remote-channel]')
      var currentChannel = -1

      function pad(n) { return (n < 10 ? '0' : '') + n }

      function showChannel(index) {
        if (index === currentChannel) return
        currentChannel = index
        chEl.textContent = 'CH ' + pad(index + 1)
        labelEl.textContent = channels[index].label
        channelLinks.forEach(function (link) {
          var active = link.getAttribute('data-remote-channel') === channels[index].id
          if (active) link.setAttribute('aria-current', 'true')
          else link.removeAttribute('aria-current')
        })
        screenEl.classList.remove('is-changing')
        void screenEl.offsetWidth // reinicia a animação do visor
        screenEl.classList.add('is-changing')
      }

      function blink() {
        ir.classList.remove('is-sending')
        void ir.offsetWidth
        ir.classList.add('is-sending')
      }

      function setOpen(open) {
        remote.classList.toggle('is-open', open)
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false')
      }

      // troca de canal na tela: reinicia as animações do overlay a cada
      // clique (remove a classe, força reflow, põe de volta)
      var zap = document.querySelector('[data-remote-zap]')
      var zapCh = zap && zap.querySelector('[data-zap-ch]')
      var zapLabel = zap && zap.querySelector('[data-zap-label]')
      var zapTimer = null

      function zapTo(index) {
        if (!zap) return
        zapCh.textContent = 'CH ' + pad(index + 1)
        zapLabel.textContent = channels[index].label
        zap.classList.remove('is-zapping')
        void zap.offsetWidth
        zap.classList.add('is-zapping')
        clearTimeout(zapTimer)
        zapTimer = setTimeout(function () { zap.classList.remove('is-zapping') }, 1900)
      }

      function goTo(index) {
        var target = document.getElementById(channels[index].id)
        if (!target) return
        blink()
        zapTo(index)
        showChannel(index)
        target.scrollIntoView({ behavior: prefersReducedMotion ? 'auto' : 'smooth', block: 'start' })
        setOpen(false)
      }

      channelLinks.forEach(function (link) {
        link.addEventListener('click', function (e) {
          e.preventDefault()
          var id = link.getAttribute('data-remote-channel')
          goTo(channels.findIndex(function (c) { return c.id === id }))
        })
      })

      remote.querySelectorAll('[data-remote-step]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var step = parseInt(btn.getAttribute('data-remote-step'), 10)
          goTo(Math.min(channels.length - 1, Math.max(0, currentChannel + step)))
        })
      })

      toggle.addEventListener('click', function () {
        setOpen(!remote.classList.contains('is-open'))
      })

      // no mobile, tocar fora do controle aberto fecha ele
      document.addEventListener('click', function (e) {
        if (remote.classList.contains('is-open') && !remote.contains(e.target)) setOpen(false)
      })

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && remote.classList.contains('is-open')) {
          setOpen(false)
          toggle.focus()
        }
      })

      // visor acompanha a seção que cruza o meio da tela
      var sectionObserver = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return
          var index = channels.findIndex(function (c) { return c.id === entry.target.id })
          if (index >= 0) showChannel(index)
        })
      }, { rootMargin: '-45% 0px -50% 0px' })

      channels.forEach(function (c) {
        var section = document.getElementById(c.id)
        if (section) sectionObserver.observe(section)
      })
    }
  })
</script>

<script type="module">
  // ===================================================================
  // MEWTDA — logo animado em Three.js (barras tipo equalizador "ondulando")
  // -------------------------------------------------------------------
  // Recria o wordmark "mewtda" (textura de canvas 2D com o mesmo gradiente
  // azul da marca) + as 6 barras coloridas do logo, só que em WebGL, com
  // cada barra oscilando em altura (senoide com fase própria) pra dar o
  // efeito de onda de áudio mexendo. Câmera ortográfica pra não ter
  // distorção de perspectiva — a intenção é parecer um logo "vivo", não
  // uma cena 3D.
  // ===================================================================
  document.addEventListener('DOMContentLoaded', async function () {
    var container = document.querySelector('[data-mwtda-wave-logo]')
    var canvas = container && container.querySelector('.mwtda-lp-hero__logo3d-canvas')
    if (!container || !canvas) return

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // Espera a fonte da marca carregar ANTES de montar a cena: o texto vira
    // textura uma única vez, com a métrica final — evita ter que trocar a
    // textura (e a geometria já ter sido montada com outro tamanho) depois.
    if (document.fonts && document.fonts.ready) {
      try { await document.fonts.ready } catch (e) {}
    }

    var THREE
    try {
      THREE = await import('https://unpkg.com/three@0.160.0/build/three.module.js')
    } catch (e) {
      return // sem THREE, fica só o fallback estático (background-image do CSS)
    }

    var renderer
    try {
      renderer = new THREE.WebGLRenderer({ canvas: canvas, alpha: true, antialias: true })
    } catch (e) {
      return // sem WebGL, idem — fallback estático cobre
    }
    renderer.setClearColor(0x000000, 0)

    // WebGL deu certo: tira o fallback estático (background-image do CSS)
    // pra não ficar sobreposto/"fantasma" atrás do canvas transparente.
    container.style.backgroundImage = 'none'

    var scene = new THREE.Scene()
    var camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0.1, 10)
    camera.position.z = 5

    // --- wordmark "mewtda" via textura de canvas 2D --------------------
    // Mede o texto de verdade (measureText) em vez de chutar um aspect
    // ratio fixo pro canvas — assim a largura do plano bate exatamente
    // com os glifos desenhados, sem sobra transparente que bagunça o
    // posicionamento das barras ao lado.
    var WORDMARK_FONT_PX = 220
    var WORDMARK_FONT = "800 " + WORDMARK_FONT_PX + "px 'Space Grotesk', ui-sans-serif, system-ui, sans-serif"
    var WORDMARK_PAD = WORDMARK_FONT_PX * 0.12

    function makeWordmarkTexture () {
      var probe = document.createElement('canvas').getContext('2d')
      probe.font = WORDMARK_FONT
      var metrics = probe.measureText('mewtda')
      var textWidth = metrics.width
      var ascent = metrics.actualBoundingBoxAscent || WORDMARK_FONT_PX * 0.72
      var descent = metrics.actualBoundingBoxDescent || WORDMARK_FONT_PX * 0.22

      var c = document.createElement('canvas')
      c.width = Math.ceil(textWidth + WORDMARK_PAD * 2)
      c.height = Math.ceil(ascent + descent + WORDMARK_PAD * 2)
      var ctx = c.getContext('2d')
      ctx.font = WORDMARK_FONT
      ctx.textBaseline = 'alphabetic'
      ctx.textAlign = 'left'
      var grad = ctx.createLinearGradient(0, 0, c.width, 0)
      grad.addColorStop(0, '#22b6ff')
      grad.addColorStop(1, '#1d4ed8')
      ctx.fillStyle = grad
      ctx.fillText('mewtda', WORDMARK_PAD, WORDMARK_PAD + ascent)
      var texture = new THREE.CanvasTexture(c)
      texture.colorSpace = THREE.SRGBColorSpace
      texture.needsUpdate = true
      return { texture: texture, aspect: c.width / c.height }
    }

    // --- barras (equalizador) ------------------------------------------
    var bars = [
      { color: 0x7c3aed, base: 0.50, speed: 1.6, phase: 0.0 },
      { color: 0xd946ef, base: 0.30, speed: 2.1, phase: 1.1 },
      { color: 0xfb7115, base: 0.88, speed: 1.3, phase: 2.4 },
      { color: 0xf5b301, base: 0.42, speed: 2.4, phase: 0.6 },
      { color: 0x22c55e, base: 0.66, speed: 1.8, phase: 3.3 },
      { color: 0x14e0a4, base: 0.34, speed: 2.0, phase: 4.2 }
    ]
    var barWidth = 0.085
    var barGap = 0.045
    var barsTotalWidth = bars.length * barWidth + (bars.length - 1) * barGap
    var maxBase = Math.max.apply(null, bars.map(function (b) { return b.base }))

    // --- layout: wordmark + gap + barras, tudo centralizado no eixo X --
    var wordmark = makeWordmarkTexture()
    var wordmarkHeight = 0.62
    var wordmarkWidth = wordmarkHeight * wordmark.aspect
    var groupGap = 0.22
    var totalWidth = wordmarkWidth + groupGap + barsTotalWidth
    var layoutStartX = -totalWidth / 2

    var wordmarkMesh = new THREE.Mesh(
      new THREE.PlaneGeometry(wordmarkWidth, wordmarkHeight),
      new THREE.MeshBasicMaterial({ map: wordmark.texture, transparent: true })
    )
    wordmarkMesh.position.x = layoutStartX + wordmarkWidth / 2
    scene.add(wordmarkMesh)

    var barsStartX = layoutStartX + wordmarkWidth + groupGap + barWidth / 2

    bars.forEach(function (bar, i) {
      var geometry = new THREE.BoxGeometry(barWidth, 1, 0.06)
      var material = new THREE.MeshBasicMaterial({ color: bar.color })
      var mesh = new THREE.Mesh(geometry, material)
      mesh.position.x = barsStartX + i * (barWidth + barGap)
      bar.mesh = mesh
      scene.add(mesh)
    })

    function layout () {
      var width = container.clientWidth || 1
      var height = container.clientHeight || 1
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2))
      renderer.setSize(width, height, false)

      // ortográfica: mundo visível vai de -viewHalf a +viewHalf no eixo
      // menor, escalado pelo aspect ratio do container.
      var aspect = width / height
      var viewHalf = 0.85
      if (aspect >= 1) {
        camera.left = -viewHalf * aspect
        camera.right = viewHalf * aspect
        camera.top = viewHalf
        camera.bottom = -viewHalf
      } else {
        camera.left = -viewHalf
        camera.right = viewHalf
        camera.top = viewHalf / aspect
        camera.bottom = -viewHalf / aspect
      }
      camera.updateProjectionMatrix()
    }

    function renderBars (t) {
      bars.forEach(function (bar) {
        var wave = 0.55 + 0.45 * (0.5 + 0.5 * Math.sin(t * bar.speed + bar.phase))
        var h = Math.max(0.06, bar.base * wave)
        bar.mesh.scale.y = h
        bar.mesh.position.y = h / 2 - maxBase / 2
      })
    }

    layout()
    renderBars(0)
    renderer.render(scene, camera)

    window.addEventListener('resize', layout, { passive: true })

    if (reduceMotion) return // fica parado num frame só, sem loop de animação

    function tick (now) {
      renderBars((now || 0) / 1000)
      renderer.render(scene, camera)
      requestAnimationFrame(tick)
    }
    requestAnimationFrame(tick)
  })
</script>
