<% title 'Mewtda — CRM para lojas Shopify' %>

<%#
  =====================================================================
  MEWTDA — Landing Page
  ---------------------------------------------------------------------
  1) CSS     → app/assets/stylesheets/pages/landing.scss (required por
     admin.scss, entra no precompile normal do Sprockets).
  2) markup  → classes mwtda-lp-*, com atributos data-reveal /
     data-reveal-self nos pontos onde entra efeito de rolagem.
  3) <script> → JS puro (sem dependência nenhuma) com os 4 efeitos de
     scroll: nav com fundo ao rolar, parallax sutil no hero, reveal
     em cascata nos cards (fade + slide + blur) via IntersectionObserver,
     e uma barra de progresso que "acende" os 3 passos de "Como
     funciona" conforme você rola. Pode virar
     app/javascript/landing/scroll_effects.js e ser importado no seu
     application.js / importmap.
  =====================================================================
%>

<% content_for :head do %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap">
<% end %>

<div class="mwtda-lp">

  <nav class="mwtda-lp-nav">
    <div class="mwtda-lp-nav__inner">
      <%= image_tag 'admin/logonovo.png',
            class: 'mwtda-lp-nav__logo',
            alt: 'Mewtda',
            style: 'display:block !important; height:42px !important; width:auto !important; max-width:none !important; min-width:0 !important; max-height:none !important; min-height:0 !important; object-fit:contain !important; flex-shrink:0 !important; margin:0 !important; padding:0 !important;' %>
      <div class="mwtda-lp-nav__links">
        <a href="#recursos">Recursos</a>
        <a href="#automacoes">Automações</a>
        <a href="#integracoes">Integrações</a>
        <a href="#ecommerce">Sua Loja</a>
        <a href="#planos">Planos</a>
      </div>
      <%= link_to 'Entrar', new_user_session_path, class: 'mwtda-lp-btn mwtda-lp-btn--primary mwtda-lp-nav__cta' %>
