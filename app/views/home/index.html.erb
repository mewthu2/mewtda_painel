      <a href="#ecommerce" data-mobile-menu-link>Sua Loja</a>
      <a href="#planos" data-mobile-menu-link>Planos</a>
    </nav>
    <%= link_to 'Entrar', new_user_session_path, class: 'mwtda-lp-btn mwtda-lp-btn--primary mwtda-lp-btn--lg mwtda-lp-mobile-menu__cta', data: { 'mobile-menu-link': true } %>
