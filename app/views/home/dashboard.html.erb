<% title 'Início' %>

<div class="home-dash">
  <h1 class="home-dash__greeting">Olá, <%= current_user.name %></h1>

  <% if @empty_state %>
    <div class="crm-card home-dash__empty">
      <p><%= @empty_message %></p>
    </div>
  <% else %>
    <p class="home-dash__subtitle">
      Uma prévia do seu novo Dashboard de Vendas — acompanhe o mês em tempo real.
    </p>

    <div class="home-dash__grid">
      <div class="crm-kpi-card home-dash__card">
        <div class="crm-kpi-card__label">Faturamento</div>
        <div class="crm-kpi-card__value"><%= currency(@metrics[:revenue]) %></div>
        <% if @sales[:has_data] %>
          <div id="home-revenue-chart" class="home-dash__chart"></div>
        <% else %>
          <p class="home-dash__chart-empty">Assim que suas vendas começarem a chegar, esse gráfico ganha vida.</p>
        <% end %>
      </div>

      <div class="crm-kpi-card home-dash__card">
        <div class="crm-kpi-card__label">Pedidos</div>
        <div class="crm-kpi-card__value"><%= @metrics[:orders_count] %></div>
        <% if @sales[:has_data] %>
          <div id="home-orders-chart" class="home-dash__chart"></div>
        <% else %>
          <p class="home-dash__chart-empty">Assim que suas vendas começarem a chegar, esse gráfico ganha vida.</p>
        <% end %>
      </div>

      <div class="crm-kpi-card home-dash__card">
        <div class="crm-kpi-card__label">Ticket Médio</div>
        <div class="crm-kpi-card__value"><%= @metrics[:avg_ticket] ? currency(@metrics[:avg_ticket]) : '—' %></div>
        <% if @sales[:has_data] %>
          <div id="home-ticket-chart" class="home-dash__chart"></div>
        <% else %>
          <p class="home-dash__chart-empty">Assim que suas vendas começarem a chegar, esse gráfico ganha vida.</p>
        <% end %>
      </div>
    </div>

    <%= link_to 'Ver dashboard completo', sales_dashboard_path, class: 'crm-btn crm-btn--primary home-dash__cta' %>
  <% end %>
</div>

<% if @sales && @sales[:has_data] %>
<script>
document.addEventListener("DOMContentLoaded", function () {
  var root = document.documentElement;
  var isDark = root.classList.contains('theme-dark');
  var style = getComputedStyle(root);
  var primary = style.getPropertyValue('--primary').trim();
  var gridColor = style.getPropertyValue('--outline').trim();
  var tooltipTheme = isDark ? 'dark' : 'light';

  var days = <%= raw @sales[:days].to_json %>;
  var revenue = <%= raw @sales[:revenue_by_day].to_json %>;
  var orders = <%= raw @sales[:orders_by_day].to_json %>;
  var avgTicket = <%= raw @sales[:avg_ticket_by_day].map { |v| v || 0 }.to_json %>;

  var baseChart = {
    chart: { toolbar: { show: false }, fontFamily: 'inherit', height: 100, sparkline: { enabled: true } },
    xaxis: { categories: days },
    colors: [primary],
    grid: { borderColor: gridColor },
    tooltip: { theme: tooltipTheme, x: { formatter: function (day) { return 'Dia ' + day; } } }
  };

  new ApexCharts(document.querySelector("#home-revenue-chart"), Object.assign({}, baseChart, {
    chart: Object.assign({}, baseChart.chart, { type: 'area' }),
    series: [{ name: 'Faturamento', data: revenue }],
    stroke: { width: 2, curve: 'smooth' },
    fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.3, opacityTo: 0.05 } },
    tooltip: Object.assign({}, baseChart.tooltip, { y: { formatter: function (v) { return 'R$ ' + v.toFixed(2).replace('.', ','); } } })
  })).render();

  new ApexCharts(document.querySelector("#home-orders-chart"), Object.assign({}, baseChart, {
    chart: Object.assign({}, baseChart.chart, { type: 'bar' }),
    series: [{ name: 'Pedidos', data: orders }],
    plotOptions: { bar: { borderRadius: 3, columnWidth: '60%' } }
  })).render();

  new ApexCharts(document.querySelector("#home-ticket-chart"), Object.assign({}, baseChart, {
    chart: Object.assign({}, baseChart.chart, { type: 'line' }),
    series: [{ name: 'Ticket Médio', data: avgTicket }],
    stroke: { width: 2, curve: 'smooth' },
    tooltip: Object.assign({}, baseChart.tooltip, { y: { formatter: function (v) { return 'R$ ' + v.toFixed(2).replace('.', ','); } } })
  })).render();
});
</script>
<% end %>
