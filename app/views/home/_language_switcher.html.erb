<%
  locales = { 'pt-BR' => 'PT', 'en' => 'EN', 'es' => 'ES' }
%>
<div class="mwtda-lp-lang <%= wrapper_class %>" role="group" aria-label="<%= t('home.nav.language_switcher_label') %>">
  <% locales.each do |code, label| %>
    <%
      # data-turbo="false": troca de idioma é mesmo path (/) só com query
      # string diferente — o Turbo Drive trataria isso como visita interna
      # (troca só o <body>) e o DOMContentLoaded dos scripts da página
      # (logo 3D, controle remoto, vitrine do celular) não rodaria de novo. Forçando
      # reload completo garante que tudo reinicializa certo.
    %>
    <%# url_for mantém a página atual (home ou página de produto), só troca o locale %>
    <%= link_to label, url_for(locale: code),
          class: "mwtda-lp-lang__option #{'is-active' if I18n.locale.to_s == code}",
          data: { turbo: false } %>
  <% end %>
</div>
