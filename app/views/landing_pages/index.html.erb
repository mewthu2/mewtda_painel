<% title 'Landing Pages' %>

<div class="clients-wrapper">
  <div class="clients-table-wrap">
    <div class="clients-table-header">
      <span class="clients-table-header__title">
        <i class="fa-solid fa-rocket crm-fa"></i>
        Landing Pages<%= " — #{current_client.name}" if current_client %>
      </span>
      <%= link_to new_landing_page_path, class: 'crm-btn clients-btn--success' do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Nova landing page
      <% end %>
    </div>

    <% unless current_client.storefront_configured? %>
      <div class="cform-alert cform-alert--warning" style="margin: 12px 16px;">
        <span>Configure o token da Storefront API da Shopify nas configurações do cliente para as páginas mostrarem produtos.</span>
      </div>
    <% end %>

    <table class="crm-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Link</th>
          <th class="text-center">Status</th>
          <th class="text-center">Visitas</th>
          <th class="text-center">Leads</th>
          <th class="text-center">Pedidos</th>
          <th class="text-end">Faturamento</th>
          <th class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @landing_pages.each do |landing_page| %>
          <tr>
            <td><%= link_to landing_page.name, landing_page_path(landing_page) %></td>
            <td><%= link_to landing_page.public_path, landing_page.public_path, target: '_blank', rel: 'noopener' %></td>
            <td class="text-center">
              <% if !landing_page.active? %>
                <span class="crm-tag crm-tag--neutral">Inativa</span>
              <% elsif !landing_page.sales_open? %>
                <span class="crm-tag crm-tag--warning">Vendas encerradas</span>
              <% else %>
                <span class="crm-tag crm-tag--success">No ar</span>
              <% end %>
            </td>
            <td class="text-center"><%= number_with_delimiter(landing_page.views_count, delimiter: '.') %></td>
            <td class="text-center"><%= @leads_count[landing_page.id] || 0 %></td>
            <td class="text-center"><%= @orders_count[landing_page.id] || 0 %></td>
            <td class="text-end"><%= number_to_currency(@orders_revenue[landing_page.id] || 0, unit: 'R$ ', separator: ',', delimiter: '.') %></td>
            <td class="text-center">
              <div class="clients-table__actions">
                <%= link_to edit_landing_page_path(landing_page), class: 'crm-btn clients-btn--icon', title: 'Editar' do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" />
                  </svg>
                <% end %>
                <%= button_to landing_page_path(landing_page), method: :delete,
                    class: 'crm-btn clients-btn--icon clients-btn--danger', title: 'Excluir',
                    form: { onsubmit: "return confirm('Excluir a landing page #{j landing_page.name}? Leads cadastrados nela também serão apagados.');" } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                  </svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @landing_pages.empty? %>
          <tr>
            <td colspan="8" class="clients-table__empty">
              Nenhuma landing page ainda. <%= link_to 'Criar a primeira', new_landing_page_path %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
