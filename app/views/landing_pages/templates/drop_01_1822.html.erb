<script>
  // Animações da página: revelar ao entrar na tela, efeitos ligados à rolagem
  // (hero, bloco azul, texto palavra a palavra) e a faixa corrida.
  (function () {
    var root = document.documentElement;
    if (!root.classList.contains('motion')) return;

    var reveals = document.querySelectorAll('[data-reveal]');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) { entry.target.classList.add('is-in'); io.unobserve(entry.target); }
        });
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
      reveals.forEach(function (el) { io.observe(el); });
    } else {
      reveals.forEach(function (el) { el.classList.add('is-in'); });
    }

    var scrubs = Array.prototype.slice.call(document.querySelectorAll('[data-scrub]'));
    var words = Array.prototype.map.call(document.querySelectorAll('[data-words]'), function (box) {
      return { box: box, items: box.querySelectorAll('.w') };
    });
    var marquee = document.querySelector('[data-marquee] .marquee__track');
    var chain = document.querySelector('[data-chain]');
    var chainParts = chain && {
      left: chain.querySelector('[data-chain-left]'),
      right: chain.querySelector('[data-chain-right]'),
      frags: Array.prototype.map.call(chain.querySelectorAll('.chain__frag'), function (el) {
        var v = el.dataset.v.split(',').map(parseFloat);
        return { el: el, dx: v[0], dy: v[1], rot: v[2] };
      }),
      copy: chain.querySelector('[data-chain-copy]'),
      hint: chain.querySelector('[data-chain-hint]'),
      flash: chain.querySelector('[data-chain-flash]'),
      broken: false
    };
    var easeOut = function (x) { return 1 - Math.pow(1 - x, 3); };
    var maxChainP = 0;

    // p: 0 → 0.24 estica e treme; 0.24 → 0.3 rompe; depois as metades caem e a frase aparece.
    function updateChain(vh) {
      var r = chain.getBoundingClientRect();
      var span = r.height - vh;
      if (span <= 0 || r.bottom < -vh || r.top > vh * 2) return false;
      var p = clamp(-r.top / span);
      // Depois de romper, não se refaz: rolar de volta mantém a corrente rompida.
      if (chainParts.broken) { maxChainP = Math.max(maxChainP, p); p = maxChainP; }
      var t = clamp(p / 0.24);
      var b = clamp((p - 0.24) / 0.06);
      var f = clamp((p - 0.27) / 0.4);
      var straining = t > 0.25 && b === 0 && r.top <= 0;
      var shake = straining ? Math.sin(performance.now() / 16) * t * t * 3.5 : 0;
      var pull = t * 9;
      var fx = easeOut(f) * 760, fy = f * f * 420, rot = easeOut(f) * 32;

      chainParts.left.setAttribute('transform',
        'translate(' + (-pull - fx + shake).toFixed(2) + ' ' + (fy + shake * 0.4).toFixed(2) + ') rotate(' + (-rot).toFixed(2) + ' 600 150)');
      chainParts.right.setAttribute('transform',
        'translate(' + (pull + fx - shake).toFixed(2) + ' ' + (fy - shake * 0.4).toFixed(2) + ') rotate(' + rot.toFixed(2) + ' 600 150)');
      chain.classList.toggle('is-strained', t > 0.55);

      var burst = easeOut(clamp((p - 0.24) / 0.3));
      chainParts.frags.forEach(function (frag) {
        var x = 600 + frag.dx * burst * 260;
        var y = 150 + frag.dy * burst * 170 + burst * burst * 140;
        frag.el.setAttribute('transform', 'translate(' + x.toFixed(1) + ' ' + y.toFixed(1) + ') rotate(' + (frag.rot * burst).toFixed(1) + ')');
        frag.el.style.opacity = b > 0 ? (1 - clamp((p - 0.42) / 0.25)).toFixed(3) : 0;
      });

      chainParts.flash.style.opacity = b > 0 && b < 1 ? (Math.sin(b * Math.PI) * 0.9).toFixed(3) : 0;
      var c = clamp((p - 0.3) / 0.22);
      chainParts.copy.style.opacity = c.toFixed(3);
      chainParts.copy.style.transform = 'scale(' + (0.9 + 0.1 * easeOut(c)).toFixed(4) + ')';
      chainParts.hint.style.opacity = (1 - clamp(p / 0.08)).toFixed(3);

      if (!chainParts.broken && b > 0.5) {
        chainParts.broken = true;
        maxChainP = p;
        if (navigator.vibrate) { try { navigator.vibrate(30); } catch (e) {} }
        if (window.lpBreakBadge) window.lpBreakBadge.broke();
      }
      return straining;
    }
    var clamp = function (v) { return Math.max(0, Math.min(1, v)); };
    var lastY = window.scrollY, velocity = 0, offset = 0, ticking = false;

    function update() {
      ticking = false;
      var vh = window.innerHeight;
      scrubs.forEach(function (el) {
        var r = el.getBoundingClientRect();
        var p = el.dataset.scrub === 'exit' ? clamp(-r.top / r.height) : clamp((vh - r.top) / (vh + r.height));
        el.style.setProperty('--p', p.toFixed(4));
      });
      var keepShaking = chain && !root.classList.contains('chain-done') ? updateChain(vh) : false;
      words.forEach(function (w) {
        var r = w.box.getBoundingClientRect();
        var p = clamp((vh * 0.85 - r.top) / (r.height + vh * 0.35));
        var lit = Math.round(p * w.items.length * 1.08);
        for (var i = 0; i < w.items.length; i++) w.items[i].classList.toggle('on', i < lit);
      });
      // Enquanto a corrente está tensionada, segue tremendo mesmo com a rolagem parada.
      if (keepShaking && !ticking) { ticking = true; requestAnimationFrame(update); }
    }
    function onScroll() {
      var y = window.scrollY;
      velocity = Math.min(40, Math.abs(y - lastY));
      lastY = y;
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();

    if (marquee) {
      var visible = true;
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (e) { visible = e[0].isIntersecting; }).observe(marquee.parentNode);
      }
      (function loop() {
        if (visible) {
          var half = marquee.scrollWidth / 2;
          offset -= 0.6 + velocity * 0.35;
          if (half && -offset >= half) offset += half;
          marquee.style.transform = 'translate3d(' + offset.toFixed(2) + 'px,0,0)';
        }
        velocity *= 0.92;
        requestAnimationFrame(loop);
      })();
    }
  })();
</script>

<script>
  // Abas do drop: clique ou setas trocam o painel visível.
  (function () {
    var list = document.querySelector('[data-tabs]');
    if (!list) return;
    var tabs = Array.prototype.slice.call(list.querySelectorAll('[role="tab"]'));
    function select(tab, focus) {
      tabs.forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
      });
      jumps.forEach(function (j, i) {
        var on = j.getAttribute('data-print-jump') === tab.id;
        j.setAttribute('aria-current', on ? 'true' : 'false');
        if (!on) return;
        // doca do celular: cursor desliza até a estampa e a etiqueta vira
        nav.style.setProperty('--active', i);
        if (navName && navName.textContent !== j.getAttribute('data-print-name')) {
          navTag.classList.remove('is-flipping'); void navTag.offsetWidth; navTag.classList.add('is-flipping');
          setTimeout(function () { navName.textContent = j.getAttribute('data-print-name'); }, 200);
        }
      });
      if (focus) tab.focus();
    }

    // Navegação rápida das estampas: trilho no canto esquerdo (desktop) ou
    // doca no canto inferior direito (celular). Escolhe a estampa e leva até
    // ela, com o "carimbo" na miniatura. Só aparece depois que a corrente rompe
    // (evento do selo) e fora do topo — no celular inclusive durante a compra.
    var nav = document.querySelector('[data-printnav]');
    var jumps = nav ? Array.prototype.slice.call(nav.querySelectorAll('[data-print-jump]')) : [];
    var navTag = nav && nav.querySelector('.printnav__tag');
    // etiqueta "Estampa · X" (celular): leva pra camiseta da estampa escolhida
    if (navTag) navTag.addEventListener('click', function () {
      var active = document.querySelector('[data-tabs] [aria-selected="true"]');
      if (active && stacked()) showPanel(active); else drop.scrollIntoView();
    });
    var navName = nav && nav.querySelector('[data-printnav-name]');
    var drop = document.getElementById('comprar');
    // No toque (celular) a troca acontece no pointerup, sem esperar o "click" que
    // alguns navegadores de celular seguram ou descartam (ex.: com a página rolando).
    // Se o dedo arrastar, vem pointercancel e nada muda. O click que vem depois do
    // toque é ignorado; mouse e teclado seguem pelo click.
    var lastTouchJump = 0;
    function jumpTo(j) {
      j.classList.remove('is-stamped'); void j.offsetWidth; j.classList.add('is-stamped');
      if (navigator.vibrate) { try { navigator.vibrate(12); } catch (e) {} }
      var tab = document.getElementById(j.getAttribute('data-print-jump'));
      select(tab);
      if (stacked()) showPanel(tab); else drop.scrollIntoView();
    }
    jumps.forEach(function (j) {
      j.addEventListener('pointerup', function (e) {
        if (e.pointerType === 'mouse') return;
        lastTouchJump = Date.now();
        jumpTo(j);
      });
      j.addEventListener('click', function () {
        if (Date.now() - lastTouchJump < 700) return;
        jumpTo(j);
      });
      j.addEventListener('animationend', function (e) { if (e.target === j) j.classList.remove('is-stamped'); });
    });
    var unlocked = document.documentElement.classList.contains('chain-broken');
    if (nav && 'IntersectionObserver' in window) {
      var heroVisible = true, greeted = false;
      var place = function () {
        var on = unlocked && !heroVisible;
        nav.classList.toggle('is-visible', on);
        // primeira aparição: pulso amarelo pra mostrar que dá pra trocar por ali
        if (on && !greeted) { greeted = true; nav.classList.add('is-hello'); }
      };
      nav.addEventListener('animationend', function (e) { if (e.target === nav) nav.classList.remove('is-hello'); });
      document.addEventListener('lp:chain-broken', function () { unlocked = true; place(); });
      new IntersectionObserver(function (e) { heroVisible = e[0].isIntersecting; place(); }).observe(document.querySelector('.hero'));
      window.addEventListener('resize', place);
    } else if (nav) {
      document.addEventListener('lp:chain-broken', function () { nav.classList.add('is-visible'); });
    }
    // Abaixo de 1024px a camiseta fica embaixo das abas: escolher uma estampa
    // rola direto pro começo dela ("Drop 01" / "Coleção 1822").
    function stacked() { return window.innerWidth < 1024; }
    function showPanel(tab) { document.getElementById(tab.getAttribute('aria-controls')).scrollIntoView({ block: 'start' }); }
    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () {
        select(tab);
        if (stacked()) showPanel(tab);
      });
      tab.addEventListener('keydown', function (e) {
        var step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
        if (!step) return;
        e.preventDefault();
        select(tabs[(i + step + tabs.length) % tabs.length], true);
      });
    });
  })();
</script>

<script>
  // Tabela de medidas: o link acima do botão de compra abre o modal; fecha no
  // X, no Esc (nativo do <dialog>) ou clicando fora.
  (function () {
    var dialog = document.querySelector('[data-sizes]');
    if (!dialog || typeof dialog.showModal !== 'function') return;
    document.querySelectorAll('[data-lp-size-chart]').forEach(function (link) {
      link.addEventListener('click', function () { dialog.showModal(); });
    });
    dialog.querySelector('[data-sizes-close]').addEventListener('click', function () { dialog.close(); });
    dialog.addEventListener('click', function (e) { if (e.target === dialog) dialog.close(); });
  })();
</script>

<script>
  // Contagem regressiva pro 2º turno.
  (function () {
    var box = document.querySelector('[data-countdown]');
    if (!box) return;
    var target = new Date(box.dataset.countdown).getTime();
    var hideAfter = new Date(box.dataset.hideAfter).getTime();
    var units = box.querySelector('.countdown__units');
    var label = box.querySelector('[data-countdown-label]');
    var el = {};
    ['dias', 'horas', 'min', 'seg'].forEach(function (u) { el[u] = box.querySelector('[data-countdown-' + u + ']'); });
    var pad = function (n) { return (n < 10 ? '0' : '') + n; };
    function tick() {
      var now = Date.now();
      if (now >= hideAfter) { box.hidden = true; return; }
      var left = Math.max(0, Math.floor((target - now) / 1000));
      if (left === 0) {
        label.textContent = 'O segundo turno é hoje.';
        units.hidden = true;
        return;
      }
      el.dias.textContent = pad(Math.floor(left / 86400));
      el.horas.textContent = pad(Math.floor(left % 86400 / 3600));
      el.min.textContent = pad(Math.floor(left % 3600 / 60));
      el.seg.textContent = pad(left % 60);
      setTimeout(tick, 1000 - (now % 1000));
    }
    tick();
  })();
</script>

<% share_url = request.base_url + @landing_page.public_path + '?utm_source=compartilhar&utm_medium=corrente' %>
<div class="breakbadge" data-breakbadge
     data-break-url="<%= public_landing_page_break_path(@landing_page.path_prefix, @landing_page.slug) %>"
     data-count="<%= @landing_page.chain_breaks_count %>" data-share-url="<%= share_url %>"
     data-share-title="1822 · Independência se veste." data-share-text="Ajude a romper essa corrente.">
  <button type="button" class="breakbadge__toggle" data-breakbadge-toggle aria-expanded="false" aria-controls="breakbadge-panel"
          aria-label="Pessoas que já romperam a corrente">
    <svg class="breakbadge__icon" viewBox="0 0 68 40" aria-hidden="true">
      <path d="M 26 8 A 16 12 0 0 0 26 32"/>
      <rect x="0" y="17" width="18" height="6" rx="3"/>
      <path d="M 42 8 A 16 12 0 0 1 42 32"/>
      <rect x="50" y="17" width="18" height="6" rx="3"/>
    </svg>
    <span data-breakbadge-count><%= number_with_delimiter(@landing_page.chain_breaks_count, delimiter: '.') %></span>
  </button>
  <div class="breakbadge__panel" id="breakbadge-panel" role="dialog" aria-label="Romper a corrente">
    <p><strong data-breakbadge-count><%= number_with_delimiter(@landing_page.chain_breaks_count, delimiter: '.') %></strong> pessoas já romperam a corrente.</p>
    <button type="button" class="breakbadge__share" data-breakbadge-share>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/></svg>
      Ajude a romper essa corrente
    </button>
    <span class="breakbadge__toast" data-breakbadge-toast role="status">Link copiado</span>
  </div>
</div>
<script>
  // Selo "X já romperam a corrente": aparece quando a pessoa rompe (ou se já
  // rompeu antes neste navegador), registra no servidor e compartilha a página.
  (function () {
    var el = document.querySelector('[data-breakbadge]');
    if (!el) return;
    var root = document.documentElement;
    var key = 'lp_broke_<%= @landing_page.id %>';
    var countEls = el.querySelectorAll('[data-breakbadge-count]');
    var toggle = el.querySelector('[data-breakbadge-toggle]');
    var toast = el.querySelector('[data-breakbadge-toast]');
    var fmt = new Intl.NumberFormat('pt-BR');
    var shown = false;

    function show() {
      if (shown) return;
      shown = true;
      el.classList.add('is-visible');
      // Libera o que espera a corrente romper (ex.: navegação das estampas).
      root.classList.add('chain-broken');
      document.dispatchEvent(new Event('lp:chain-broken'));
    }

    function animateTo(target) {
      var from = parseInt(el.dataset.count, 10) || 0;
      el.dataset.count = target;
      var start = performance.now();
      (function step(now) {
        var k = Math.min(1, (now - start) / 900);
        var text = fmt.format(Math.round(from + (target - from) * (1 - Math.pow(1 - k, 3))));
        countEls.forEach(function (c) { c.textContent = text; });
        if (k < 1) requestAnimationFrame(step);
      })(start);
    }

    window.lpBreakBadge = {
      broke: function () {
        try { localStorage.setItem(key, '1'); } catch (e) {}
        show();
        toggle.classList.add('is-pulsing');
        animateTo((parseInt(el.dataset.count, 10) || 0) + 1);
        fetch(el.dataset.breakUrl, { method: 'POST', headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (json) { if (typeof json.count === 'number') animateTo(json.count); })
          .catch(function () {});
      }
    };

    if (root.classList.contains('chain-done')) {
      show();
    } else if (!root.classList.contains('motion') && 'IntersectionObserver' in window) {
      // Sem animação a corrente não "rompe": mostra o selo quando a frase aparece, sem contar.
      var chain = document.querySelector('[data-chain]');
      if (chain) new IntersectionObserver(function (e, io) {
        if (e[0].isIntersecting) { show(); io.disconnect(); }
      }).observe(chain);
    }

    function setOpen(open) {
      el.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    toggle.addEventListener('click', function () { toggle.classList.remove('is-pulsing'); setOpen(!el.classList.contains('is-open')); });
    document.addEventListener('click', function (e) { if (!el.contains(e.target)) setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });

    // No celular o selo nunca cobre o botão de compra: sai de cena enquanto ele está visível.
    var buyButtons = document.querySelectorAll('[data-lp-submit]');
    if (buyButtons.length && 'IntersectionObserver' in window) {
      var onScreen = new Set();
      var yieldIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { e.isIntersecting ? onScreen.add(e.target) : onScreen.delete(e.target); });
        el.classList.toggle('is-yielding', onScreen.size > 0 && window.innerWidth < 1024);
      });
      buyButtons.forEach(function (b) { yieldIo.observe(b); });
    }

    el.querySelector('[data-breakbadge-share]').addEventListener('click', function () {
      var data = { title: el.dataset.shareTitle, text: el.dataset.shareText, url: el.dataset.shareUrl };
      if (navigator.share) { navigator.share(data).catch(function () {}); return; }
      var done = function () {
        toast.classList.add('is-on');
        setTimeout(function () { toast.classList.remove('is-on'); }, 1800);
      };
      if (navigator.clipboard) {
        navigator.clipboard.writeText(data.text + ' ' + data.url).then(done, function () { window.prompt('Copie o link:', data.url); });
      } else {
        window.prompt('Copie o link:', data.url);
      }
    });
  })();
</script>

<script>
  // Trilha sonora: tenta tocar sozinha ao abrir a página, com fade-in, em loop.
  // Quase todo navegador bloqueia som automático (Safari, Firefox, celulares;
  // o Chrome deixa pra quem já interagiu com o site). Bloqueou: o botão pulsa
  // e a música começa no primeiro gesto em qualquer lugar (toque, clique ou
  // tecla — rolar não conta). O botão liga/desliga e o "desligado" fica
  // lembrado neste navegador. Pausa quando a aba vai pro fundo e volta junto.
  // (No iPhone o volume é sempre o do aparelho: o Safari ignora audio.volume.)
  (function () {
    var buttons = document.querySelectorAll('[data-lp-sound]');
    if (!buttons.length || typeof Audio === 'undefined') return;
    var html = document.documentElement;
    var KEY = 'lp_sound_off_<%= @landing_page.id %>';
    var VOLUME = 0.45;
    var audio = new Audio('<%= audio_path('drop_01_1822/trilha.mp3') %>');
    audio.loop = true;
    audio.preload = mutedByUser() ? 'none' : 'auto'; // quem desligou o som não baixa os 2,3 MB
    var playing = false, resumeOnReturn = false, fadeTimer = null;

    function mutedByUser() { try { return localStorage.getItem(KEY) === '1'; } catch (e) { return false; } }
    function rememberMuted(on) { try { on ? localStorage.setItem(KEY, '1') : localStorage.removeItem(KEY); } catch (e) {} }
    function paint() {
      html.classList.toggle('lp-sound-on', playing);
      buttons.forEach(function (b) {
        b.setAttribute('aria-pressed', playing ? 'true' : 'false');
        b.setAttribute('aria-label', playing ? 'Desligar som' : 'Ligar som');
      });
    }
    function fade(to, ms, done) {
      clearInterval(fadeTimer);
      var from = audio.volume, t0 = Date.now();
      fadeTimer = setInterval(function () {
        var k = Math.min(1, (Date.now() - t0) / ms);
        audio.volume = from + (to - from) * k;
        if (k >= 1) { clearInterval(fadeTimer); if (done) done(); }
      }, 30);
    }
    function start() {
      audio.volume = 0;
      var attempt = audio.play();
      return Promise.resolve(attempt).then(function () {
        playing = true; html.classList.remove('lp-sound-blocked'); paint(); fade(VOLUME, 1500);
      }, function () {
        playing = false; paint();
        throw new Error('blocked');
      });
    }
    function stop() {
      playing = false; paint();
      fade(0, 350, function () { audio.pause(); });
    }

    buttons.forEach(function (button) {
      button.addEventListener('click', function () {
        if (playing) { stop(); rememberMuted(true); }
        else { rememberMuted(false); start().catch(function () {}); }
      });
    });

    // Primeiro gesto na página: começa a tocar (se a pessoa não desligou antes).
    // Se o navegador ainda não aceitar aquele gesto, espera o próximo.
    var GESTURES = ['pointerdown', 'mousedown', 'pointerup', 'touchend', 'click', 'keydown'];
    function stopListening() { GESTURES.forEach(function (t) { document.removeEventListener(t, onGesture, true); }); }
    // Um clique dispara vários desses eventos em sequência: só a 1ª tentativa vale.
    var trying = false;
    function onGesture(event) {
      if (event.target.closest && event.target.closest('[data-lp-sound]')) { stopListening(); return; } // o botão cuida
      if (mutedByUser() || playing) { stopListening(); return; }
      if (trying) return;
      trying = true;
      start().then(stopListening, function () { trying = false; });
    }
    GESTURES.forEach(function (t) { document.addEventListener(t, onGesture, true); });

    document.addEventListener('visibilitychange', function () {
      if (document.hidden && playing) { resumeOnReturn = true; audio.pause(); }
      else if (!document.hidden && resumeOnReturn) { resumeOnReturn = false; audio.play().catch(function () { playing = false; paint(); }); }
    });

    // Botão flutuante só aparece quando o do cabeçalho sai da tela.
    var anchor = document.querySelector('[data-lp-sound-anchor]');
    if (anchor && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        html.classList.toggle('lp-top-gone', !entries[0].isIntersecting);
      }).observe(anchor);
    }
    paint();

    // Tenta tocar já ao abrir. Se o navegador bloquear, o botão pulsa e o
    // primeiro toque/clique em qualquer lugar começa a música.
    if (!mutedByUser()) {
      start().then(stopListening, function () { html.classList.add('lp-sound-blocked'); });
    }
  })();
</script>

