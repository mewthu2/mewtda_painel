     data-break-url="<%= public_landing_page_break_path(@landing_page.path_prefix, @landing_page.slug) %>"
     data-count="<%= @landing_page.chain_breaks_count %>" data-share-url="<%= share_url %>"
     data-share-title="1822 · Independência se veste." data-share-text="Ajude a romper essa corrente.">
  <button type="button" class="breakbadge__toggle" data-breakbadge-toggle aria-expanded="false" aria-controls="breakbadge-panel"
          aria-label="Pessoas que já romperam a corrente">
    <svg class="breakbadge__icon" viewBox="0 0 68 40" aria-hidden="true">
      <path d="M 26 8 A 16 12 0 0 0 26 32"/>
      <rect x="0" y="17" width="18" height="6" rx="3"/>
      <path d="M 42 8 A 16 12 0 0 1 42 32"/>
      <rect x="50" y="17" width="18" height="6" rx="3"/>
    </svg>
    <span data-breakbadge-count><%= number_with_delimiter(@landing_page.chain_breaks_count, delimiter: '.') %></span>
  </button>
  <div class="breakbadge__panel" id="breakbadge-panel" role="dialog" aria-label="Romper a corrente">
    <p><strong data-breakbadge-count><%= number_with_delimiter(@landing_page.chain_breaks_count, delimiter: '.') %></strong> pessoas já romperam a corrente.</p>
    <button type="button" class="breakbadge__share" data-breakbadge-share>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7"/><path d="M16 6l-4-4-4 4"/><path d="M12 2v13"/></svg>
      Ajude a romper essa corrente
    </button>
    <span class="breakbadge__toast" data-breakbadge-toast role="status">Link copiado</span>
  </div>
</div>
<script>
  // Selo "X já romperam a corrente": aparece quando a pessoa rompe (ou se já
  // rompeu antes neste navegador), registra no servidor e compartilha a página.
  (function () {
    var el = document.querySelector('[data-breakbadge]');
    if (!el) return;
    var root = document.documentElement;
    var key = 'lp_broke_<%= @landing_page.id %>';
    var countEls = el.querySelectorAll('[data-breakbadge-count]');
    var toggle = el.querySelector('[data-breakbadge-toggle]');
    var toast = el.querySelector('[data-breakbadge-toast]');
    var fmt = new Intl.NumberFormat('pt-BR');
    var shown = false;

    function show() {
      if (shown) return;
      shown = true;
      el.classList.add('is-visible');
    }

    function animateTo(target) {
      var from = parseInt(el.dataset.count, 10) || 0;
      el.dataset.count = target;
      var start = performance.now();
      (function step(now) {
        var k = Math.min(1, (now - start) / 900);
        var text = fmt.format(Math.round(from + (target - from) * (1 - Math.pow(1 - k, 3))));
        countEls.forEach(function (c) { c.textContent = text; });
        if (k < 1) requestAnimationFrame(step);
      })(start);
    }

    window.lpBreakBadge = {
      broke: function () {
        try { localStorage.setItem(key, '1'); } catch (e) {}
        show();
        toggle.classList.add('is-pulsing');
        animateTo((parseInt(el.dataset.count, 10) || 0) + 1);
        fetch(el.dataset.breakUrl, { method: 'POST', headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
          .then(function (r) { return r.json(); })
          .then(function (json) { if (typeof json.count === 'number') animateTo(json.count); })
          .catch(function () {});
      }
    };

    if (root.classList.contains('chain-done')) {
      show();
    } else if (!root.classList.contains('motion') && 'IntersectionObserver' in window) {
      // Sem animação a corrente não "rompe": mostra o selo quando a frase aparece, sem contar.
      var chain = document.querySelector('[data-chain]');
      if (chain) new IntersectionObserver(function (e, io) {
        if (e[0].isIntersecting) { show(); io.disconnect(); }
      }).observe(chain);
    }

    function setOpen(open) {
      el.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }
    toggle.addEventListener('click', function () { toggle.classList.remove('is-pulsing'); setOpen(!el.classList.contains('is-open')); });
    document.addEventListener('click', function (e) { if (!el.contains(e.target)) setOpen(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });

    // No celular o selo nunca cobre o botão de compra: sai de cena enquanto ele está visível.
    var buyButtons = document.querySelectorAll('[data-lp-submit]');
    if (buyButtons.length && 'IntersectionObserver' in window) {
      var onScreen = new Set();
      var yieldIo = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { e.isIntersecting ? onScreen.add(e.target) : onScreen.delete(e.target); });
        el.classList.toggle('is-yielding', onScreen.size > 0 && window.innerWidth < 1024);
      });
      buyButtons.forEach(function (b) { yieldIo.observe(b); });
    }

    el.querySelector('[data-breakbadge-share]').addEventListener('click', function () {
      var data = { title: el.dataset.shareTitle, text: el.dataset.shareText, url: el.dataset.shareUrl };
      if (navigator.share) { navigator.share(data).catch(function () {}); return; }
      var done = function () {
        toast.classList.add('is-on');
        setTimeout(function () { toast.classList.remove('is-on'); }, 1800);
      };
      if (navigator.clipboard) {
        navigator.clipboard.writeText(data.text + ' ' + data.url).then(done, function () { window.prompt('Copie o link:', data.url); });
      } else {
        window.prompt('Copie o link:', data.url);
      }
    });
  })();
</script>

<% if @landing_page.sales_open? && first_product %>
  <div class="stickybar" data-stickybar>
    <span class="stickybar__price">Drop 01 · a partir de<strong><%= lp_money(lp_min_price(first_product)) %></strong></span>
    <a class="btn btn--amarelo" href="#comprar">Comprar</a>
  </div>
  <script>
    (function () {
      var bar = document.querySelector('[data-stickybar]');
      var hero = document.querySelector('.hero');
      var drop = document.getElementById('comprar');
      if (!bar || !('IntersectionObserver' in window)) return;
      var heroVisible = true, dropVisible = false;
      function update() {
        var on = !heroVisible && !dropVisible;
        bar.classList.toggle('is-visible', on);
        document.body.classList.toggle('stickybar-on', on && window.innerWidth < 1024);
      }
      new IntersectionObserver(function (e) { heroVisible = e[0].isIntersecting; update(); }).observe(hero);
      new IntersectionObserver(function (e) { dropVisible = e[0].isIntersecting; update(); }, { threshold: 0.15 }).observe(drop);
    })();
  </script>
<% end %>
