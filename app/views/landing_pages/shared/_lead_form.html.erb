<%#
  Formulário de lead. Locals: button_text, success_text (opcionais).
  Envia por fetch pra public_landing_page_lead_path com as UTMs da visita.
%>
<form class="lp-lead" data-lp-lead action="<%= public_landing_page_lead_path(@landing_page.path_prefix, @landing_page.slug) %>" method="post" novalidate>
  <div class="lp-lead__fields">
    <label class="lp-lead__field">
      <span>Nome</span>
      <input type="text" name="name" autocomplete="name" required>
    </label>
    <label class="lp-lead__field">
      <span>E-mail</span>
      <input type="email" name="email" autocomplete="email" inputmode="email" required>
    </label>
    <label class="lp-lead__field">
      <span>WhatsApp</span>
      <input type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="(31) 99999-9999">
    </label>
    <%# honeypot %>
    <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0">
  </div>
  <button type="submit" class="lp-lead__submit"><%= local_assigns.fetch(:button_text, 'Quero receber') %></button>
  <p class="lp-lead__message" data-lp-lead-message role="status" aria-live="polite"
     data-success="<%= local_assigns.fetch(:success_text, 'Pronto, você está na lista.') %>"></p>
</form>
