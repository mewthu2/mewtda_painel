<% title 'Minha Conta' %>

<div class="users-form-page">
  <div class="crm-card users-form-page__card">

    <div class="users-form-page__header">
      <div class="users-form-page__header-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
        </svg>
      </div>
      <div>
        <h2 class="users-form-page__title">Minha Conta</h2>
        <p class="users-form-page__subtitle">Seus dados e senha de acesso</p>
      </div>
    </div>

    <% if @user.errors.any? %>
      <div class="users-form-page__errors">
        <div class="users-form-page__errors-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </div>
        <div>
          <strong>Corrija os erros abaixo:</strong>
          <ul>
            <% @user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%= form_for @user, as: :user, url: account_path, method: :patch, html: { autocomplete: 'off' } do |form| %>
      <div class="users-form-page__body">

        <div class="users-form-page__field">
          <%= form.label :name, 'Nome', class: 'crm-label' %>
          <%= form.text_field :name, class: 'crm-input', required: true, placeholder: 'Nome completo' %>
        </div>

        <div class="users-form-page__row">
          <div class="users-form-page__field">
            <%= form.label :email, 'E-mail', class: 'crm-label' %>
            <%= form.email_field :email, class: 'crm-input', required: true, placeholder: 'email@exemplo.com' %>
          </div>
          <div class="users-form-page__field">
            <%= form.label :phone, 'Telefone', class: 'crm-label' %>
            <%= form.telephone_field :phone, class: 'crm-input', placeholder: '(00) 00000-0000' %>
          </div>
        </div>

        <div class="users-form-page__section">
          <div class="users-form-page__section-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Informações da Conta
          </div>
          <div class="users-form-page__row">
            <div class="users-form-page__field">
              <label class="crm-label">Perfil</label>
              <div class="users-form-page__readonly">
                <%= @user.profile&.name || 'Sem perfil definido' %>
              </div>
            </div>
            <div class="users-form-page__field">
              <label class="crm-label">Cliente</label>
              <div class="users-form-page__readonly">
                <%= @user.client&.name || 'Nenhum' %>
              </div>
            </div>
          </div>
          <div class="users-form-page__row">
            <div class="users-form-page__field">
              <label class="crm-label">Último acesso</label>
              <div class="users-form-page__readonly">
                <%= @user.last_sign_in_at.present? ? l(@user.last_sign_in_at, format: '%d/%m/%Y %H:%M') : 'Nunca' %>
              </div>
            </div>
            <div class="users-form-page__field">
              <label class="crm-label">Conta criada em</label>
              <div class="users-form-page__readonly">
                <%= l(@user.created_at, format: '%d/%m/%Y') %>
              </div>
            </div>
          </div>
        </div>

        <div class="users-form-page__section">
          <div class="users-form-page__section-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" />
            </svg>
            Trocar Senha
          </div>
          <p class="users-form-page__section-hint">Deixe em branco se não quiser alterar sua senha.</p>
          <div class="users-form-page__row">
            <div class="users-form-page__field">
              <%= form.label :password, 'Nova senha', class: 'crm-label' %>
              <%= form.password_field :password, class: 'crm-input', placeholder: 'Mínimo 6 caracteres' %>
            </div>
            <div class="users-form-page__field">
              <%= form.label :password_confirmation, 'Confirmar nova senha', class: 'crm-label' %>
              <%= form.password_field :password_confirmation, class: 'crm-input', placeholder: 'Repita a nova senha' %>
            </div>
          </div>
        </div>

      </div>

      <div class="users-form-page__footer">
        <%= form.button class: 'crm-btn crm-btn--primary', data: { disable_with: 'Salvando...' } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Salvar Alterações
        <% end %>
      </div>
    <% end %>

  </div>
</div>
