<% title 'Configurar Afiliados' %>

<div class="cpform-wrapper">
  <div class="cpform-card">

    <div class="cpform-card__header">
      <div class="cpform-card__header-icon">
        <i class="fa-solid fa-link"></i>
      </div>
      <div>
        <h2 class="cpform-card__title">Configurar Afiliados</h2>
        <p class="cpform-card__subtitle">Cliente: <%= current_client.name %></p>
      </div>
    </div>

    <% if current_client.errors.any? %>
      <div class="cpform-errors">
        <div class="cpform-errors__icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </div>
        <div>
          <strong>Corrija os erros abaixo:</strong>
          <ul>
            <% current_client.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%= form_with model: current_client, url: settings_affiliates_path, method: :patch, html: { autocomplete: 'off' } do |form| %>
      <div class="cpform-card__body">
        <div class="cpform-section">
          <div class="cpform-section__header">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
            </svg>
            Site Principal
          </div>

          <p class="cpform-section__description">
            URL principal da loja. Todo link de afiliado gerado vai usar essa URL como base — o afiliado ou você
            só precisa informar o caminho da página (opcional) na hora de gerar o link.
          </p>

          <div class="cpform-field">
            <%= form.label :site_url, 'URL do Site', class: 'crm-label' %>
            <%= form.url_field :site_url, class: 'crm-input', required: true,
                placeholder: 'https://sualojaexemplo.com.br' %>
            <span class="cpform-field__hint">Deve começar com http:// ou https://, sem caminho (ex: sem /produtos/...)</span>
          </div>
        </div>
      </div>

      <div class="cpform-card__footer">
        <%= link_to affiliates_path, class: 'crm-btn crm-btn--secondary' do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
          </svg>
          Voltar
        <% end %>
        <%= form.button class: 'crm-btn crm-btn--primary', data: { disable_with: 'Salvando...' } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Salvar
        <% end %>
      </div>
    <% end %>

  </div>
</div>
