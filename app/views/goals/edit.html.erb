<% title 'Meta do Mês' %>

<% current_month = Date.new(@year, @month, 1) %>

<div class="users-form-page">
  <div class="crm-card users-form-page__card">

    <div class="users-form-page__header">
      <div class="users-form-page__header-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <h2 class="users-form-page__title">Meta do Mês</h2>
        <p class="users-form-page__subtitle"><%= @client.name %> — <%= month_label(current_month) %></p>
      </div>
    </div>

    <div class="sd-month-nav" style="margin-bottom: 16px;">
      <%= link_to '‹', edit_goal_path(year: (current_month - 1.month).year, month: (current_month - 1.month).month), class: 'sd-month-nav__btn' %>
      <span class="sd-month-nav__label" style="color: var(--fg);"><%= month_label(current_month) %></span>
      <%= link_to '›', edit_goal_path(year: (current_month + 1.month).year, month: (current_month + 1.month).month), class: 'sd-month-nav__btn' %>
    </div>

    <% if @goal.errors.any? %>
      <div class="users-form-page__errors">
        <div class="users-form-page__errors-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </div>
        <div>
          <strong>Corrija os erros abaixo:</strong>
          <ul>
            <% @goal.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%= form_for @goal, as: :goal, url: goal_path(year: @year, month: @month), method: :patch, html: { autocomplete: 'off' } do |form| %>
      <div class="users-form-page__body">
        <div class="users-form-page__field">
          <%= form.label :revenue_target, 'Meta de Faturamento — Bruto − Descontos (R$)', class: 'crm-label' %>
          <%= form.number_field :revenue_target, class: 'crm-input', step: '0.01', min: 0, placeholder: 'Ex.: 200000' %>
          <span class="cpform-field__hint">Vendas brutas menos descontos, sem considerar frete/reembolsos do mês.</span>
        </div>

        <div class="users-form-page__row">
          <div class="users-form-page__field">
            <%= form.label :avg_ticket_target, 'Meta de Ticket Médio (R$)', class: 'crm-label' %>
            <%= form.number_field :avg_ticket_target, class: 'crm-input', step: '0.01', min: 0, placeholder: 'Ex.: 250' %>
          </div>
          <div class="users-form-page__field">
            <%= form.label :conversion_rate_target, 'Meta de Taxa de Conversão (%)', class: 'crm-label' %>
            <%= form.number_field :conversion_rate_target, class: 'crm-input', step: '0.01', min: 0, placeholder: 'Ex.: 1.5' %>
          </div>
        </div>

        <div class="users-form-page__row">
          <div class="users-form-page__field">
            <%= form.label :roas_target, 'Meta de ROAS', class: 'crm-label' %>
            <%= form.number_field :roas_target, class: 'crm-input', step: '0.01', min: 0, placeholder: 'Ex.: 5' %>
            <span class="cpform-field__hint">Ex.: 5 = R$5 de faturamento pra cada R$1 investido em anúncio.</span>
          </div>
          <div class="users-form-page__field">
            <%= form.label :cac_target, 'Meta de CAC — teto máximo (R$)', class: 'crm-label' %>
            <%= form.number_field :cac_target, class: 'crm-input', step: '0.01', min: 0, placeholder: 'Ex.: 40' %>
            <span class="cpform-field__hint">Custo máximo aceitável por cliente novo adquirido.</span>
          </div>
        </div>

        <div class="users-form-page__section">
          <div class="users-form-page__section-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" />
            </svg>
            Meta por Vendedora/Tag
          </div>
          <div class="users-form-page__row">
            <div class="users-form-page__field">
              <%= form.label :tagged_revenue_tag, 'Tag do pedido', class: 'crm-label' %>
              <%= form.text_field :tagged_revenue_tag, class: 'crm-input', placeholder: 'Ex.: VendedoraElo' %>
            </div>
            <div class="users-form-page__field">
              <%= form.label :tagged_revenue_target, 'Meta de Vendas com essa tag (R$)', class: 'crm-label' %>
              <%= form.number_field :tagged_revenue_target, class: 'crm-input', step: '0.01', min: 0, placeholder: 'Ex.: 30000' %>
            </div>
          </div>
          <span class="cpform-field__hint">Soma o Bruto − Descontos só dos pedidos que tiverem essa tag (ex.: nome de uma vendedora específica).</span>
        </div>
      </div>

      <div class="users-form-page__footer">
        <%= link_to sales_dashboard_path(year: @year, month: @month), class: 'crm-btn crm-btn--secondary' do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
          </svg>
          Voltar
        <% end %>
        <%= form.button class: 'crm-btn crm-btn--primary', data: { disable_with: 'Salvando...' } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Salvar Meta
        <% end %>
      </div>
    <% end %>

  </div>
</div>
