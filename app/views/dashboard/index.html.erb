<% title 'Dashboard Analytics' %>

<div class="db-page">

<div class="db-header">
  <div class="db-header__left">
    <div class="db-header__breadcrumb">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>Dashboard</span>
      <% if @client %>
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
        <span class="db-header__client-name"><%= @client.name %></span>
      <% end %>
    </div>
    <h1 class="db-header__title">Analytics</h1>
    <p class="db-header__subtitle">
      <% if @client %>
        Funil de conversao e comportamento dos visitantes
      <% else %>
        Selecione um cliente para visualizar os dados
      <% end %>
    </p>
  </div>

  <div class="db-header__right">
    <%# Filtros rapidos de periodo %>
    <div class="db-filters <%= 'db-filters--muted' if @using_month_filter %>">
      <%= link_to "Hoje",    crm_path(period: "1"),  class: "db-filter-btn #{'db-filter-btn--active' if @period == '1' && !@using_month_filter}" %>
      <%= link_to "7 dias",  crm_path(period: "7"),  class: "db-filter-btn #{'db-filter-btn--active' if @period == '7' && !@using_month_filter}" %>
      <%= link_to "15 dias", crm_path(period: "15"), class: "db-filter-btn #{'db-filter-btn--active' if @period == '15' && !@using_month_filter}" %>
      <%= link_to "30 dias", crm_path(period: "30"), class: "db-filter-btn #{'db-filter-btn--active' if @period == '30' && !@using_month_filter}" %>
    </div>

    <%# Filtro por mes/ano %>
    <div class="db-month-filter">
      <%= form_with url: crm_path, method: :get, local: true, class: "db-month-filter__form" do |f| %>
        <select name="year" class="db-month-filter__select <%= 'db-month-filter__select--active' if @using_month_filter %>">
          <option value="">Ano</option>
          <% [2025, 2026].each do |y| %>
            <option value="<%= y %>" <%= 'selected' if @filter_year == y %>><%= y %></option>
          <% end %>
        </select>

        <select name="month" class="db-month-filter__select <%= 'db-month-filter__select--active' if @using_month_filter %>">
          <option value="">Mes</option>
          <% Date::MONTHNAMES.compact.each_with_index do |name, idx| %>
            <option value="<%= idx + 1 %>" <%= 'selected' if @filter_month == idx + 1 %>><%= name %></option>
          <% end %>
        </select>

        <button type="submit" class="db-month-filter__btn">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
          Filtrar
        </button>

        <% if @using_month_filter %>
          <%= link_to crm_path(period: "1"), class: "db-month-filter__clear" do %>
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>


  <% if @empty_state %>
    <div class="db-card">
      <div class="db-empty">
        <div class="db-empty__icon">
          <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75z"/>
            <path d="M9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625z"/>
            <path d="M16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
          </svg>
        </div>
        <% if @awaiting_period %>
          <h2 class="db-empty__title" data-db-loading-title>Escolha um período</h2>
          <p class="db-empty__text" data-db-loading-text>Selecione Hoje, 7, 15 ou 30 dias (ou um mês) acima para carregar os dados do pixel.</p>
        <% else %>
          <h2 class="db-empty__title">Nenhum dado disponivel</h2>
          <p class="db-empty__text"><%= @empty_message %></p>
        <% end %>
      </div>
    </div>

  <% else %>
    <%# Relatório chega pelo websocket (TrackingReportChannel), ver script abaixo %>
    <div id="db-report" data-report-token="<%= @report_token %>">
      <div class="db-card">
        <div class="db-empty">
          <div class="db-empty__icon db-empty__icon--spin">
            <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
          </div>
          <h2 class="db-empty__title" data-db-report-title>Carregando dados…</h2>
          <p class="db-empty__text" data-db-report-text>Estamos processando os eventos do pixel. A tela atualiza sozinha quando terminar.</p>
        </div>
      </div>
    </div>
  <% end %>

</div>



<div id="db-modal-overlay" class="db-modal-overlay" role="dialog" aria-modal="true">
  <div class="db-modal">
    <div class="db-modal__head">
      <div>
        <h2 class="db-modal__head-title">Detalhes da Sessao</h2>
        <p id="db-modal-sid" class="db-modal__head-sid"></p>
      </div>
      <button id="db-modal-close" class="db-modal__close">&times;</button>
    </div>
    <div id="db-modal-meta" class="db-modal__meta"></div>
    <div class="db-modal__body">
      <div id="db-modal-loading" class="db-modal__loading">Carregando...</div>
      <div id="db-modal-events" style="display:none">
        <p class="db-modal__section-title">Timeline de Eventos</p>
        <div id="db-modal-events-list"></div>
      </div>
    </div>
  </div>
</div>


<% if @awaiting_period %>
<script>
  // As consultas do pixel demoram: avisa que está carregando depois do clique.
  (function () {
    function showLoading() {
      var title = document.querySelector('[data-db-loading-title]');
      var text  = document.querySelector('[data-db-loading-text]');
      if (title) title.textContent = 'Carregando dados…';
      if (text)  text.textContent  = 'Isso pode levar alguns segundos.';
    }
    document.querySelectorAll('.db-filter-btn').forEach(function (el) { el.addEventListener('click', showLoading); });
    var form = document.querySelector('.db-month-filter__form');
    if (form) form.addEventListener('submit', showLoading);
  })();
</script>
<% end %>

<% if @report_token %>
<script>
  // Assina o canal, pede o relatório e troca o "Carregando" pelo HTML pronto.
  (function () {
    var box = document.getElementById('db-report');
    if (!box || !window.ActionCable) return;

    function fail(message) {
      var title = box.querySelector('[data-db-report-title]');
      var text  = box.querySelector('[data-db-report-text]');
      if (title) title.textContent = 'Não deu pra carregar';
      if (text)  text.textContent  = message;
      var icon = box.querySelector('.db-empty__icon--spin');
      if (icon) icon.classList.remove('db-empty__icon--spin');
    }

    var done = false, started = false;
    var consumer = ActionCable.createConsumer();
    var timeout = setTimeout(function () {
      if (!done) fail('Demorou mais que o esperado. Recarregue a página para tentar de novo.');
    }, 180000);

    consumer.subscriptions.create({ channel: 'TrackingReportChannel', token: box.dataset.reportToken }, {
      connected: function () {
        if (started) return;
        started = true;
        this.perform('start');
      },
      rejected: function () { fail('Sessão expirada. Recarregue a página.'); },
      received: function (data) {
        done = true;
        clearTimeout(timeout);
        consumer.disconnect();
        if (data.error) return fail(data.error);

        box.innerHTML = data.html;
        var chartData = document.getElementById('db-chart-data');
        if (chartData) renderDbCharts(JSON.parse(chartData.textContent));
      }
    });
  })();

function renderDbCharts(d) {
  var COLORS = ['#3b82f6', '#22c55e', '#f59e0b', '#ec4899', '#8b5cf6'];

  new ApexCharts(document.querySelector("#events_chart"), {
    chart: { type: 'area', height: 220, toolbar: { show: false }, fontFamily: 'inherit' },
    series: [
      { name: 'Page',     data: d.daily.page_viewed },
      { name: 'Produto',  data: d.daily.product_viewed },
      { name: 'Carrinho', data: d.daily.product_added_to_cart },
      { name: 'Checkout', data: d.daily.checkout_completed }
    ],
    xaxis: { type: 'datetime', labels: { style: { fontSize: '11px' } } },
    colors: COLORS,
    fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.3, opacityTo: 0.05 } },
    stroke: { width: 2, curve: 'smooth' },
    legend: { fontSize: '11px', position: 'top' },
    grid: { borderColor: '#f1f5f9' },
    tooltip: { theme: 'light', x: { format: 'dd/MM' } }
  }).render();

  new ApexCharts(document.querySelector("#devices_chart"), {
    chart: { type: 'donut', height: 220, fontFamily: 'inherit' },
    series: d.devices,
    labels: ['Desktop', 'Mobile', 'Tablet'],
    colors: ['#3b82f6', '#22c55e', '#f59e0b'],
    legend: { position: 'bottom', fontSize: '12px' },
    plotOptions: { pie: { donut: { size: '60%', labels: { show: true, total: { show: true, label: 'Total', fontSize: '14px', fontWeight: 700 } } } } },
    dataLabels: { enabled: false }
  }).render();

  new ApexCharts(document.querySelector("#referrers_chart"), {
    chart: { type: 'bar', height: 220, toolbar: { show: false }, fontFamily: 'inherit' },
    series: [{ name: 'Visitas', data: d.referrers.values }],
    xaxis: { categories: d.referrers.labels },
    colors: ['#8b5cf6'],
    plotOptions: { bar: { horizontal: true, borderRadius: 4 } },
    grid: { borderColor: '#f1f5f9' },
    dataLabels: { enabled: true, style: { fontSize: '11px' } }
  }).render();

  new ApexCharts(document.querySelector("#weekday_chart"), {
    chart: { type: 'bar', height: 200, toolbar: { show: false }, fontFamily: 'inherit' },
    series: [{ name: 'Eventos', data: d.weekday.values }],
    xaxis: { categories: d.weekday.labels },
    colors: ['#3b82f6'],
    plotOptions: { bar: { borderRadius: 4, columnWidth: '55%' } },
    grid: { borderColor: '#f1f5f9' },
    dataLabels: { enabled: false }
  }).render();

  new ApexCharts(document.querySelector("#funnel_bar_chart"), {
    chart: { type: 'bar', height: 200, toolbar: { show: false }, fontFamily: 'inherit' },
    series: [{ name: 'Eventos', data: d.funnel }],
    xaxis: { categories: ['Paginas', 'Produtos', 'Carrinho', 'Checkout'] },
    colors: COLORS,
    plotOptions: { bar: { distributed: true, borderRadius: 6, columnWidth: '50%' } },
    legend: { show: false },
    grid: { borderColor: '#f1f5f9' },
    dataLabels: { enabled: true, style: { fontSize: '12px', fontWeight: 700 } }
  }).render();
}
</script>
<% end %>

<script>
(function () {
  var KIND_BADGE = {
    page_viewed:           'db-badge--info',
    product_viewed:        'crm-tag crm-tag--success',
    product_added_to_cart: 'crm-tag crm-tag--warning',
    checkout_started:      'crm-tag crm-tag--warning',
    checkout_completed:    'db-badge--checkout'
  };

  function fmtDate(str) { return new Date(str).toLocaleString('pt-BR'); }

  function chip(label, value) {
    return '<div class="db-modal__chip"><span style="color:var(--fg-alt)">' + label + '</span> <strong>' + value + '</strong></div>';
  }

  function renderEvent(e) {
    var ctx = e.context || {}, doc = ctx.document || {}, nav = ctx.navigator || {}, win = ctx.window || {}, loc = doc.location || {}, scr = win.screen || {};
    var url = loc.href, title = doc.title, referrer = doc.referrer, ua = nav.userAgent;
    var screen = (scr.width && scr.height) ? scr.width + 'x' + scr.height : null;
    var hasData = e.data && typeof e.data === 'object' && Object.keys(e.data).length > 0;
    var badgeCls = KIND_BADGE[e.kind] || '';

    var html = '<div class="db-event">';
    html += '<div class="db-event__head">';
    html += '<span class="db-badge ' + badgeCls + '">' + (e.kind || '').replace(/_/g,' ') + '</span>';
    html += '<span class="db-event__time">' + fmtDate(e.created_at) + '</span>';
    html += '</div>';
    if (title) html += '<div class="db-event__row"><strong>Titulo:</strong> ' + title + '</div>';
    if (url) html += '<div class="db-event__row" style="word-break:break-all"><strong>URL:</strong> <a href="' + url + '" target="_blank">' + url + '</a></div>';
    if (referrer) html += '<div class="db-event__row" style="word-break:break-all"><strong>Referrer:</strong> ' + referrer + '</div>';
    if (screen) html += '<div class="db-event__row"><strong>Tela:</strong> ' + screen + '</div>';
    if (ua) html += '<div class="db-event__row db-event__row--muted">' + ua + '</div>';
    if (hasData) {
      html += '<details><summary>Ver dados</summary><pre>' + JSON.stringify(e.data, null, 2) + '</pre></details>';
    }
    html += '</div>';
    return html;
  }

  // Delegação: as linhas chegam depois, junto com o relatório.
  document.addEventListener('click', function (e) {
    var row = e.target.closest && e.target.closest('.db-session-row');
    if (!row) return;
    (function () {
      var sid = row.dataset.sessionId, url = row.dataset.fetchUrl;
      document.getElementById('db-modal-sid').textContent = sid;
      document.getElementById('db-modal-meta').innerHTML = '';
      document.getElementById('db-modal-events-list').innerHTML = '';
      document.getElementById('db-modal-loading').style.display = 'block';
      document.getElementById('db-modal-loading').textContent = 'Carregando...';
      document.getElementById('db-modal-events').style.display = 'none';
      document.getElementById('db-modal-overlay').style.display = 'block';
      document.body.style.overflow = 'hidden';

      fetch(url, { method: 'GET', credentials: 'same-origin', headers: { 'Accept': 'application/json', 'X-CSRF-Token': (document.querySelector('meta[name="csrf-token"]') || {}).content || '' } })
        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(function (data) {
          var meta = '';
          meta += chip('Dominio', data.shop_domain || '-');
          meta += chip('Inicio', fmtDate(data.started_at));
          meta += chip('Fim', fmtDate(data.last_at));
          meta += chip('Eventos', data.event_count);
          document.getElementById('db-modal-meta').innerHTML = meta;
          document.getElementById('db-modal-events-list').innerHTML = (data.events || []).map(renderEvent).join('');
          document.getElementById('db-modal-loading').style.display = 'none';
          document.getElementById('db-modal-events').style.display = 'block';
        })
        .catch(function () { document.getElementById('db-modal-loading').textContent = 'Erro ao carregar. Tente novamente.'; });
    })();
  });

  function closeModal() { document.getElementById('db-modal-overlay').style.display = 'none'; document.body.style.overflow = ''; }
  document.getElementById('db-modal-close').addEventListener('click', closeModal);
  document.getElementById('db-modal-overlay').addEventListener('click', function (e) { if (e.target === this) closeModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });
}());
</script>
