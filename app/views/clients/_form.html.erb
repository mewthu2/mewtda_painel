<%= form_for(client, as: :client, url: local_assigns[:form_url] || client, html: { autocomplete: 'off' }, data: { disabled: read_only }) do |form| %>

  <div class="cform-wrapper">
    <div class="cform-card">

      <div class="cform-card__header">
        <div class="cform-card__header-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.016a3.001 3.001 0 003.75.614m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72m-13.5 8.65h3.75a.75.75 0 00.75-.75V13.5a.75.75 0 00-.75-.75H6.75a.75.75 0 00-.75.75v3.75c0 .415.336.75.75.75z" />
          </svg>
        </div>
        <div>
          <h2 class="cform-card__title"><%= client.new_record? ? 'Criar Cliente' : 'Editar Cliente' %></h2>
          <p class="cform-card__subtitle">Informações do cliente e integrações</p>
        </div>
      </div>

      <% if client.errors.any? %>
        <div class="cform-errors">
          <div class="cform-errors__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
            </svg>
          </div>
          <div>
            <strong>Corrija os erros abaixo:</strong>
            <ul>
              <% client.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>


      <%# Status de cada integração (bolinha verde na aba quando configurada) %>
      <% shopify_configured = client.shopify_shop_url.present? && client.shopify_access_token.present? %>
      <% zapi_configured = client.zapi_instance_id.present? && client.zapi_instance_token.present? && client.zapi_client_token.present? %>
      <% whatsapp_cloud_configured = client.whatsapp_cloud_configured? %>
      <% whatsapp_configured = zapi_configured || whatsapp_cloud_configured %>
      <% meta_configured = client.meta_access_token.present? && client.meta_ad_account_id.present? %>
      <% google_configured = client.google_ads_connected_at.present? %>
      <% show_users_tab = current_user.admin? && client.persisted? && client.users.any? %>

      <%# Abas: cada integração na sua tela, em vez de tudo empilhado %>
      <div class="cform-tabs" role="tablist" data-cform-tabs>
        <button type="button" class="cform-tab" role="tab" data-tab="geral" aria-selected="false">
          <span class="cform-logo cform-logo--geral"><i class="fa-solid fa-store"></i></span>
          <span>Geral</span>
        </button>
        <button type="button" class="cform-tab" role="tab" data-tab="shopify" aria-selected="false">
          <span class="cform-logo cform-logo--shopify"><i class="fa-brands fa-shopify"></i></span>
          <span>Shopify</span>
          <span class="cform-tab__dot <%= shopify_configured ? 'cform-tab__dot--ok' : '' %>" title="<%= shopify_configured ? 'Configurado' : 'Pendente' %>"></span>
        </button>
        <button type="button" class="cform-tab" role="tab" data-tab="whatsapp" aria-selected="false">
          <span class="cform-logo cform-logo--whatsapp"><i class="fa-brands fa-whatsapp"></i></span>
          <span>WhatsApp</span>
          <span class="cform-tab__dot <%= whatsapp_configured ? 'cform-tab__dot--ok' : '' %>" title="<%= whatsapp_configured ? 'Configurado' : 'Pendente' %>"></span>
        </button>
        <button type="button" class="cform-tab" role="tab" data-tab="meta" aria-selected="false">
          <span class="cform-logo cform-logo--meta"><i class="fa-brands fa-meta"></i></span>
          <span>Meta Ads</span>
          <span class="cform-tab__dot <%= meta_configured ? 'cform-tab__dot--ok' : '' %>" title="<%= meta_configured ? 'Configurado' : 'Pendente' %>"></span>
        </button>
        <button type="button" class="cform-tab" role="tab" data-tab="google" aria-selected="false">
          <span class="cform-logo cform-logo--google"><i class="fa-brands fa-google"></i></span>
          <span>Google Ads</span>
          <span class="cform-tab__dot <%= google_configured ? 'cform-tab__dot--ok' : '' %>" title="<%= google_configured ? 'Configurado' : 'Pendente' %>"></span>
        </button>
        <% if show_users_tab %>
          <button type="button" class="cform-tab" role="tab" data-tab="usuarios" aria-selected="false">
            <span class="cform-logo cform-logo--geral"><i class="fa-solid fa-users"></i></span>
            <span>Usuários (<%= client.users.count %>)</span>
          </button>
        <% end %>
      </div>

      <div class="cform-card__body">

      <div class="cform-panel" role="tabpanel" data-panel="geral" hidden>
        <div class="cform-section">
          <div class="cform-section__header">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
            Informações Básicas
          </div>

          <div class="cform-row">
            <div class="cform-field">
              <%= form.label :name, 'Nome do Cliente', class: 'crm-label' %>
              <%= form.text_field :name, class: 'crm-input', required: true, placeholder: 'Nome da empresa ou cliente', disabled: read_only %>
            </div>
            <div class="cform-field">
              <%= form.label :email, 'E-mail', class: 'crm-label' %>
              <%= form.email_field :email, class: 'crm-input', required: true, placeholder: 'email@exemplo.com', disabled: read_only %>
            </div>
          </div>

          <% if current_user.admin? && client.persisted? %>
            <div class="cform-field">
              <%= form.label :slug, 'Slug', class: 'crm-label' %>
              <%= form.text_field :slug, class: 'crm-input', placeholder: 'nome-da-loja', disabled: read_only %>
              <span class="cform-field__hint">Prefixo padrão dos links das landing pages deste cliente (cada página pode usar outro).</span>
            </div>
          <% end %>

          <% if current_user.admin? %>
            <div class="cform-field">
              <%= form.label :active, 'Status', class: 'crm-label' %>
              <div class="cform-toggle">
                <%= form.check_box :active, class: 'cform-toggle__input', disabled: read_only %>
                <span class="cform-toggle__label">Cliente ativo</span>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="cform-panel" role="tabpanel" data-panel="shopify" hidden>
        <div class="cform-section">
          <div class="cform-field">
            <%= form.label :shopify_shop_url, 'URL da Loja Shopify', class: 'crm-label' %>
            <%= form.text_field :shopify_shop_url, class: 'crm-input', placeholder: 'sua-loja.myshopify.com', disabled: read_only %>
            <span class="cform-field__hint">Domínio da loja, sem "https://" (ex.: dunas-beachwear.myshopify.com)</span>
          </div>

          <div class="cform-field">
            <%= form.label :shopify_access_token, 'Token de Acesso', class: 'crm-label' %>
            <div class="cform-field__input-wrapper">
              <%= form.password_field :shopify_access_token, class: 'crm-input cform-field__input--password', placeholder: client.shopify_access_token.present? ? '••••••••••••••••' : 'shpat_xxxxxxxxxxxxxxxx', disabled: read_only, value: '' %>
              <% if client.shopify_access_token.present? %>
                <span class="crm-tag crm-tag--success">Configurado</span>
              <% end %>
            </div>
            <span class="cform-field__hint">Preenchido automaticamente ao conectar via OAuth, ou cole manualmente um token de app customizado. Deixe em branco para manter o token atual.</span>
          </div>

          <div class="cform-field">
            <%= form.label :shopify_storefront_token, 'Token da Storefront API', class: 'crm-label' %>
            <div class="cform-field__input-wrapper">
              <%= form.password_field :shopify_storefront_token, class: 'crm-input cform-field__input--password', placeholder: client.shopify_storefront_token.present? ? '••••••••••••••••' : 'Token público de acesso à Storefront API', disabled: read_only, value: '' %>
              <% if client.shopify_storefront_token.present? %>
                <span class="crm-tag crm-tag--success">Configurado</span>
              <% end %>
            </div>
            <span class="cform-field__hint">Usado pelas landing pages para mostrar produtos e abrir o checkout. Na Shopify: app Headless (ou app customizado com acesso à Storefront API) → token público. Deixe em branco para manter o valor atual.</span>
          </div>

          <% if current_user.admin? %>
            <div class="cform-field">
              <%= form.label :shopify_api_key, 'Client ID do App Shopify', class: 'crm-label' %>
              <%= form.text_field :shopify_api_key, class: 'crm-input', placeholder: 'Client ID do app criado no Partner Dashboard', disabled: read_only %>
            </div>

            <div class="cform-field">
              <%= form.label :shopify_api_secret, 'Client Secret do App Shopify', class: 'crm-label' %>
              <div class="cform-field__input-wrapper">
                <%= form.password_field :shopify_api_secret, class: 'crm-input cform-field__input--password', placeholder: client.shopify_api_secret.present? ? '••••••••••••••••' : 'Client Secret do app', disabled: read_only, value: '' %>
                <% if client.shopify_api_secret.present? %>
                  <span class="crm-tag crm-tag--success">Configurado</span>
                <% end %>
              </div>
              <span class="cform-field__hint">Deixe em branco para manter o valor atual. Cada cliente deve ter seu próprio app Shopify no Partner Dashboard.</span>
            </div>

            <% if client.persisted? && client.shopify_app_configured? %>
              <div class="cform-field">
                <span class="cform-field__hint">
                  App URL a cadastrar no Partner Dashboard deste app: <code><%= client_shopify_auth_url(client) %></code>
                </span>
                <% if client.shopify_shop_url.present? %>
                  <%= link_to 'Conectar via OAuth', client_shopify_auth_path(client, shop: client.shopify_shop_url), class: 'crm-btn crm-btn--primary', style: 'margin-top: 8px;' %>
                <% end %>
              </div>
            <% end %>
          <% end %>

          <% if client.persisted? %>
            <% if shopify_configured %>
              <div class="cform-alert cform-alert--success">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Integração Shopify configurada e pronta para uso.</span>
              </div>
            <% else %>
              <div class="cform-alert cform-alert--warning">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                <span>Configure a URL e o Token para ativar a integração Shopify.</span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="cform-panel" role="tabpanel" data-panel="whatsapp" hidden>
        <div class="cform-provider">
          <div class="cform-provider__header">
            <span class="cform-logo cform-logo--zapi">Z</span>
            <span class="cform-provider__title">Z-API</span>
            <span class="cform-accordion__status <%= zapi_configured ? 'cform-accordion__status--ok' : 'cform-accordion__status--pending' %>">
              <%= zapi_configured ? 'Configurado' : 'Pendente' %>
            </span>
          </div>
          <div class="cform-provider__body">
            <div class="cform-field">
              <%= form.label :zapi_instance_id, 'ID da Instância', class: 'crm-label' %>
              <%= form.text_field :zapi_instance_id, class: 'crm-input', placeholder: 'ID da instância Zapi', disabled: read_only %>
              <span class="cform-field__hint">ID único da instância Zapi</span>
            </div>

            <div class="cform-row">
              <div class="cform-field">
                <%= form.label :zapi_instance_token, 'Token da Instância', class: 'crm-label' %>
                <div class="cform-field__input-wrapper">
                  <%= form.password_field :zapi_instance_token, class: 'crm-input cform-field__input--password', placeholder: client.zapi_instance_token.present? ? '••••••••••••••••' : 'Token da instância', disabled: read_only, value: '' %>
                  <% if client.zapi_instance_token.present? %>
                    <span class="crm-tag crm-tag--success">Configurado</span>
                  <% end %>
                </div>
                <span class="cform-field__hint">Deixe em branco para manter o token atual.</span>
              </div>
              <div class="cform-field">
                <%= form.label :zapi_client_token, 'Token do Cliente', class: 'crm-label' %>
                <div class="cform-field__input-wrapper">
                  <%= form.password_field :zapi_client_token, class: 'crm-input cform-field__input--password', placeholder: client.zapi_client_token.present? ? '••••••••••••••••' : 'Token do cliente', disabled: read_only, value: '' %>
                  <% if client.zapi_client_token.present? %>
                    <span class="crm-tag crm-tag--success">Configurado</span>
                  <% end %>
                </div>
                <span class="cform-field__hint">Deixe em branco para manter o token atual.</span>
              </div>
            </div>

            <% if client.persisted? %>
              <% if zapi_configured %>
                <div class="cform-alert cform-alert--success">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  <span>Integração Zapi configurada e pronta para uso.</span>
                </div>
              <% else %>
                <div class="cform-alert cform-alert--warning">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                  </svg>
                  <span>Configure os campos para ativar a integração Zapi.</span>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>

        <div class="cform-provider">
          <div class="cform-provider__header">
            <span class="cform-logo cform-logo--whatsapp"><i class="fa-brands fa-whatsapp"></i></span>
            <span class="cform-provider__title">API Oficial do WhatsApp (Cloud API)</span>
            <span class="cform-accordion__status <%= whatsapp_cloud_configured ? 'cform-accordion__status--ok' : 'cform-accordion__status--pending' %>">
              <%= whatsapp_cloud_configured ? 'Configurado' : 'Pendente' %>
            </span>
          </div>
          <div class="cform-provider__body">
            <div class="cform-field">
              <%= form.label :whatsapp_cloud_phone_number_id, 'Phone Number ID', class: 'crm-label' %>
              <%= form.text_field :whatsapp_cloud_phone_number_id, class: 'crm-input', placeholder: 'Ex.: 106540352242922', disabled: read_only %>
              <span class="cform-field__hint">No Meta for Developers: seu app → WhatsApp → Configuração da API → "Identificação do número de telefone".</span>
            </div>

            <div class="cform-row">
              <div class="cform-field">
                <%= form.label :whatsapp_cloud_business_account_id, 'ID da Conta do WhatsApp Business (WABA)', class: 'crm-label' %>
                <%= form.text_field :whatsapp_cloud_business_account_id, class: 'crm-input', placeholder: 'Ex.: 102290129340398', disabled: read_only %>
              </div>
              <div class="cform-field">
                <%= form.label :whatsapp_cloud_access_token, 'Token de Acesso', class: 'crm-label' %>
                <div class="cform-field__input-wrapper">
                  <%= form.password_field :whatsapp_cloud_access_token, class: 'crm-input cform-field__input--password', placeholder: client.whatsapp_cloud_access_token.present? ? '••••••••••••••••' : 'Token permanente (System User)', disabled: read_only, value: '' %>
                  <% if client.whatsapp_cloud_access_token.present? %>
                    <span class="crm-tag crm-tag--success">Configurado</span>
                  <% end %>
                </div>
                <span class="cform-field__hint">Deixe em branco para manter o token atual.</span>
              </div>
            </div>

            <div class="cform-alert cform-alert--warning">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
              </svg>
              <span>Por enquanto as mensagens automáticas continuam saindo pela Z-API. A API Oficial só permite iniciar conversa com templates aprovados pela Meta.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="cform-panel" role="tabpanel" data-panel="meta" hidden>
        <div class="cform-section">
          <div class="cform-row">
            <div class="cform-field">
              <%= form.label :meta_ad_account_id, 'ID da Conta de Anúncio', class: 'crm-label' %>
              <%= form.text_field :meta_ad_account_id, class: 'crm-input', placeholder: 'act_1234567890', disabled: read_only %>
            </div>
            <div class="cform-field">
              <%= form.label :meta_access_token, 'Token de Acesso', class: 'crm-label' %>
              <div class="cform-field__input-wrapper">
                <%= form.password_field :meta_access_token, class: 'crm-input cform-field__input--password', placeholder: client.meta_access_token.present? ? '••••••••••••••••' : 'Token de longa duração (System User)', disabled: read_only, value: '' %>
                <% if client.meta_access_token.present? %>
                  <span class="crm-tag crm-tag--success">Configurado</span>
                <% end %>
              </div>
              <span class="cform-field__hint">Deixe em branco para manter o token atual.</span>
            </div>
          </div>
        </div>
      </div>

      <div class="cform-panel" role="tabpanel" data-panel="google" hidden>
        <div class="cform-section">
          <div class="cform-field">
            <%= form.label :google_ads_customer_id, 'Customer ID', class: 'crm-label' %>
            <%= form.text_field :google_ads_customer_id, class: 'crm-input', placeholder: '1234567890', disabled: read_only %>
            <span class="cform-field__hint">ID de 10 dígitos da conta Google Ads do cliente, sem hífens.</span>
          </div>

          <% if client.persisted? %>
            <% if google_configured %>
              <div class="cform-alert cform-alert--success">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <span>Conectado em <%= l(client.google_ads_connected_at, format: '%d/%m/%Y %H:%M') %>.</span>
                <button type="submit" form="google-ads-disconnect-form" class="crm-btn crm-btn--secondary" style="margin-left: auto;" onclick="return confirm('Tem certeza que deseja desconectar o Google Ads?');">Desconectar</button>
              </div>
            <% else %>
              <%= link_to 'Conectar Google Ads', client_google_ads_connect_path(client), class: 'crm-btn crm-btn--primary' %>
            <% end %>
          <% end %>
        </div>
      </div>

      <% if show_users_tab %>
      <div class="cform-panel" role="tabpanel" data-panel="usuarios" hidden>
        <div class="cform-section">
          <div class="cform-section__header">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
            </svg>
            Usuários Vinculados (<%= client.users.count %>)
          </div>

          <div class="cform-users-list">
            <% client.users.each do |user| %>
              <% initials = user.name.to_s.split(' ').first(2).map { |w| w[0] }.join.upcase %>
              <div class="cform-user-item">
                <div class="cform-user-item__avatar"><%= initials.presence || '?' %></div>
                <div class="cform-user-item__info">
                  <div class="cform-user-item__name"><%= user.name %></div>
                  <div class="cform-user-item__email"><%= user.email %></div>
                </div>
                <%= link_to edit_user_path(user), class: 'cform-user-item__link' do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <% end %>

      </div>

      <div class="cform-card__footer">
        <%= link_to clients_path, class: 'crm-btn crm-btn--secondary' do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 15L3 9m0 0l6-6M3 9h12a6 6 0 010 12h-3" />
          </svg>
          Voltar
        <% end %>
        <% unless read_only %>
          <%= form.button class: 'crm-btn crm-btn--primary',
              data: { disable_with: client.new_record? ? 'Criando...' : 'Salvando...' } do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <%= client.new_record? ? 'Criar Cliente' : 'Salvar Alterações' %>
          <% end %>
        <% end %>
      </div>

    </div>
  </div>

<% end %>

<% if client.persisted? && client.google_ads_connected_at.present? %>
  <%= form_tag client_google_ads_disconnect_path(client), method: :delete, id: 'google-ads-disconnect-form', style: 'display: none;' do %>
  <% end %>
<% end %>

<script>
  // Abas do cadastro do cliente. Os painéis escondidos continuam dentro do
  // form, então tudo é salvo junto. A aba aberta fica no #hash da URL.
  (function () {
    var tabs = document.querySelectorAll('[data-cform-tabs] [data-tab]');
    var panels = document.querySelectorAll('[data-panel]');
    if (!tabs.length) return;

    function show(key) {
      if (!document.querySelector('[data-panel="' + key + '"]')) key = 'geral';
      tabs.forEach(function (t) { t.setAttribute('aria-selected', t.dataset.tab === key ? 'true' : 'false'); });
      panels.forEach(function (p) { p.hidden = p.dataset.panel !== key; });
    }

    tabs.forEach(function (t) {
      t.addEventListener('click', function () {
        show(t.dataset.tab);
        history.replaceState(null, '', '#' + t.dataset.tab);
      });
    });

    // Campo obrigatório vazio numa aba escondida: abre a aba dele.
    document.addEventListener('invalid', function (e) {
      var panel = e.target.closest && e.target.closest('[data-panel]');
      if (panel && panel.hidden) show(panel.dataset.panel);
    }, true);

    show(location.hash.replace('#', '') || 'geral');
  })();
</script>
