<% title 'Novo e-mail' %>

<div class="email-templates-gallery">
  <p class="email-templates-gallery__label">Comece a partir de um template pronto (você pode editar tudo depois):</p>
  <div class="email-templates-gallery__grid">
    <%= link_to new_email_template_path, class: "email-templates-gallery__card #{'active' unless params[:preset]}" do %>
      <span class="email-templates-gallery__card-icon">＋</span>
      <span class="email-templates-gallery__card-name">Em branco</span>
    <% end %>
    <% EmailTemplate::PRESETS.each do |key, preset| %>
      <%= link_to new_email_template_path(preset: key), class: "email-templates-gallery__card #{'active' if params[:preset] == key.to_s}" do %>
        <span class="email-templates-gallery__card-icon email-templates-gallery__card-icon--<%= preset[:layout] %>"></span>
        <span class="email-templates-gallery__card-name"><%= preset[:name] %></span>
      <% end %>
    <% end %>
  </div>
</div>

<div class="users-form-page email-templates-layout">
  <%= render 'form', email_template: @email_template %>
</div>
