<% title 'E-mail Marketing' %>

<div class="clients-wrapper">
  <%= render 'shared/email_marketing_tabs' %>

  <div class="clients-table-wrap">
    <div class="clients-table-header">
      <span class="clients-table-header__title">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
        </svg>
        E-mail Marketing<%= " — #{current_client.name}" if current_client %>
      </span>
      <%= link_to new_email_template_path, class: 'crm-btn clients-btn--success' do %>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
        </svg>
        Novo e-mail
      <% end %>
    </div>

    <table class="crm-table">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Assunto</th>
          <th>Gatilho</th>
          <th class="text-center">Status</th>
          <th class="text-center">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% @email_templates.each do |email_template| %>
          <tr>
            <td><%= email_template.name %></td>
            <td><%= email_template.subject %></td>
            <td>
              <span class="crm-tag crm-tag--warning"><%= email_template.trigger_kind.humanize %></span>
            </td>
            <td class="text-center">
              <% if email_template.active? %>
                <span class="crm-tag crm-tag--success">Ativo</span>
              <% else %>
                <span class="crm-tag crm-tag--neutral">Rascunho</span>
              <% end %>
            </td>
            <td class="text-center">
              <div class="clients-table__actions">
                <%= link_to edit_email_template_path(email_template), class: 'crm-btn clients-btn--icon' do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125" />
                  </svg>
                <% end %>
                <%= button_to email_template_path(email_template), method: :delete,
                    class: 'crm-btn clients-btn--icon clients-btn--danger',
                    form: { onsubmit: "return confirm('Excluir o e-mail #{j email_template.name}?');" } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                  </svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @email_templates.empty? %>
          <tr>
            <td colspan="5" class="clients-table__empty">
              Nenhum e-mail criado ainda. <%= link_to 'Criar o primeiro', new_email_template_path %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

</div>
