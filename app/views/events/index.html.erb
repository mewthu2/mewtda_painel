<% title 'Eventos Analytics' %>

<div class="ev-page">

<div class="ev-header">
  <div class="ev-header__left">
    <div class="ev-header__breadcrumb">
      <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      <% if @utm_code.present? %>
        <%= link_to affiliates_path, class: "ev-breadcrumb-link" do %>Afiliados<% end %>
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
        <span>Eventos</span>
      <% else %>
        <span>Eventos</span>
      <% end %>
      <% if @client %>
        <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
        <span class="ev-header__client-name"><%= @client.name %></span>
      <% end %>
    </div>
    <h1 class="ev-header__title">
      <% if @utm_code.present? %>
        Analytics do Afiliado
      <% else %>
        Analytics de Eventos
      <% end %>
    </h1>
    <p class="ev-header__subtitle">
      <% if @utm_code.present? && @affiliate %>
        Exibindo eventos com <code class="ev-inline-code">utm_affiliate=<%= @utm_code %></code>
        &mdash; Afiliado: <strong><%= @affiliate.name %></strong>
        <% if @affiliate.discount_code.present? %>
          &mdash; Cupom:
          <span class="ev-badge ev-badge--discount" style="font-size:12px; vertical-align:middle;">
            <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;margin-right:2px"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
            <%= @affiliate.discount_code %>
          </span>
        <% end %>
      <% elsif @utm_code.present? %>
        Exibindo eventos com <code class="ev-inline-code">utm_affiliate=<%= @utm_code %></code>
      <% elsif @client %>
        Funil de conversao e comportamento dos visitantes
      <% else %>
        Selecione um cliente para visualizar os dados
      <% end %>
    </p>
  </div>

  <div class="ev-header__right">
    <% if @utm_code.present? %>
      <%= link_to affiliates_path, class: "crm-btn crm-btn--secondary" do %>
        <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
        Voltar para Afiliados
      <% end %>
    <% end %>
    <div class="ev-filters <%= 'ev-filters--muted' if @using_month_filter %>">
      <%= link_to "Hoje",    events_path(period: "1",  utm_code: @utm_code),  class: "ev-filter-btn #{'ev-filter-btn--active' if @period == '1' && !@using_month_filter}" %>
      <%= link_to "7 dias",  events_path(period: "7",  utm_code: @utm_code),  class: "ev-filter-btn #{'ev-filter-btn--active' if @period == '7' && !@using_month_filter}" %>
      <%= link_to "15 dias", events_path(period: "15", utm_code: @utm_code), class: "ev-filter-btn #{'ev-filter-btn--active' if @period == '15' && !@using_month_filter}" %>
      <%= link_to "30 dias", events_path(period: "30", utm_code: @utm_code), class: "ev-filter-btn #{'ev-filter-btn--active' if @period == '30' && !@using_month_filter}" %>
    </div>

    <div class="ev-month-filter">
      <%= form_with url: events_path, method: :get, local: true, class: "ev-month-filter__form" do |f| %>
        <% if @utm_code.present? %>
          <input type="hidden" name="utm_code" value="<%= @utm_code %>">
        <% end %>
        <select name="year" class="crm-input ev-month-filter__select <%= 'ev-month-filter__select--active' if @using_month_filter %>">
          <option value="">Ano</option>
          <% [2025, 2026].each do |y| %>
            <option value="<%= y %>" <%= 'selected' if @filter_year == y %>><%= y %></option>
          <% end %>
        </select>

        <select name="month" class="crm-input ev-month-filter__select <%= 'ev-month-filter__select--active' if @using_month_filter %>">
          <option value="">Mes</option>
          <% Date::MONTHNAMES.compact.each_with_index do |name, idx| %>
            <option value="<%= idx + 1 %>" <%= 'selected' if @filter_month == idx + 1 %>><%= name %></option>
          <% end %>
        </select>

        <button type="submit" class="crm-btn crm-btn--primary">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
          Filtrar
        </button>

        <% if @using_month_filter %>
          <%= link_to events_path(period: "1", utm_code: @utm_code), class: "ev-month-filter__clear" do %>
            <svg width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>


  <% if @utm_code.present? && @affiliate %>
    <div class="ev-link-generator">
      <div class="ev-link-generator__header">
        <div class="ev-link-generator__icon">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244" />
          </svg>
        </div>
        <div>
          <div class="ev-link-generator__title">Gerador de Link de Afiliado</div>
          <div class="ev-link-generator__subtitle">
            Insira uma URL e gere o link com o rastreamento
            <code class="ev-link-generator__code">utm_affiliate=<%= @utm_code %></code>
            para <strong><%= @affiliate.name %></strong>
          </div>
          <% if @affiliate.discount_code.present? %>
            <div class="ev-link-generator__meta">
              <span style="font-size:11px; color:var(--fg-alt);">Cupom de desconto:</span>
              <span class="ev-link-generator__discount">
                <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                <%= @affiliate.discount_code %>
              </span>
              <button
                type="button"
                onclick="navigator.clipboard.writeText('<%= @affiliate.discount_code %>').then(function(){ var el = document.getElementById('ev-discount-copy-label'); el.textContent = 'Copiado!'; setTimeout(function(){ el.textContent = 'Copiar cupom'; }, 2000); })"
                style="display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border:1px solid #fde68a;border-radius:4px;background:var(--bg);color:#a16207;font-size:11px;cursor:pointer;"
              >
                <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
                <span id="ev-discount-copy-label">Copiar cupom</span>
              </button>
            </div>
          <% end %>
        </div>
      </div>

      <div class="ev-link-generator__body">
        <div class="ev-link-generator__input-row">
          <div class="ev-link-generator__input-wrap">
            <svg class="ev-link-generator__input-icon" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918" />
            </svg>
            <input
              type="url"
              id="ev-link-input"
              class="crm-input ev-link-generator__input"
              placeholder="https://sualojaexemplo.com.br/produtos/camiseta"
              autocomplete="off"
            />
          </div>
          <button type="button" id="ev-link-generate-btn" class="crm-btn crm-btn--primary" onclick="evGenerateLink('<%= generate_link_events_path %>', '<%= @utm_code %>')">
            <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
            </svg>
            Gerar link
          </button>
        </div>

        <div id="ev-link-result" class="ev-link-generator__result" style="display:none;">
          <div class="ev-link-generator__result-label">Link gerado</div>
          <div class="ev-link-generator__result-row">
            <code id="ev-link-output" class="ev-link-generator__output"></code>
            <button type="button" class="crm-btn crm-btn--secondary" id="ev-link-copy-btn" onclick="evCopyLink()">
              <svg id="ev-copy-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.666 3.888A2.25 2.25 0 0013.5 2.25h-3c-1.03 0-1.9.693-2.166 1.638m7.332 0c.055.194.084.4.084.612v0a.75.75 0 01-.75.75H9a.75.75 0 01-.75-.75v0c0-.212.03-.418.084-.612m7.332 0c.646.049 1.288.11 1.927.184 1.1.128 1.907 1.077 1.907 2.185V19.5a2.25 2.25 0 01-2.25 2.25H6.75A2.25 2.25 0 014.5 19.5V6.257c0-1.108.806-2.057 1.907-2.185a48.208 48.208 0 011.927-.184" />
              </svg>
              <svg id="ev-check-icon" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" style="display:none;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span id="ev-copy-label">Copiar</span>
            </button>
          </div>
        </div>

        <div id="ev-link-error" class="ev-link-generator__error" style="display:none;"></div>
      </div>
    </div>

    <script>
      function evGenerateLink(endpoint, utmCode) {
        var url = document.getElementById('ev-link-input').value.trim();
        var btn = document.getElementById('ev-link-generate-btn');
        var resultEl = document.getElementById('ev-link-result');
        var errorEl = document.getElementById('ev-link-error');
        var outputEl = document.getElementById('ev-link-output');

        errorEl.style.display = 'none';
        resultEl.style.display = 'none';

        if (!url) {
          errorEl.textContent = 'Por favor, insira uma URL.';
          errorEl.style.display = 'block';
          return;
        }

        btn.disabled = true;
        btn.style.opacity = '0.6';

        var csrfToken = document.querySelector('meta[name="csrf-token"]');

        fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken ? csrfToken.content : ''
          },
          body: JSON.stringify({ url: url, utm_code: utmCode })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          btn.disabled = false;
          btn.style.opacity = '1';

          if (data.error) {
            errorEl.textContent = data.error;
            errorEl.style.display = 'block';
          } else {
            outputEl.textContent = data.link;
            resultEl.style.display = 'block';

            // Reset botao copiar
            document.getElementById('ev-copy-label').textContent = 'Copiar';
            document.getElementById('ev-copy-icon').style.display = '';
            document.getElementById('ev-check-icon').style.display = 'none';
            document.getElementById('ev-link-copy-btn').style.background = '';
            document.getElementById('ev-link-copy-btn').style.color = '';
          }
        })
        .catch(function() {
          btn.disabled = false;
          btn.style.opacity = '1';
          errorEl.textContent = 'Erro ao gerar link. Tente novamente.';
          errorEl.style.display = 'block';
        });
      }

      function evCopyLink() {
        var text = document.getElementById('ev-link-output').textContent;
        var copyBtn = document.getElementById('ev-link-copy-btn');

        navigator.clipboard.writeText(text).then(function() {
          document.getElementById('ev-copy-label').textContent = 'Copiado!';
          document.getElementById('ev-copy-icon').style.display = 'none';
          document.getElementById('ev-check-icon').style.display = '';
          copyBtn.style.background = '#dcfce7';
          copyBtn.style.color = '#166534';

          setTimeout(function() {
            document.getElementById('ev-copy-label').textContent = 'Copiar';
            document.getElementById('ev-copy-icon').style.display = '';
            document.getElementById('ev-check-icon').style.display = 'none';
            copyBtn.style.background = '';
            copyBtn.style.color = '';
          }, 2000);
        });
      }
    </script>
  <% end %>

  <% if @empty_state %>
    <div class="ev-card">
      <div class="ev-empty">
        <div class="ev-empty__icon">
          <svg width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
            <path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75z"/>
            <path d="M9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625z"/>
            <path d="M16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>
          </svg>
        </div>
        <h2 class="ev-empty__title">Nenhum dado disponivel</h2>
        <p class="ev-empty__text"><%= @empty_message %></p>
      </div>
    </div>

  <% else %>

    <%
      def calc_change(current, previous)
        return { value: 0, direction: 'neutral' } if previous.zero?
        change = ((current - previous).to_f / previous * 100).round(1)
        { value: change.abs, direction: change > 0 ? 'up' : (change < 0 ? 'down' : 'neutral') }
      end

      def tag_variant_for(direction)
        { 'up' => 'success', 'down' => 'danger', 'neutral' => 'neutral' }[direction] || 'neutral'
      end

      sessions_change = calc_change(@unique_sessions, @prev_unique_sessions)
      checkout_change = calc_change(@counts[:checkout_completed], @prev_counts[:checkout_completed])
    %>

    <div class="ev-kpi-grid">
      <div class="ev-kpi ev-kpi--blue">
        <div class="ev-kpi__label">Sessoes Unicas</div>
        <div class="ev-kpi__value"><%= number_with_delimiter(@unique_sessions) %></div>
        <span class="crm-tag crm-tag--<%= tag_variant_for(sessions_change[:direction]) %>">
          <% if sessions_change[:direction] == 'up' %>+<% elsif sessions_change[:direction] == 'down' %>-<% end %><%= sessions_change[:value] %>%
        </span>
      </div>

      <div class="ev-kpi ev-kpi--green">
        <div class="ev-kpi__label">Checkouts</div>
        <div class="ev-kpi__value"><%= number_with_delimiter(@counts[:checkout_completed]) %></div>
        <span class="crm-tag crm-tag--<%= tag_variant_for(checkout_change[:direction]) %>">
          <% if checkout_change[:direction] == 'up' %>+<% elsif checkout_change[:direction] == 'down' %>-<% end %><%= checkout_change[:value] %>%
        </span>
      </div>

      <div class="ev-kpi ev-kpi--amber">
        <div class="ev-kpi__label">Taxa Conversao</div>
        <div class="ev-kpi__value"><%= @conversion[:checkout_completed] %>%</div>
        <span class="crm-tag crm-tag--neutral">do total</span>
      </div>

      <div class="ev-kpi ev-kpi--rose">
        <div class="ev-kpi__label">Nao Convertidos</div>
        <div class="ev-kpi__value"><%= @abandoned_carts %></div>
        <span class="crm-tag crm-tag--danger"><%= @abandoned_rate %>% taxa</span>
      </div>

      <div class="ev-kpi ev-kpi--purple">
        <div class="ev-kpi__label">Total Eventos</div>
        <div class="ev-kpi__value"><%= number_with_delimiter(@counts.values.sum) %></div>
        <span class="crm-tag crm-tag--neutral">no periodo</span>
      </div>
    </div>


    <div class="ev-funnel-section">
      <div class="ev-funnel-section__header">
        <div class="ev-funnel-section__title">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
          Funil de Conversao
        </div>
        <div class="ev-funnel-section__period">
          <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          <% period_label = { "1" => "Hoje", "7" => "Ultimos 7 dias", "15" => "Ultimos 15 dias", "30" => "Ultimos 30 dias" }[@period] || "Hoje" %>
          <%= @using_month_filter ? "#{Date::MONTHNAMES[@filter_month]} #{@filter_year}" : period_label %>
        </div>
      </div>

      <div class="ev-funnel">
        <div class="ev-funnel__step">
          <div class="ev-funnel__icon" style="background:rgba(59,130,246,.15)">
            <svg width="20" height="20" fill="none" stroke="#3b82f6" stroke-width="2" viewBox="0 0 24 24"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0h6"/></svg>
          </div>
          <div class="ev-funnel__count"><%= number_with_delimiter(@counts[:page_viewed]) %></div>
          <div class="ev-funnel__name">Paginas Vistas</div>
          <div class="ev-funnel__bar">
            <div class="ev-funnel__bar-fill" style="width:100%; background:#3b82f6"></div>
          </div>
          <div class="ev-funnel__rate">100%</div>
        </div>

        <div class="ev-funnel__step">
          <div class="ev-funnel__icon" style="background:rgba(34,197,94,.15)">
            <svg width="20" height="20" fill="none" stroke="#22c55e" stroke-width="2" viewBox="0 0 24 24"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          </div>
          <div class="ev-funnel__count"><%= number_with_delimiter(@counts[:product_viewed]) %></div>
          <div class="ev-funnel__name">Produtos Vistos</div>
          <div class="ev-funnel__bar">
            <div class="ev-funnel__bar-fill" style="width:<%= @conversion[:product_viewed] %>%; background:#22c55e"></div>
          </div>
          <div class="ev-funnel__rate"><%= @conversion[:product_viewed] %>%</div>
          <div class="ev-funnel__dropoff"><%= @dropoff[:page_to_product] %>% saiu</div>
          <% if @avg_times[:page_to_product] > 0 %>
            <div class="ev-funnel__time">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <%= @avg_times[:page_to_product] %> min
            </div>
          <% end %>
        </div>

        <div class="ev-funnel__step">
          <div class="ev-funnel__icon" style="background:rgba(245,158,11,.15)">
            <svg width="20" height="20" fill="none" stroke="#f59e0b" stroke-width="2" viewBox="0 0 24 24"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1.35 2.7A1 1 0 007 17h11M7 13l-.4-2M17 17a2 2 0 100 4 2 2 0 000-4zm-8 0a2 2 0 100 4 2 2 0 000-4z"/></svg>
          </div>
          <div class="ev-funnel__count"><%= number_with_delimiter(@counts[:added_to_cart]) %></div>
          <div class="ev-funnel__name">Add ao Carrinho</div>
          <div class="ev-funnel__bar">
            <div class="ev-funnel__bar-fill" style="width:<%= @conversion[:added_to_cart] %>%; background:#f59e0b"></div>
          </div>
          <div class="ev-funnel__rate"><%= @conversion[:added_to_cart] %>%</div>
          <div class="ev-funnel__dropoff"><%= @dropoff[:product_to_cart] %>% saiu</div>
          <% if @avg_times[:product_to_cart] > 0 %>
            <div class="ev-funnel__time">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <%= @avg_times[:product_to_cart] %> min
            </div>
          <% end %>
        </div>

        <div class="ev-funnel__step">
          <div class="ev-funnel__icon" style="background:rgba(236,72,153,.15)">
            <svg width="20" height="20" fill="none" stroke="#ec4899" stroke-width="2" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div class="ev-funnel__count"><%= number_with_delimiter(@counts[:checkout_completed]) %></div>
          <div class="ev-funnel__name">Checkout</div>
          <div class="ev-funnel__bar">
            <div class="ev-funnel__bar-fill" style="width:<%= @conversion[:checkout_completed] %>%; background:#ec4899"></div>
          </div>
          <div class="ev-funnel__rate"><%= @conversion[:checkout_completed] %>%</div>
          <div class="ev-funnel__dropoff"><%= @dropoff[:cart_to_checkout] %>% nao converteu</div>
          <% if @avg_times[:cart_to_checkout] > 0 %>
            <div class="ev-funnel__time">
              <svg width="10" height="10" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <%= @avg_times[:cart_to_checkout] %> min
            </div>
          <% end %>
        </div>
      </div>
    </div>


    <div class="ev-grid-2">
      <div class="ev-card">
        <div class="ev-card__header">
          <span class="ev-card__title">Eventos por Dia</span>
        </div>
        <div class="ev-chart-wrap">
          <div id="events_chart"></div>
        </div>
      </div>

      <div class="ev-card">
        <div class="ev-card__header">
          <span class="ev-card__title">Dispositivos</span>
        </div>
        <div class="ev-chart-wrap">
          <div id="devices_chart"></div>
        </div>
      </div>
    </div>


    <div class="ev-grid-3">
      <div class="ev-card">
        <div class="ev-card__header">
          <span class="ev-card__title">Origem do Trafego</span>
        </div>
        <div class="ev-chart-wrap">
          <div id="referrers_chart"></div>
        </div>
      </div>

      <div class="ev-card">
        <div class="ev-card__header">
          <span class="ev-card__title">Top Produtos Vistos</span>
        </div>
        <% if @top_products_viewed.any? %>
          <ul class="ev-top-list ev-top-list--products">
            <% @top_products_viewed.each_with_index do |p, i| %>
              <li>
                <span class="ev-top-list__rank"><%= i + 1 %></span>
                <% if p[:image].present? %>
                  <img
                    src="<%= p[:image].start_with?('//') ? "https:#{p[:image]}" : p[:image] %>"
                    alt="<%= p[:title] %>"
                    class="ev-top-list__img"
                    loading="lazy"
                  />
                <% else %>
                  <span class="ev-top-list__img-placeholder">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                  </span>
                <% end %>
                <div class="ev-top-list__info">
                  <span class="ev-top-list__title"><%= p[:title] %></span>
                  <% if p[:sku].present? %>
                    <span class="ev-top-list__sku">SKU: <%= p[:sku] %></span>
                  <% elsif p[:price].present? && p[:price].to_f > 0 %>
                    <span class="ev-top-list__price">
                      <%= number_to_currency(p[:price], unit: "R$ ", separator: ",", delimiter: ".") %>
                    </span>
                  <% end %>
                </div>
                <span class="ev-top-list__count"><%= p[:count] %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p style="color:var(--fg-alt); font-size:13px; text-align:center; padding:32px 0">Sem dados</p>
        <% end %>
      </div>

      <div class="ev-card">
        <div class="ev-card__header">
          <span class="ev-card__title">Top Produtos no Carrinho</span>
        </div>
        <% if @top_products_carted.any? %>
          <ul class="ev-top-list ev-top-list--products">
            <% @top_products_carted.each_with_index do |p, i| %>
              <li>
                <span class="ev-top-list__rank"><%= i + 1 %></span>
                <% if p[:image].present? %>
                  <img
                    src="<%= p[:image].start_with?('//') ? "https:#{p[:image]}" : p[:image] %>"
                    alt="<%= p[:title] %>"
                    class="ev-top-list__img"
                    loading="lazy"
                  />
                <% else %>
                  <span class="ev-top-list__img-placeholder">
                    <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13l-1.35 2.7A1 1 0 007 17h11M7 13l-.4-2M17 17a2 2 0 100 4 2 2 0 000-4zm-8 0a2 2 0 100 4 2 2 0 000-4z"/></svg>
                  </span>
                <% end %>
                <div class="ev-top-list__info">
                  <span class="ev-top-list__title"><%= p[:title] %></span>
                  <% if p[:sku].present? %>
                    <span class="ev-top-list__sku">SKU: <%= p[:sku] %></span>
                  <% elsif p[:price].present? && p[:price].to_f > 0 %>
                    <span class="ev-top-list__price">
                      <%= number_to_currency(p[:price], unit: "R$ ", separator: ",", delimiter: ".") %>
                    </span>
                  <% end %>
                </div>
                <span class="ev-top-list__count"><%= p[:count] %></span>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p style="color:var(--fg-alt); font-size:13px; text-align:center; padding:32px 0">Sem dados</p>
        <% end %>
      </div>
    </div>


    <div class="ev-card" style="margin-bottom:24px">
      <div class="ev-card__header">
        <span class="ev-card__title">Atividade por Hora do Dia</span>
      </div>
      <% max_hour = @hourly_events.values.max || 1 %>
      <div class="ev-heatmap">
        <% @hourly_events.each do |hour, count| %>
          <%
            intensity = count.to_f / max_hour
            bg = if intensity == 0
              '#f1f5f9'
            elsif intensity < 0.25
              '#dbeafe'
            elsif intensity < 0.5
              '#93c5fd'
            elsif intensity < 0.75
              '#3b82f6'
            else
              '#1d4ed8'
            end
            text_color = intensity >= 0.5 ? '#fff' : '#64748b'
          %>
          <div
            class="ev-heatmap__cell"
            style="background:<%= bg %>; color:<%= text_color %>"
            data-tooltip="<%= hour %>h: <%= count %> eventos"
          >
            <%= count > 0 ? count : '' %>
          </div>
        <% end %>
      </div>
      <div class="ev-heatmap__labels">
        <% (0..23).each do |h| %>
          <span class="ev-heatmap__label"><%= h.to_s.rjust(2, '0') %></span>
        <% end %>
      </div>
    </div>


    <div class="ev-grid-2">
      <div class="ev-card">
        <div class="ev-card__header">
          <span class="ev-card__title">Atividade por Dia da Semana</span>
        </div>
        <div class="ev-chart-wrap">
          <div id="weekday_chart"></div>
        </div>
      </div>

      <div class="ev-card">
        <div class="ev-card__header">
          <span class="ev-card__title">Funil Comparativo</span>
        </div>
        <div class="ev-chart-wrap">
          <div id="funnel_bar_chart"></div>
        </div>
      </div>
    </div>


    <div class="ev-table-card">
      <div class="ev-table-card__header">
        <span class="ev-table-card__title">Sessoes Recentes</span>
        <span class="ev-table-card__count"><%= @sessions.size %> sessoes | <%= @sessions.count { |s| !s[:abandoned] } %> convertidas</span>
      </div>

      <div class="ev-table-wrap">
        <table class="ev-table">
          <thead>
            <tr>
              <th>Sessao</th>
              <th>Dominio</th>
              <th>Jornada</th>
              <th class="center">Device</th>
              <th class="center">Duracao</th>
              <th class="center">Eventos</th>
              <th class="center">Status</th>
            </tr>
          </thead>

          <tbody>
            <% if @sessions.empty? %>
              <tr>
                <td colspan="7" class="ev-table__empty">
                  Nenhuma sessao encontrada no periodo selecionado.
                </td>
              </tr>
            <% else %>
              <% @sessions.each do |s| %>
                <tr
                  class="ev-session-row <%= 'ev-table__row--abandoned' if s[:abandoned] %>"
                  data-session-id="<%= s[:session_id] %>"
                  data-fetch-url="<%= session_events_path(session_id: s[:session_id]) %>"
                >
                  <td>
                    <span class="ev-badge ev-badge--mono"><%= s[:session_id].truncate(12) %></span>
                  </td>
                  <td style="font-weight:500; color:var(--fg)"><%= s[:shop_domain] %></td>
                  <td>
                    <div style="display:flex; gap:4px; flex-wrap:wrap">
                      <% s[:last_kinds].each do |kind| %>
                        <%
                          badge_class = case kind
                            when 'page_viewed'           then 'ev-badge--page'
                            when 'product_viewed'        then 'ev-badge--product'
                            when 'product_added_to_cart' then 'ev-badge--cart'
                            when 'checkout_started'      then 'ev-badge--cart'
                            when 'checkout_completed'    then 'ev-badge--checkout'
                            else ''
                          end
                        %>
                        <span class="ev-badge <%= badge_class %>"><%= kind.split('_').first(2).join(' ') %></span>
                      <% end %>
                    </div>
                  </td>
                  <td class="center">
                    <span class="crm-tag crm-tag--neutral"><%= s[:device] %></span>
                  </td>
                  <td class="center" style="color:var(--fg-alt); font-size:12px"><%= s[:duration_min] %> min</td>
                  <td class="center">
                    <span class="ev-badge ev-badge--count"><%= s[:event_count] %></span>
                  </td>
                  <td class="center">
                    <% if s[:abandoned] %>
                      <span class="crm-tag crm-tag--danger">nao converteu</span>
                    <% else %>
                      <span class="crm-tag crm-tag--success">converteu</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

  <% end %>

</div>


<div id="ev-modal-overlay" class="ev-modal-overlay" role="dialog" aria-modal="true">
  <div class="ev-modal">
    <div class="ev-modal__head">
      <div>
        <h2 class="ev-modal__head-title">Detalhes da Sessao</h2>
        <p id="ev-modal-sid" class="ev-modal__head-sid"></p>
      </div>
      <button id="ev-modal-close" class="ev-modal__close">&times;</button>
    </div>
    <div id="ev-modal-meta" class="ev-modal__meta"></div>
    <div class="ev-modal__body">
      <div id="ev-modal-loading" class="ev-modal__loading">Carregando...</div>
      <div id="ev-modal-events" style="display:none">
        <p class="ev-modal__section-title">Timeline de Eventos</p>
        <div id="ev-modal-events-list"></div>
      </div>
    </div>
  </div>
</div>


<% unless @empty_state %>
<script>
document.addEventListener("DOMContentLoaded", function () {
  var COLORS = ['#3b82f6', '#22c55e', '#f59e0b', '#ec4899', '#8b5cf6'];

  new ApexCharts(document.querySelector("#events_chart"), {
    chart: { type: 'area', height: 220, toolbar: { show: false }, fontFamily: 'inherit' },
    series: [
      { name: 'Page',     data: <%= raw @daily_events.select{|k,_| k[1]=='page_viewed'}.map{|k,v| [k[0],v]}.to_json %> },
      { name: 'Produto',  data: <%= raw @daily_events.select{|k,_| k[1]=='product_viewed'}.map{|k,v| [k[0],v]}.to_json %> },
      { name: 'Carrinho', data: <%= raw @daily_events.select{|k,_| k[1]=='product_added_to_cart'}.map{|k,v| [k[0],v]}.to_json %> },
      { name: 'Checkout', data: <%= raw @daily_events.select{|k,_| k[1]=='checkout_completed'}.map{|k,v| [k[0],v]}.to_json %> }
    ],
    xaxis: { type: 'datetime', labels: { style: { fontSize: '11px' } } },
    colors: COLORS,
    fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.3, opacityTo: 0.05 } },
    stroke: { width: 2, curve: 'smooth' },
    legend: { fontSize: '11px', position: 'top' },
    grid: { borderColor: '#f1f5f9' },
    tooltip: { theme: 'light', x: { format: 'dd/MM' } }
  }).render();

  new ApexCharts(document.querySelector("#devices_chart"), {
    chart: { type: 'donut', height: 220, fontFamily: 'inherit' },
    series: [<%= @devices[:desktop] %>, <%= @devices[:mobile] %>, <%= @devices[:tablet] %>],
    labels: ['Desktop', 'Mobile', 'Tablet'],
    colors: ['#3b82f6', '#22c55e', '#f59e0b'],
    legend: { position: 'bottom', fontSize: '12px' },
    plotOptions: { pie: { donut: { size: '60%', labels: { show: true, total: { show: true, label: 'Total', fontSize: '14px', fontWeight: 700 } } } } },
    dataLabels: { enabled: false }
  }).render();

  new ApexCharts(document.querySelector("#referrers_chart"), {
    chart: { type: 'bar', height: 220, toolbar: { show: false }, fontFamily: 'inherit' },
    series: [{ name: 'Visitas', data: <%= raw @referrers.values.to_json %> }],
    xaxis: { categories: <%= raw @referrers.keys.to_json %> },
    colors: ['#8b5cf6'],
    plotOptions: { bar: { horizontal: true, borderRadius: 4 } },
    grid: { borderColor: '#f1f5f9' },
    dataLabels: { enabled: true, style: { fontSize: '11px' } }
  }).render();

  new ApexCharts(document.querySelector("#weekday_chart"), {
    chart: { type: 'bar', height: 200, toolbar: { show: false }, fontFamily: 'inherit' },
    series: [{ name: 'Eventos', data: <%= raw @weekday_events.map{|d| d[:count]}.to_json %> }],
    xaxis: { categories: <%= raw @weekday_events.map{|d| d[:day]}.to_json %> },
    colors: ['#3b82f6'],
    plotOptions: { bar: { borderRadius: 4, columnWidth: '55%' } },
    grid: { borderColor: '#f1f5f9' },
    dataLabels: { enabled: false }
  }).render();

  new ApexCharts(document.querySelector("#funnel_bar_chart"), {
    chart: { type: 'bar', height: 200, toolbar: { show: false }, fontFamily: 'inherit' },
    series: [{ name: 'Eventos', data: [<%= @counts[:page_viewed] %>, <%= @counts[:product_viewed] %>, <%= @counts[:added_to_cart] %>, <%= @counts[:checkout_completed] %>] }],
    xaxis: { categories: ['Paginas', 'Produtos', 'Carrinho', 'Checkout'] },
    colors: COLORS,
    plotOptions: { bar: { distributed: true, borderRadius: 6, columnWidth: '50%' } },
    legend: { show: false },
    grid: { borderColor: '#f1f5f9' },
    dataLabels: { enabled: true, style: { fontSize: '12px', fontWeight: 700 } }
  }).render();
});
</script>

<script>
(function () {
  var KIND_BADGE = {
    page_viewed:           'ev-badge--page',
    product_viewed:        'ev-badge--product',
    product_added_to_cart: 'ev-badge--cart',
    checkout_started:      'ev-badge--cart',
    checkout_completed:    'ev-badge--checkout'
  };

  function fmtDate(str) { return new Date(str).toLocaleString('pt-BR'); }

  function chip(label, value) {
    return '<div class="ev-modal__chip"><span style="color:var(--fg-alt)">' + label + '</span> <strong>' + value + '</strong></div>';
  }

  function renderEvent(e) {
    var ctx = e.context || {}, doc = ctx.document || {}, nav = ctx.navigator || {}, win = ctx.window || {}, loc = doc.location || {}, scr = win.screen || {};
    var url = loc.href, title = doc.title, referrer = doc.referrer, ua = nav.userAgent;
    var screen = (scr.width && scr.height) ? scr.width + 'x' + scr.height : null;
    var hasData = e.data && typeof e.data === 'object' && Object.keys(e.data).length > 0;
    var badgeCls = KIND_BADGE[e.kind] || '';

    var html = '<div class="ev-event">';
    html += '<div class="ev-event__head">';
    html += '<span class="ev-badge ' + badgeCls + '">' + (e.kind || '').replace(/_/g,' ') + '</span>';
    html += '<span class="ev-event__time">' + fmtDate(e.created_at) + '</span>';
    html += '</div>';
    if (title) html += '<div class="ev-event__row"><strong>Titulo:</strong> ' + title + '</div>';
    if (url) html += '<div class="ev-event__row" style="word-break:break-all"><strong>URL:</strong> <a href="' + url + '" target="_blank">' + url + '</a></div>';
    if (referrer) html += '<div class="ev-event__row" style="word-break:break-all"><strong>Referrer:</strong> ' + referrer + '</div>';
    if (screen) html += '<div class="ev-event__row"><strong>Tela:</strong> ' + screen + '</div>';
    if (ua) html += '<div class="ev-event__row ev-event__row--muted">' + ua + '</div>';
    if (hasData) {
      html += '<details><summary>Ver dados</summary><pre>' + JSON.stringify(e.data, null, 2) + '</pre></details>';
    }
    html += '</div>';
    return html;
  }

  document.querySelectorAll('.ev-session-row').forEach(function (row) {
    row.addEventListener('click', function () {
      var sid = this.dataset.sessionId, url = this.dataset.fetchUrl;
      document.getElementById('ev-modal-sid').textContent = sid;
      document.getElementById('ev-modal-meta').innerHTML = '';
      document.getElementById('ev-modal-events-list').innerHTML = '';
      document.getElementById('ev-modal-loading').style.display = 'block';
      document.getElementById('ev-modal-loading').textContent = 'Carregando...';
      document.getElementById('ev-modal-events').style.display = 'none';
      document.getElementById('ev-modal-overlay').style.display = 'block';
      document.body.style.overflow = 'hidden';

      fetch(url, { method: 'GET', credentials: 'same-origin', headers: { 'Accept': 'application/json', 'X-CSRF-Token': (document.querySelector('meta[name="csrf-token"]') || {}).content || '' } })
        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
        .then(function (data) {
          var meta = '';
          meta += chip('Dominio', data.shop_domain || '-');
          meta += chip('Inicio', fmtDate(data.started_at));
          meta += chip('Fim', fmtDate(data.last_at));
          meta += chip('Eventos', data.event_count);
          document.getElementById('ev-modal-meta').innerHTML = meta;
          document.getElementById('ev-modal-events-list').innerHTML = (data.events || []).map(renderEvent).join('');
          document.getElementById('ev-modal-loading').style.display = 'none';
          document.getElementById('ev-modal-events').style.display = 'block';
        })
        .catch(function () { document.getElementById('ev-modal-loading').textContent = 'Erro ao carregar. Tente novamente.'; });
    });
  });

  function closeModal() { document.getElementById('ev-modal-overlay').style.display = 'none'; document.body.style.overflow = ''; }
  document.getElementById('ev-modal-close').addEventListener('click', closeModal);
  document.getElementById('ev-modal-overlay').addEventListener('click', function (e) { if (e.target === this) closeModal(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });
}());
</script>
<% end %>
