<%
  format_value = lambda do |v|
    case format
    when :currency then currency(v)
    when :percent then "#{v}%"
    else "#{v}x"
    end
  end
  fill_pct = progress_pct ? [progress_pct.to_f, 100].min : 0
  bar_status = progress_pct.nil? ? 'empty' : (progress_pct >= 100 ? 'done' : 'normal')
%>

<div class="sd-goal-bar-row">
  <div class="sd-goal-bar-row__header">
    <span class="sd-goal-bar-row__label"><%= label %></span>
    <span class="sd-goal-bar-row__value">
      <strong><%= progress_pct ? format_value.call(current.to_f.round(2)) : '—' %></strong> de <%= format_value.call(target.to_f.round(2)) %>
    </span>
  </div>

  <div class="sd-goal-bar">
    <div class="sd-goal-bar__fill sd-goal-bar__fill--<%= bar_status %>" style="width: <%= fill_pct %>%"></div>
  </div>

  <div class="sd-goal-bar-row__footer">
    <% if progress_pct.nil? %>
      <span class="sd-goal-row__pct">Sem dado suficiente ainda</span>
    <% elsif progress_pct >= 100 %>
      <span class="sd-goal-row__remaining sd-goal-row__remaining--done">Meta batida! 🎉</span>
    <% else %>
      <span class="sd-goal-row__remaining">Faltam <%= format_value.call(remaining.to_f.round(2)) %></span>
    <% end %>
  </div>
</div>
