<%
  over = status == :over
  gauge_status = current.blank? ? 'empty' : (over ? 'over' : 'done')
%>

<div class="sd-goal-chart" data-goal-chart data-chart-id="<%= chart_id %>" data-metric="<%= metric %>"
     data-format="currency" data-reference="<%= target %>" data-status="<%= gauge_status %>"
     data-label="<%= label %>">
  <div class="sd-goal-chart__header">
    <span class="sd-goal-chart__label"><%= label %></span>
    <span class="sd-goal-chart__comparison">
      <strong><%= current.present? ? currency(current.to_f.round(2)) : '—' %></strong> de até <%= currency(target.to_f.round(2)) %>
    </span>
  </div>

  <div class="sd-goal-chart__canvas" id="<%= chart_id %>"></div>

  <div class="sd-goal-chart__footer">
    <% if current.blank? %>
      <span class="sd-goal-row__pct">Sem dado suficiente ainda</span>
    <% elsif over %>
      <span class="sd-goal-row__remaining sd-goal-row__remaining--over"><%= currency(diff.to_f.round(2)) %> acima do teto</span>
    <% else %>
      <span class="sd-goal-row__remaining"><%= currency(diff.to_f.round(2)) %> de folga</span>
    <% end %>
  </div>
</div>
