<%
  format_value = lambda do |v|
    case format
    when :currency then currency(v)
    when :percent then "#{v}%"
    else "#{v}x"
    end
  end
  goal_status = progress_pct.nil? ? 'empty' : (progress_pct >= 100 ? 'done' : 'normal')
%>

<div class="sd-goal-chart" data-goal-chart data-chart-id="<%= chart_id %>" data-metric="<%= metric %>"
     data-format="<%= format %>" data-reference="<%= reference %>" data-status="<%= goal_status %>"
     data-label="<%= label %>">
  <div class="sd-goal-chart__header">
    <span class="sd-goal-chart__label"><%= label %></span>
    <span class="sd-goal-chart__comparison">
      <strong><%= progress_pct ? format_value.call(current.to_f.round(2)) : '—' %></strong> de <%= format_value.call(target.to_f.round(2)) %>
    </span>
  </div>

  <div class="sd-goal-chart__canvas" id="<%= chart_id %>"></div>

  <div class="sd-goal-chart__footer">
    <% if progress_pct.nil? %>
      <span class="sd-goal-row__pct">Sem dado suficiente ainda</span>
    <% elsif progress_pct >= 100 %>
      <span class="sd-goal-row__remaining sd-goal-row__remaining--done">Meta batida! 🎉</span>
    <% else %>
      <span class="sd-goal-row__remaining">Faltam <%= format_value.call(remaining.to_f.round(2)) %></span>
    <% end %>
  </div>
</div>
