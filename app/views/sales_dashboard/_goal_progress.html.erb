<%
  format_value = lambda do |v|
    case format
    when :currency then currency(v)
    when :percent then "#{v}%"
    else "#{v}x"
    end
  end
%>

<div class="sd-goal-row">
  <div class="sd-goal-row__header">
    <span class="sd-goal-row__label"><%= label %></span>
    <span class="sd-goal-row__comparison">
      <strong><%= progress_pct ? format_value.call(current.to_f.round(2)) : '—' %></strong> de <%= format_value.call(target.to_f.round(2)) %>
    </span>
  </div>

  <div class="sd-goal-bar">
    <div class="sd-goal-bar__fill <%= 'sd-goal-bar__fill--done' if progress_pct && progress_pct >= 100 %>" style="width: <%= [progress_pct.to_f, 100].min %>%;"></div>
  </div>

  <div class="sd-goal-row__footer">
    <% if progress_pct.nil? %>
      <span class="sd-goal-row__pct">Sem dado suficiente ainda</span>
    <% elsif progress_pct >= 100 %>
      <span class="sd-goal-row__pct"><%= progress_pct %>% da meta</span>
      <span class="sd-goal-row__remaining sd-goal-row__remaining--done">Meta batida! 🎉</span>
    <% else %>
      <span class="sd-goal-row__pct"><%= progress_pct %>% da meta</span>
      <span class="sd-goal-row__remaining">Faltam <%= format_value.call(remaining.to_f.round(2)) %></span>
    <% end %>
  </div>
</div>
