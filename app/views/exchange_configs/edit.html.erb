<% title 'Trocas e Devoluções' %>

<%= render 'shared/exchange_tabs' %>

<div class="users-form-page">
  <div class="crm-card users-form-page__card">
    <div class="users-form-page__header">
      <div class="users-form-page__header-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
        </svg>
      </div>
      <div>
        <h2 class="users-form-page__title">Configuração de Trocas e Devoluções</h2>
        <p class="users-form-page__subtitle"><%= @client.name %></p>
      </div>
    </div>

    <% if @exchange_config.errors.any? %>
      <div class="users-form-page__errors">
        <div class="users-form-page__errors-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" />
          </svg>
        </div>
        <div>
          <strong>Corrija os erros abaixo:</strong>
          <ul>
            <% @exchange_config.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>

    <%= form_for @exchange_config, as: :exchange_config, url: exchange_config_path, method: :patch,
                 html: { autocomplete: 'off', multipart: true } do |form| %>
      <div class="users-form-page__body">

        <div class="users-form-page__field">
          <label class="crm-label">Ativo</label>
          <div class="cform-toggle">
            <%= form.check_box :active, class: 'cform-toggle__input' %>
            <span class="cform-toggle__label">Página de troca/devolução ativa pro cliente final</span>
          </div>
        </div>

        <div class="users-form-page__field">
          <%= form.label :company_name, 'Nome da empresa', class: 'crm-label' %>
          <%= form.text_field :company_name, class: 'crm-input', placeholder: 'Como aparece no topo da página pública' %>
        </div>

        <div class="users-form-page__field">
          <%= form.label :logo, 'Logo', class: 'crm-label' %>
          <% if @exchange_config.logo.attached? %>
            <div class="popups-image-preview">
              <%= image_tag url_for(@exchange_config.logo), class: 'popups-image-preview__img' %>
              <label class="cform-toggle">
                <%= check_box_tag 'exchange_config[remove_logo]', '1', false, class: 'cform-toggle__input' %>
                <span class="cform-toggle__label">Remover logo atual</span>
              </label>
            </div>
          <% end %>
          <%= form.file_field :logo, class: 'crm-input' %>
        </div>

        <div class="users-form-page__row">
          <div class="users-form-page__field">
            <%= form.label :accent_color, 'Cor de destaque', class: 'crm-label' %>
            <%= form.color_field :accent_color, class: 'crm-input popups-color-input' %>
          </div>
          <div class="users-form-page__field">
            <%= form.label :return_window_days, 'Prazo (dias) pra permitir devolução', class: 'crm-label' %>
            <%= form.number_field :return_window_days, class: 'crm-input', min: 1 %>
            <span class="cpform-field__hint">Contado a partir da data de entrega. Depois desse prazo, só troca fica disponível.</span>
          </div>
        </div>

        <div class="users-form-page__field">
          <%= form.label :instructions, 'Instruções exibidas na página pública', class: 'crm-label' %>
          <%= form.text_area :instructions, class: 'crm-input', rows: 3, placeholder: 'Texto de apoio mostrado acima do formulário de busca' %>
        </div>

        <div class="users-form-page__section">
          <div class="users-form-page__section-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v7.142a2.25 2.25 0 01-2.25 2.25H4.5a2.25 2.25 0 01-2.25-2.25v-7.142c0-.97.616-1.813 1.5-2.097M3.75 8.511A2.25 2.25 0 016 6.375h12a2.25 2.25 0 012.25 2.136m-16.5 0v.03A2.25 2.25 0 006 10.61h12a2.25 2.25 0 002.25-2.075v-.03M12 12.75h.008v.008H12v-.008z" />
            </svg>
            Cupom de troca
          </div>
          <div class="users-form-page__field">
            <%= form.label :coupon_validity_days, 'Validade (dias) do cupom gerado na aprovação', class: 'crm-label' %>
            <%= form.number_field :coupon_validity_days, class: 'crm-input', min: 1 %>
            <span class="cpform-field__hint">O cupom vale a partir do momento em que a troca é aprovada até essa quantidade de dias depois. O valor é a soma dos itens de troca aprovados — gerado automaticamente, sem precisar configurar aqui.</span>
          </div>
        </div>

      </div>

      <%= hidden_field_tag :return_to, 'edit' %>
      <div class="users-form-page__footer">
        <%= form.button class: 'crm-btn crm-btn--primary', data: { disable_with: 'Salvando...' } do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          Salvar configuração
        <% end %>
      </div>
    <% end %>

    <% if @exchange_config.persisted? && @exchange_config.slug.present? %>
      <div class="users-form-page__section">
        <div class="users-form-page__section-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5" />
          </svg>
          Link público
        </div>
        <pre class="popups-script-box"><code><%= new_troca_url(@exchange_config.slug) %></code></pre>
      </div>
    <% else %>
      <span class="cpform-field__hint">Salve a configuração pra gerar o link público.</span>
    <% end %>
  </div>
</div>
